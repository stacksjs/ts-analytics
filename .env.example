# Copy to .env and fill in. .env is gitignored.

# ── AWS / DynamoDB ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ANALYTICS_TABLE_NAME=ts-analytics
# Visitor-hash salt seed — set a long random string in production (#165).
# The daily salt is also persisted in DynamoDB so instances converge.
ANALYTICS_SALT_SECRET=

# ── Dev server ports ──────────────────────────────────────────────
# Change these to avoid conflicts with other local apps.
#   DASHBOARD_PORT  the stx dashboard/frontend (bun run dev)
#   PORT            the API/backend server (bun run server)
# The dashboard proxies /api to the backend, so its proxy target follows PORT
# automatically — you normally only set these two.
DASHBOARD_PORT=2026
PORT=2027

# ── Same-origin proxy (dev) ───────────────────────────────────────
# Leave empty in dev: the dashboard proxies /api + auth forms to the API so
# everything is same-origin and session cookies just work.
STX_PUBLIC_API_ENDPOINT=
# Override the dashboard's API proxy target (default http://localhost:$PORT).
# Only needed for split-domain setups where the API lives elsewhere.
# ANALYTICS_API_PROXY=http://localhost:2027
# Base URL used in email links (verify/reset) + OAuth callbacks.
# Defaults to http://localhost:$DASHBOARD_PORT in dev.
# ANALYTICS_APP_URL=https://analytics.example.com

# Split-domain installs (#118): comma-separated dashboard origins allowed to
# make credentialed API calls (e.g. https://analytics.example.com). Leave
# unset for same-origin installs (the default dev proxy). Setting this also
# switches session cookies to SameSite=None; Secure — HTTPS required.
# CORS_ORIGINS=https://analytics.example.com
