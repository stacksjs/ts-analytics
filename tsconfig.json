{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@stacksjs/stx": ["./src/types/stx.d.ts"],
      "@stacksjs/bun-router": ["./src/types/bun-router.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "strict": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedDeclarations": true,
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "preserveSymlinks": true
  },
  "include": ["src/**/*.ts", "bin", "build.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".storybook",
    "**/*.stories.ts",
    "**/demo/**",
    "**/useDashboardData.ts",
    "**/dashboard/**",
    "**/components/dashboard/**",
    "pickier.config.ts"
  ]
}
