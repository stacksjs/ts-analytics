<script client>
/**
 * DevicesPanel Component
 * Displays device breakdown with reactive data fetching
 */

interface Device {
  type: string
  visitors: number
  percentage?: number
}

const devices = state<Device[]>([])
const loading = state<boolean>(true)

const deviceIcons: Record<string, string> = {
  desktop: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  mobile: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  tablet: 'M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z'
}

function getIconPath(type: string): string {
  return deviceIcons[type?.toLowerCase()] || deviceIcons.desktop
}

async function fetchDevices(): Promise<void> {
  const siteId: string | undefined = window.siteId
  if (!siteId) {
    loading.set(false)
    return
  }
  try {
    const res: Response = await fetch(window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/devices${window.getDateRangeParams()}`))
    const data: { devices?: Device[] } = await res.json()
    devices.set(data.devices || [])
  } catch (e: unknown) {
    console.error('Failed to fetch devices:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (window.siteId) fetchDevices()
})

window.refreshDevicesPanel = fetchDevices
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      Devices
    </div>
    <a href="#" @click.prevent="window.navigateTo('devices')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Type</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">%</th>
      </tr>
    </thead>
    <tbody>
      <tr @for="device in devices()" @loading="loading()" @if="!loading()">
        <td class="cell-name flex items-center gap-1.5">
          <svg class="text-muted shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="getIconPath(device.type)"/>
          </svg>
          {{ (device.type ? device.type : 'Unknown') | capitalize }}
        </td>
        <td class="cell-value">{{ device.visitors | fmt }}</td>
        <td class="cell-value">{{ device.percentage ? device.percentage : 0 }}%</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No device data</td>
      </tr>
    </tbody>
  </table>
</div>

