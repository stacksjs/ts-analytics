<script client lang="ts">
/**
 * PagesPanel Component
 * Displays top pages with reactive data fetching
 */

interface Page {
  path: string
  entries?: number
  visitors: number
  views: number
}

const pages = state<Page[]>([])
const loading = state<boolean>(true)

async function fetchPages(): Promise<void> {
  const siteId: string | undefined = window.siteId
  if (!siteId) {
    loading.set(false)
    return
  }
  try {
    const res: Response = await fetch(window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/pages${window.getDateRangeParams()}`))
    const data: { pages?: Page[] } = await res.json()
    pages.set((data.pages || []).slice(0, 10))
  } catch (e: unknown) {
    console.error('Failed to fetch pages:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (window.siteId) fetchPages()
})

// Expose refresh method for dashboard to call on date range change
window.refreshPagesPanel = fetchPages
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      Top Pages
    </div>
    <a href="#" @click.prevent="window.navigateTo('pages')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Path</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Entries</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr @for="page in pages()" @loading="loading()" @if="!loading()">
        <td class="cell-name" :title="page.path">
          <a :href="page.path" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-accent">
            {{ page.path }}
            <svg class="opacity-50" width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </td>
        <td class="cell-value">{{ page.entries | fmt }}</td>
        <td class="cell-value">{{ page.visitors | fmt }}</td>
        <td class="cell-value">{{ page.views | fmt }}</td>
      </tr>
      <tr @for-loading>
        <td colspan="4" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="4" class="text-center text-muted py-4">No page data</td>
      </tr>
    </tbody>
  </table>
</div>

