<script client>
/**
 * EventsPanel Component
 * Displays custom events with bar chart visualization
 */

import type { AnalyticsEvent } from '../../types/analytics'

const events = state<AnalyticsEvent[]>([])
const loading = state<boolean>(true)

// Use derived for computed values
const totalCount = derived(() => events().reduce((sum: number, e: AnalyticsEvent) => sum + (e.count || 0), 0))
const maxCount = derived(() => Math.max(...events().map((e: AnalyticsEvent) => e.count || 0), 1))

function getPercentage(count: number): number {
  const total: number = totalCount()
  return total > 0 ? Math.round((count / total) * 100) : 0
}

function getBarWidth(count: number): number {
  const max: number = maxCount()
  return max > 0 ? Math.round((count / max) * 100) : 0
}

async function fetchEvents(): Promise<void> {
  const siteId: string | undefined = window.siteId
  if (!siteId) {
    loading.set(false)
    return
  }
  try {
    const res: Response = await fetch(window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/events${window.getDateRangeParams()}`))
    const data: { events?: AnalyticsEvent[] } = await res.json()
    events.set((data.events || []).slice(0, 10))
  } catch (e: unknown) {
    console.error('Failed to fetch events:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (window.siteId) fetchEvents()
})

window.refreshEventsPanel = fetchEvents
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
      Custom Events
    </div>
    <a href="#" @click.prevent="window.navigateTo('events')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>

  <div class="flex flex-col gap-3">
    <div @for="event in events()" @loading="loading()" @if="!loading()" class="flex flex-col gap-1">
      <div class="flex justify-between items-center">
        <span class="text-[0.8125rem] text-text font-medium truncate">{{ event.name }}</span>
        <span class="text-xs text-muted shrink-0 ml-2">{{ getPercentage(event.count ? event.count : 0) }}%</span>
      </div>
      <div class="h-1.5 bg-bg-3 rounded-sm overflow-hidden">
        <div class="h-full bg-accent rounded-sm transition-[width] duration-300" :style="'width: ' + getBarWidth(event.count ? event.count : 0) + '%'"></div>
      </div>
      <div class="text-[0.6875rem] text-muted text-right">{{ event.count | fmt }}</div>
    </div>
    <div @for-loading class="text-center text-muted py-4 text-[0.8125rem]">Loading...</div>
    <div @for-empty class="text-center text-muted py-4 text-[0.8125rem]">No custom events tracked</div>
  </div>
</div>

