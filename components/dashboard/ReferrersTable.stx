<script client lang="ts">
/**
 * ReferrersTable Component
 * Displays top referrers with visitors and views
 */

import type { Referrer } from '../../types/analytics'

const referrers = state<Referrer[]>($props.referrers || [])
const loading = state<boolean>($props.loading || false)

effect(() => {
  if ($props.referrers) referrers.set($props.referrers)
  if ($props.loading !== undefined) loading.set($props.loading)
})

function isExternalLink(source: string): boolean {
  const lower: string = source.toLowerCase()
  return lower !== 'direct' && !source.includes('(') && source.includes('.')
}

function getHref(source: string): string {
  return source.startsWith('http') ? source : 'https://' + source
}

function getDomain(source: string): string {
  return source.replace(/^https?:\/\//, '').split('/')[0]
}
</script>

<div class="overflow-x-auto">
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="text-left py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Source</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Visitors</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr @if="loading()">
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @if="!loading() && referrers().length === 0">
        <td colspan="3" class="text-center text-muted py-4">No referrer data</td>
      </tr>
      <tr @for="ref in referrers()" @if="!loading()">
        <td class="py-2 text-text">
          <a @if="isExternalLink(ref.source ? ref.source : 'Direct')"
             :href="getHref(ref.source)"
             target="_blank"
             rel="noopener"
             class="inline-flex items-center gap-1.5 hover:text-accent">
            <img
              :src="'https://www.google.com/s2/favicons?domain=' + getDomain(ref.source) + '&sz=16'"
              width="14"
              height="14"
              class="align-middle rounded-sm"
              @error="e => e.target.style.display = 'none'"
            />
            {{ ref.source ? ref.source : 'Direct' }}
            <svg class="opacity-50" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
          <span @if="!isExternalLink(ref.source ? ref.source : 'Direct')">{{ ref.source ? ref.source : 'Direct' }}</span>
        </td>
        <td class="text-right py-2 tabular-nums">{{ (ref.visitors ? ref.visitors : 0) | fmt }}</td>
        <td class="text-right py-2 tabular-nums">{{ (ref.views ? ref.views : 0) | fmt }}</td>
      </tr>
    </tbody>
  </table>
</div>
