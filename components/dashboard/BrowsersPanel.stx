<script client>
/**
 * BrowsersPanel Component
 * Displays browser breakdown with reactive data fetching
 */

interface Browser {
  name: string
  visitors: number
  percentage?: number
}

const browsers = state<Browser[]>([])
const loading = state<boolean>(true)

async function fetchBrowsers(): Promise<void> {
  const siteId: string | undefined = window.siteId
  if (!siteId) {
    loading.set(false)
    return
  }
  try {
    const res: Response = await fetch(window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/browsers${window.getDateRangeParams()}`))
    const data: { browsers?: Browser[] } = await res.json()
    browsers.set(data.browsers || [])
  } catch (e: unknown) {
    console.error('Failed to fetch browsers:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (window.siteId) fetchBrowsers()
})

window.refreshBrowsersPanel = fetchBrowsers
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
      </svg>
      Browsers
    </div>
    <a href="#" @click.prevent="window.navigateTo('browsers')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Browser</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">%</th>
      </tr>
    </thead>
    <tbody>
      <tr @for="browser in browsers()" @loading="loading()" @if="!loading()">
        <td class="cell-name">{{ browser.name ? browser.name : 'Unknown' }}</td>
        <td class="cell-value">{{ browser.visitors | fmt }}</td>
        <td class="cell-value">{{ browser.percentage ? browser.percentage : 0 }}%</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No browser data</td>
      </tr>
    </tbody>
  </table>
</div>

