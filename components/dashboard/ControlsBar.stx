<script client lang="ts">
/**
 * ControlsBar Component - Date range and controls
 * Uses STX reactive APIs: state, effect, onMount, provide
 */

import type { DateRange } from '../../types/dashboard'

// Reactive state
const activeRange = state<string>('6h')
const showComparison = state<boolean>(false)
const realtimeCount = state<number>(0)
const lastUpdated = state<string>('')
const isRefreshing = state<boolean>(false)

// Date range options
const ranges: DateRange[] = [
  { id: '1h', label: '1h' },
  { id: '6h', label: '6h' },
  { id: '12h', label: '12h' },
  { id: '24h', label: '24h' },
  { id: '7d', label: '7d' },
  { id: '30d', label: '30d' },
  { id: '90d', label: '90d' },
]

// Set date range
function setRange(range: string): void {
  activeRange.set(range)
  // Notify dashboard.ts
  if (window.setDateRange) {
    window.setDateRange(range)
  }
}

// Toggle comparison mode
function toggleComparison(): void {
  showComparison.update((v: boolean) => !v)
  if (window.toggleComparison) {
    window.toggleComparison()
  }
}

// Refresh data
async function refresh(): Promise<void> {
  if (isRefreshing()) return
  isRefreshing.set(true)

  if (window.fetchDashboardData) {
    await window.fetchDashboardData()
  }

  // Ensure spinner completes at least one rotation
  setTimeout(() => {
    isRefreshing.set(false)
  }, 500)
}

// Export data
function exportData(format: string): void {
  if (window.exportData) {
    window.exportData(format)
  } else {
    // Fallback: trigger CSV download
    const siteId: string | undefined = window.siteId
    if (siteId) {
      window.location.href = window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/export?format=${format}`)
    }
  }
}

onMount(() => {
  // Expose state setters for backward compat with dashboard.ts
  window.updateRealtimeCount = (count: number) => realtimeCount.set(count)
  window.updateLastUpdated = (time: string) => lastUpdated.set(time)
  window.controlsSetDateRange = (range: string) => activeRange.set(range)
  window.controlsBar = {
    setRange,
    toggleComparison,
    refresh,
    exportData,
    activeRange: () => activeRange(),
    showComparison: () => showComparison(),
    isRefreshing: () => isRefreshing(),
  }

  // Sync with any existing dashboard state
  if (window.dateRange) {
    activeRange.set(window.dateRange)
  }
})

// Provide cross-component communication
provide('controlsBar', {
  activeRange,
  showComparison,
  realtimeCount,
  lastUpdated,
  isRefreshing,
  setRange,
  toggleComparison,
  refresh,
  exportData,
})
</script>

<div id="controls-bar" class="flex justify-between items-center py-3 px-6 bg-bg border-b border-border gap-4 flex-wrap max-sm:flex-col max-sm:items-stretch">
  <div class="flex items-center gap-1 max-sm:justify-center">
    <button @for="range in ranges" @class="['date-range-btn', activeRange() === range.id ? 'date-range-btn-active' : '']" @click="setRange(range.id)">{{ range.label }}</button>
    <span class="border-l border-border h-6 mx-2"></span>
    <button id="compare-btn" @class="['date-range-btn flex items-center gap-1 text-[0.6875rem] py-1 px-2', showComparison() ? 'date-range-btn-active' : '']" @click="toggleComparison()" title="Compare with previous period">
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
      </svg>
      Compare
    </button>
  </div>
  <div class="flex items-center gap-3 max-sm:justify-between">
    <div class="flex items-center gap-2 py-1.5 px-3 bg-success/10 rounded-full text-xs font-medium text-success">
      <span class="pulse"></span>
      <span id="realtime-count">{{ realtimeCount() }} visitors online</span>
    </div>
    <span id="last-updated" class="text-xs text-muted" @show="lastUpdated()">{{ lastUpdated() }}</span>
    <button id="refresh-btn" @class="['icon-btn', isRefreshing() ? 'spinning' : '']" @click="refresh()" title="Refresh data">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
    </button>
    <button class="icon-btn" @click="exportData('csv')" title="Export CSV">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
    </button>
  </div>
</div>

<style>
/* Animations - cannot be expressed as utilities */
.pulse {
  width: 0.5rem;
  height: 0.5rem;
  background-color: var(--success);
  border-radius: 9999px;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1); }
}
.spinning svg {
  animation: spin 0.5s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
</style>
