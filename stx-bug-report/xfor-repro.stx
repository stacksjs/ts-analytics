@layout('base')

@section('content')
<script client>
// View-level x-for + {{ }} works; the component below (same pattern) does not.
const viewItems = state([])
onMount(() => {
  setTimeout(() => viewItems.set([{ name: 'ViewX' }, { name: 'ViewY' }]), 60)
})
</script>

<div style="padding:2rem;font-family:monospace">
  <p>VIEW-level x-for, {{ }} (works):</p>
  <ul id="view-interp"><li x-for="it in viewItems">{{ it.name || 'none' }}</li></ul>

  <p>COMPONENT (kebab-tag) x-for, {{ }} empty vs x-text works:</p>
  <repro-list />
</div>
@endsection
