<script client>
// Component repro — {{ }} interpolation inside x-for renders empty here,
// while x-text works. Place in your partialsDir and use as <repro-list />.
const items = state([])
onMount(() => {
  setTimeout(() => items.set([{ name: 'CompX' }, { name: 'CompY' }]), 60)
})
</script>

<ul id="repro-list">
  <li x-for="it in items" class="interp">{{ it.name || 'none' }}</li>
  <li x-for="it in items" class="xt" x-text="it.name || 'none'"></li>
</ul>
