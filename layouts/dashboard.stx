{{-- Dashboard Layout - Shared layout for all dashboard pages --}}
@include('dashboard/DashboardStyles')

<stx-loading-indicator color="var(--accent)" height="3px" />
<site-selector />

<script>
  // Show dashboard immediately if siteId is in URL
  (function() {
    var params = new URLSearchParams(window.location.search);
    var siteId = params.get('siteId');
    if (siteId) {
      var d = window['document'];
      d['write']('<style>#dashboard{display:flex!important}#site-selector{display:none!important}</style>');
    }
  })();
</script>

<script>window.ANALYTICS_API_ENDPOINT = '{{ $env.STX_PUBLIC_API_ENDPOINT || "" }}';</script>
<script src="/assets/dashboard/scripts/composables.ts"></script>
<script src="/assets/dashboard/scripts/dashboard.ts"></script>

<div id="dashboard" class="min-h-screen flex flex-col" style="display:none">
  <dashboard-header />

  @yield('controls')

  @include('dashboard/NoDataMessage')

  <main id="main-content" class="flex-1 p-6 max-w-[1400px] mx-auto w-full">
    @yield('content')
  </main>

  <goal-modal />
  @include('Modal')
  @include('SessionModal')
</div>

@include('shared/EmptyStates')
@yield('scripts')
