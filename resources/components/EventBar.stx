<script server>
import { defineProps, withDefaults } from 'stx'

interface EventBarProps {
  name?: string
  count?: number
  percentage?: number
  barWidth?: number
}

const { name, count, percentage, barWidth } = withDefaults(defineProps<EventBarProps>(), {
  name: '',
  count: 0,
  percentage: 0,
  barWidth: 0,
})
</script>

<template>
<div class="mb-3">
  <div class="flex justify-between mb-1">
    <span class="text-[0.8125rem] text-text font-medium">{{ name }}</span>
    <span class="text-xs text-muted">{{ percentage }}%</span>
  </div>
  <div class="h-1.5 bg-bg-3 rounded-sm overflow-hidden mb-1">
    <div class="h-full bg-accent rounded-sm transition-[width] duration-300" style="width: {{ barWidth }}%"></div>
  </div>
  <div class="text-[0.6875rem] text-muted">{{ count | fmt }}</div>
</div>
</template>
