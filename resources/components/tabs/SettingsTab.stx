function gdprExport(): void {
  location.href = apiUrl('/gdpr/export')
}

function gdprDelete(): void {
  Modal.open({
    title: 'Delete visitor data (GDPR)',
    content: `
      <p class="text-xs text-muted mb-4">Permanently erase all stored data for a single visitor (right to erasure). This cannot be undone.</p>
      <div class="mb-2">
        <label class="text-xs font-medium text-muted mb-1 block">Visitor ID</label>
        <input type="text" name="visitorId" class="form-input" placeholder="visitor hash / id" />
      </div>
    `,
    submitText: 'Delete data',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      if (!data.visitorId) return
      const res: Response = await fetch(apiUrl('/gdpr/delete'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitorId: data.visitorId }),
      })
      Modal.close()
      Modal.alert(res.ok ? 'Success' : 'Error', res.ok ? 'Visitor data deleted.' : 'Failed to delete visitor data.')
    },
  })
}

async function saveRetention(value: string): Promise<void> {
  const days: number = parseInt(value, 10) || 365
  await fetch(apiUrl('/retention'), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ retentionDays: days }),
  })
  settings.set({ ...settings(), retentionDays: days })
}

// Delete site (owner-only). The button opens a modal that asks the user to
// re-type the site name (App ID fallback) before the destructive action runs.
const siteName = state<string>('')

async function fetchSiteName(): Promise<void> {
  try {
    const res: Response = await fetch(`${apiBase()}/api/sites`, { credentials: 'include' })
    if (!res.ok) return
    const data: { sites?: { id: string, name?: string }[] } = await res.json()
    const site = (data.sites || []).find(s => s.id === siteId())
    if (site && site.name) siteName.set(site.name)
  }
  catch (_e) {
    // leave empty — the confirm falls back to the App ID
  }
}

// What the user must re-type to confirm — the site name, or the App ID if unnamed.
function deleteChallenge(): string {
  return siteName() || siteId()
}

function escHtml(s: string): string {
  // Build the angle brackets via char codes (60 = less-than, 62 = greater-than)
  // so no lone bracket literal appears in the source: stx's function-scope
  // scanner treats a lone `<` as a tag open and drops every function defined
  // after it — which is what made showDeleteModal "not defined" in its handler.
  const lt: string = String.fromCharCode(60)
  const gt: string = String.fromCharCode(62)
  const map: Record<string, string> = { '&': '&amp;', [lt]: '&lt;', [gt]: '&gt;', '"': '&quot;', '\'': '&#39;' }
  return s.replace(new RegExp('[&' + lt + gt + '"\']', 'g'), c => map[c] || c)
}

function showDeleteModal(): void {
  const challenge: string = deleteChallenge()
  const c: string = escHtml(challenge)
  Modal.open({
    title: 'Delete this site',
    size: 'sm',
    submitText: 'Delete site',
    content: `
      <p class="text-sm text-muted mb-3" style="line-height:1.6">Permanently deletes <code class="text-text">${c}</code> and <strong class="text-text">all</strong> of its data — pageviews, sessions, events, API keys. This can't be undone.</p>
      <label class="text-xs font-medium text-muted mb-1 block">Type <code class="text-text">${c}</code> to confirm</label>
      <input type="text" name="confirm" class="form-input" autocomplete="off" spellcheck="false" placeholder="${c}" />
      <p id="delete-err" class="text-xs text-error mt-2"></p>
    `,
    onSubmit: async () => {
      const typed: string = String(Modal.getFormData().confirm || '').trim()
      const errEl: Element | null = document.querySelector('#delete-err')
      if (typed !== challenge) {
        if (errEl) errEl.textContent = `Type "${challenge}" exactly to confirm.`
        throw new Error('confirmation mismatch') // keeps the modal open
      }
      const res: Response = await fetch(apiUrl(''), { method: 'DELETE', credentials: 'include' })
      if (!res.ok) {
        const data: { error?: string } = await res.json().catch(() => ({}))
        if (errEl) errEl.textContent = data.error || 'Failed to delete site.'
        throw new Error('delete failed')
      }
      Modal.close()
      // Suppress last-site restore and return to the project list.
      try { sessionStorage.setItem('tsa:pickProject', '1') }
      catch (_e) {}
      window.location.href = '/'
    },
  })
}

// Fetch once the site is known. On a clean-URL reload the id arrives
// asynchronously (the selector restores it), so react to it rather than firing
// on mount with an empty id.
effect(() => {
  if (!siteId()) return
  fetchSettings()
  fetchSnippet()
  fetchSiteName()
})
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-6">Settings</h3>

  <!-- Sub-tab navigation -->
  <div class="flex gap-1 border-b border-border mb-6 flex-wrap">
    <button type="button" x-class="settingsTabClass('install')" @click="settingsTab.set('install')">Installation</button>
    <button type="button" x-class="settingsTabClass('access')" @click="settingsTab.set('access')">Access</button>
    <button type="button" x-class="settingsTabClass('alerts')" @click="settingsTab.set('alerts')">Alerts &amp; Monitoring</button>
    <button type="button" x-class="settingsTabClass('data')" @click="settingsTab.set('data')">Manage</button>
  </div>

  <!-- Installation tab -->
  <div x-show="settingsTab() === 'install'">
  <div x-show="!loading() && !error()" class="panel mb-4">
    <div class="panel-header">
      <h4 class="panel-title">Installation</h4>
      <div class="flex items-center gap-2">
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="verifyInstall()" x-class="{ 'opacity-60': verifying() }">
          <span x-show="!verifying()">Verify installation</span>
          <span x-show="verifying()">Verifying…</span>
        </button>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="copySnippet()">
          <span x-show="!snippetCopied()">Copy snippet</span>
          <span x-show="snippetCopied()" class="text-success">Copied!</span>
        </button>
      </div>
    </div>
    <!-- App ID — the one value you paste into any app -->
    <div class="flex items-center gap-2 mb-4 flex-wrap">
      <span class="text-xs font-medium text-muted shrink-0">App ID</span>
      <code class="text-[0.8125rem] font-mono text-text bg-bg border border-border rounded-md px-2 py-1 break-all">{{ siteId() }}</code>
      <button class="btn btn-secondary text-[0.6875rem] py-1 px-2 shrink-0" @click="copyAppId()">
        <span x-show="!copied()">Copy</span>
        <span x-show="copied()" class="text-success">Copied!</span>
      </button>
    </div>

    <!-- Framework picker — one instruction at a time -->
    <div class="flex items-center gap-2 mb-2">
      <label class="text-xs font-medium text-muted">Framework</label>
      <select x-model="framework" class="form-input text-xs py-1 px-2 w-auto">
        <option value="html">HTML</option>
        <option value="nuxt">Nuxt</option>
        <option value="stx">stx / Stacks</option>
      </select>
    </div>

    <p class="text-xs text-muted mb-3">
      <span x-show="framework() === 'html'">Paste this into the <code class="text-text">&lt;head&gt;</code> of every page you want to track. No cookies, no consent banner — visitors are never personally identified.</span>
      <span x-show="framework() === 'nuxt'">Install <code class="text-text">@stacksjs/ts-analytics</code>, then add the module to <code class="text-text">nuxt.config.ts</code> — the tracker loads on every page automatically.</span>
      <span x-show="framework() === 'stx'">Install <code class="text-text">@stacksjs/ts-analytics</code>, then spread it into your stx config's <code class="text-text">app.head.script</code>. The endpoint is baked in.</span>
    </p>

    <div class="flex flex-wrap gap-1.5 mb-3">
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Page views</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">SPA route changes</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Link &amp; outbound clicks</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Engagement time</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Web vitals</span>
    </div>
    <pre class="bg-bg border border-border rounded-md p-3 text-[0.75rem] text-text overflow-x-auto whitespace-pre-wrap break-all font-mono leading-relaxed">{{ currentSnippet() }}</pre>
    <p x-show="!currentSnippet()" class="text-xs text-muted italic mt-2">Loading…</p>
    <p x-show="verifyResult() === 'pass'" class="text-xs text-success mt-2">Test event received — ingestion is working end to end.</p>
    <p x-show="verifyResult() === 'fail'" class="text-xs text-error mt-2">No event received. Check that the API is reachable from your browser, then try again.</p>
    <div x-show="framework() === 'html'" class="mt-4 pt-3 border-t border-border">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-muted">Ad-blocker resilient variant</span>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="copyStealthSnippet()">
          <span x-show="!stealthCopied()">Copy stealth snippet</span>
          <span x-show="stealthCopied()" class="text-success">Copied!</span>
        </button>
      </div>
      <p class="text-xs text-muted mb-2">Sends beacons to a short, unlisted path that generic blocklists miss. For full resilience, serve it from your own domain — see the <a class="text-primary underline" href="https://github.com/stacksjs/ts-analytics/blob/main/docs/guide/tracking-script.md#ad-blocker-resilience-first-party-proxy" target="_blank" rel="noopener">first-party proxy guide</a>.</p>
      <pre class="bg-bg border border-border rounded-md p-3 text-[0.75rem] text-text overflow-x-auto whitespace-pre-wrap break-all font-mono leading-relaxed">{{ stealthSnippet() }}</pre>
    </div>
  </div>

  <div x-show="loading()" class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
    <Spinner size="sm" color="primary" />
    <span>Loading...</span>
  </div>

  <div x-show="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">
    {{ error() }}
  </div>

  <!-- Access tab -->
  <div x-show="!loading() && !error() && settingsTab() === 'access'" class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">API Key</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="regenerateApiKey()">
            <span x-show="settings().apiKey">Regenerate</span>
            <span x-show="!settings().apiKey">Generate</span>
          </button>
        </div>
        <p class="text-xs text-muted mb-3">Use this key for programmatic access to your analytics data.</p>
        <div class="flex flex-col gap-2">
          <div x-show="settings().apiKey" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ settings().apiKey ? settings().apiKey.name : '' }}</div>
              <code class="text-[0.6875rem] text-muted break-all">{{ settings().apiKey ? settings().apiKey.key : '' }}</code>
            </div>
            <div class="flex items-center gap-1">
              <button class="icon-btn" @click="copyApiKey()" title="Copy key">
                <Icon x-show="!copied()" name="copy" size="14" />
                <Icon x-show="copied()" name="check" size="14" class="text-success" />
              </button>
            </div>
          </div>
          <p x-show="!settings().apiKey" class="text-xs text-muted italic">No API key found.</p>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Team Members</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showTeamModal()">+ Invite</button>
        </div>
        <p class="text-xs text-muted mb-3">Manage team access to this site.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().teamMembers.length === 0" class="text-xs text-muted italic">No team members added.</p>
          <div x-for="member in settings.teamMembers" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ member.email }}</div>
              <div class="text-[0.6875rem] text-muted">{{ member.role }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="removeTeamMember(member.id)" title="Remove">×</button>
          </div>
        </div>
      </div>
  </div>

  <!-- Alerts & Monitoring tab -->
  <div x-show="!loading() && !error() && settingsTab() === 'alerts'" class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Alerts</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showAlertModal()">+ New Alert</button>
        </div>
        <p class="text-xs text-muted mb-3">Get notified when metrics exceed thresholds.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().alerts.length === 0" class="text-xs text-muted italic">No alerts configured.</p>
          <div x-for="alert in settings.alerts" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ alert.metric }}</div>
              <div class="text-[0.6875rem] text-muted">{{ 'Threshold: ' + alert.threshold + ' → ' + alert.email }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteAlert(alert.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Webhooks</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showWebhookModal()">+ Add Webhook</button>
        </div>
        <p class="text-xs text-muted mb-3">Send real-time data to external services.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().webhooks.length === 0" class="text-xs text-muted italic">No webhooks configured.</p>
          <div x-for="webhook in settings.webhooks" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <code class="text-[0.6875rem] text-muted break-all">{{ webhook.url }}</code>
              <div class="text-[0.6875rem] text-muted">{{ (webhook.events || []).join(', ') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteWebhook(webhook.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Email Reports</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showEmailReportModal()">+ Add Report</button>
        </div>
        <p class="text-xs text-muted mb-3">Schedule automated email reports.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().emailReports.length === 0" class="text-xs text-muted italic">No email reports scheduled.</p>
          <div x-for="report in settings.emailReports" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ report.email }}</div>
              <div class="text-[0.6875rem] text-muted">{{ report.frequency }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteEmailReport(report.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Performance Budgets</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showPerfBudgetModal()">+ Add Budget</button>
        </div>
        <p class="text-xs text-muted mb-3">Set performance thresholds for alerts.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().perfBudgets.length === 0" class="text-xs text-muted italic">No performance budgets set.</p>
          <div x-for="budget in settings.perfBudgets" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ budget.metric }}</div>
              <div class="text-[0.6875rem] text-muted">{{ 'Threshold: ' + budget.threshold + (budget.metric === 'CLS' ? '' : 'ms') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deletePerfBudget(budget.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Uptime Monitoring</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showUptimeModal()">+ Add Monitor</button>
        </div>
        <p class="text-xs text-muted mb-3">Monitor your site availability.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().uptimeMonitors.length === 0" class="text-xs text-muted italic">No uptime monitors configured.</p>
          <div x-for="monitor in settings.uptimeMonitors" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <code class="text-[0.6875rem] text-muted break-all">{{ monitor.url }}</code>
              <div class="text-[0.6875rem] text-muted">{{ 'Every ' + monitor.interval + 'min • ' + (monitor.status || 'Pending') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteUptimeMonitor(monitor.id)" title="Delete">×</button>
          </div>
        </div>
      </div>
  </div>

  <!-- Data tab -->
  <div x-show="!loading() && !error() && settingsTab() === 'data'" class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Data & Privacy</h4>
        </div>
        <div class="flex flex-col gap-3">
          <div class="flex gap-2 items-center">
            <div class="flex-1">
              <div class="text-xs text-muted mb-1">Data Retention</div>
              <select class="form-input max-w-[12rem]" x-value="String(settings().retentionDays)" @change="saveRetention($event.target.value)">
                <option value="30">30 days</option>
                <option value="90">90 days</option>
                <option value="180">180 days</option>
                <option value="365">365 days</option>
                <option value="730">730 days</option>
              </select>
            </div>
          </div>
          <div class="flex gap-2 items-center">
            <button class="btn btn-secondary" @click="gdprExport()">Export Data (GDPR)</button>
            <button class="btn btn-danger" @click="gdprDelete()">Delete Visitor Data</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Import from Google Analytics</h4>
        </div>
        <p class="text-xs text-muted mb-3">Backfill history from GA4 CSV exports (add a <strong class="text-text">Date</strong> column to each report). Traffic, Pages, Sources, Devices, Browsers, OS and Geo reports are detected automatically. Days already tracked here are never overwritten.</p>
        <div class="flex flex-col gap-2">
          <input id="ga-import-files" type="file" accept=".csv,text/csv" multiple class="form-input text-xs" @change="gaFilesPicked($event)" />
          <div class="flex gap-2 items-center">
            <button class="btn btn-primary" x-disabled="gaImporting() || gaFileCount() === 0" @click="runGaImport()">{{ gaImportLabel() }}</button>
            <span class="text-xs text-muted" x-show="gaImportStatus() !== ''">{{ gaImportStatus() }}</span>
          </div>

          <div class="border-t border-border pt-3 mt-1">
            <div class="text-xs font-medium text-text mb-1">Automatic import (GA4 API)</div>
            <p class="text-xs text-muted mb-2">Pulls full history directly from Google. Create a service account, grant its email <em>Viewer</em> on the GA4 property, and provide the JSON key — it's used once and never stored.</p>
            <div class="flex flex-col gap-2">
              <input type="text" class="form-input max-w-[16rem] text-xs" placeholder="GA4 property ID (e.g. 123456789)" x-value="ga4PropertyId()" @input="ga4PropertyId.set($event.target.value)" />
              <input type="file" accept=".json,application/json" class="form-input text-xs" @change="ga4KeyPicked($event)" />
              <div class="flex gap-2 items-center">
                <button class="btn btn-primary" x-disabled="ga4Importing() || !ga4Ready()" @click="runGa4ApiImport()">{{ ga4Importing() ? 'Importing from GA4…' : 'Import from GA4 API' }}</button>
                <span class="text-xs text-muted" x-show="ga4Status() !== ''">{{ ga4Status() }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel md:col-span-2 border border-error">
        <div class="panel-header">
          <h4 class="panel-title text-error">Delete this site</h4>
        </div>
        <p class="text-xs text-muted mb-3">Permanently deletes <code class="text-text">{{ deleteChallenge() }}</code> and <strong class="text-text">all</strong> of its data — pageviews, sessions, events, errors, API keys. This can't be undone.</p>
        <button class="btn btn-danger" @click="showDeleteModal()">Delete site</button>
      </div>
  </div>
</div>
