<script client>
import type { ApiKey, SiteSettings } from '../../types/analytics'
import { useSiteApi, useModal } from '@composables'

const { siteId, apiUrl } = useSiteApi()
const Modal = useModal()

const settings = state<SiteSettings>({
  apiKey: null,
  alerts: [],
  emailReports: [],
  uptimeMonitors: [],
  teamMembers: [],
  webhooks: [],
  perfBudgets: [],
  retentionDays: 365,
})
const loading = state<boolean>(true)
const error = state<string | null>(null)
const copied = state<boolean>(false)
const snippetCopied = state<boolean>(false)

// Framework picker for the install instructions — show one snippet at a time
// instead of dumping every variant at once. Each renders from the site's App ID.
const framework = state<string>('html')

function apiBase(): string {
  return (window as { API_ENDPOINT?: string }).API_ENDPOINT || window.location.origin
}

// Build the install snippet for a framework from the site's App ID. The literal
// script-tag text is assembled from parts so it never appears verbatim in this
// source (it would corrupt the stx bundle).
function snippetFor(fw: string): string {
  const id: string = siteId()
  if (!id) return ''
  if (fw === 'nuxt') {
    return [
      '// nuxt.config.ts',
      'export default defineNuxtConfig({',
      '  modules: [\'@stacksjs/ts-analytics/nuxt\'],',
      '  tsAnalytics: { appId: \'' + id + '\' },',
      '})',
    ].join('\n')
  }
  if (fw === 'stx') {
    return [
      '// stx.config.ts',
      'import { tsAnalytics } from \'@stacksjs/ts-analytics/stx\'',
      '',
      'export default {',
      '  app: { head: { script: [',
      '    ...tsAnalytics({ appId: \'' + id + '\' }),',
      '  ] } },',
      '}',
    ].join('\n')
  }
  const close: string = ['<', '/script>'].join('')
  const open: string = ['<', 'script defer data-site="', id, '" src="', apiBase(), '/script.js">'].join('')
  return open + close
}

function currentSnippet(): string {
  return snippetFor(framework())
}

function copyAppId(): void {
  if (!siteId()) return
  navigator.clipboard.writeText(siteId())
  copied.set(true)
  setTimeout(() => copied.set(false), 2000)
}

function fetchSnippet(): void {
  // Blocker-resilient variant (#85): beacons go to the short /t path (HTML only).
  const close: string = ['<', '/script>'].join('')
  const stealthOpen: string = ['<', 'script defer data-site="', siteId(), '" src="', apiBase(), '/script.js?stealth=true">'].join('')
  stealthSnippet.set(stealthOpen + close)
}

const stealthSnippet = state<string>('')
const stealthCopied = state<boolean>(false)

function copyStealthSnippet(): void {
  if (!stealthSnippet()) return
  navigator.clipboard.writeText(stealthSnippet())
  stealthCopied.set(true)
  setTimeout(() => stealthCopied.set(false), 2000)
}

function copySnippet(): void {
  const snippet: string = currentSnippet()
  if (!snippet) return
  navigator.clipboard.writeText(snippet)
  snippetCopied.set(true)
  setTimeout(() => snippetCopied.set(false), 2000)
}

const verifying = state<boolean>(false)
const verifyResult = state<string>('') // '' | 'pass' | 'fail'

// Error-tracking DSN (#63): the second Settings essential next to the script
// tag — fetched on its own so a hiccup elsewhere can't blank it.
const dsn = state<string>('')
const dsnCopied = state<boolean>(false)
const sdkSnippet = state<string>('')
const sdkCopied = state<boolean>(false)
const regeneratingDsn = state<boolean>(false)
// Error tracking is already covered by the analytics snippet — keep the
// standalone SDK/DSN collapsed so it doesn't clutter the page.
const errorSdkOpen = state<boolean>(false)

async function fetchDsn(): Promise<void> {
  try {
    const res: Response = await fetch(apiUrl('/dsn'))
    const data: { dsn?: string } = await res.json()
    if (!data.dsn) return
    dsn.set(data.dsn)
    // Build the tags from parts — literal script-tag text in this source would
    // corrupt the stx inlined bundle.
    const base: string = (window as { API_ENDPOINT?: string }).API_ENDPOINT || window.location.origin
    const sdkTag: string = ['<', 'script src="', base, '/sdk.js">', '<', '/script>'].join('')
    const initTag: string = ['<', 'script>', 'TSA.init({ dsn: \'', data.dsn, '\' })', '<', '/script>'].join('')
    sdkSnippet.set(sdkTag + '\n' + initTag)
  } catch (_e: unknown) {
    // panel shows its loading line until a retry succeeds
  }
}

function copyDsn(): void {
  if (!dsn()) return
  navigator.clipboard.writeText(dsn())
  dsnCopied.set(true)
  setTimeout(() => dsnCopied.set(false), 2000)
}

// Rotate the error-tracking ingest key (Sentry-style). Leaves the general read
// key intact; refreshes the DSN + SDK snippet from the freshly-minted key.
function regenerateDsn(): void {
  Modal.confirm('Regenerate the error-tracking key? The current DSN stops accepting errors immediately.', async () => {
    if (regeneratingDsn()) return
    regeneratingDsn.set(true)
    try {
      await fetch(apiUrl('/dsn/regenerate'), { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      await fetchDsn()
    } finally {
      regeneratingDsn.set(false)
    }
  })
}

function copySdkSnippet(): void {
  if (!sdkSnippet()) return
  navigator.clipboard.writeText(sdkSnippet())
  sdkCopied.set(true)
  setTimeout(() => sdkCopied.set(false), 2000)
}

// Verify installation (#84): fire a synthetic pageview through the public
// /collect endpoint (exactly what the tracking script does), then ask the API
// whether it landed — proving the full ingest round-trip pass/fail.
async function verifyInstall(): Promise<void> {
  if (verifying() || !siteId()) return
  verifying.set(true)
  verifyResult.set('')
  try {
    const base: string = (window as { API_ENDPOINT?: string }).API_ENDPOINT || ''
    const post: Response = await fetch(base + '/collect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        s: siteId(),
        e: 'pageview',
        u: 'https://' + siteId() + '/__verify-install',
        t: 'Installation test',
        sid: 'verify-' + Math.random().toString(36).slice(2),
      }),
    })
    if (!post.ok) throw new Error('collect rejected')
    await new Promise((resolve: (v?: unknown) => void) => setTimeout(resolve, 1200))
    const res: Response = await fetch(apiUrl('/verify-install'))
    const data: { verified?: boolean } = await res.json()
    verifyResult.set(data.verified ? 'pass' : 'fail')
  } catch (_e: unknown) {
    verifyResult.set('fail')
  } finally {
    verifying.set(false)
  }
}

async function fetchSettings(): Promise<void> {
  if (!siteId()) { loading.set(false); return }
  loading.set(true)
  error.set(null)

  try {
    const [keysRes, alertsRes, reportsRes, uptimeRes, teamRes, webhooksRes, budgetsRes, retentionRes]: Response[] = await Promise.all([
      fetch(apiUrl('/api-keys')),
      fetch(apiUrl('/alerts')),
      fetch(apiUrl('/email-reports')),
      fetch(apiUrl('/uptime')),
      fetch(apiUrl('/team')),
      fetch(apiUrl('/webhooks')),
      fetch(apiUrl('/performance-budgets')),
      fetch(apiUrl('/retention')),
    ])

    const [keysData, alertsData, reportsData, uptimeData, teamData, webhooksData, budgetsData, retentionData] = await Promise.all([
      keysRes.json(), alertsRes.json(), reportsRes.json(), uptimeRes.json(),
      teamRes.json(), webhooksRes.json(), budgetsRes.json(), retentionRes.json(),
    ])

    settings.set({
      apiKey: keysData.apiKey || null,
      alerts: alertsData.alerts || [],
      emailReports: reportsData.reports || [],
      uptimeMonitors: uptimeData.monitors || [],
      teamMembers: teamData.members || [],
      webhooks: webhooksData.webhooks || [],
      perfBudgets: budgetsData.budgets || [],
      retentionDays: retentionData.days || 365,
    })
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

function copyApiKey(): void {
  const key = settings().apiKey
  if (key && key.key) {
    navigator.clipboard.writeText(key.key)
    copied.set(true)
    setTimeout(() => copied.set(false), 2000)
  }
}

function regenerateApiKey(): void {
  const run = async (): Promise<void> => {
    const res: Response = await fetch(apiUrl('/api-keys/regenerate'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
    })
    const result: { apiKey?: ApiKey } = await res.json()
    const fullKey: string | undefined = result.apiKey && result.apiKey.key

    Modal.open({
      title: 'New API Key',
      content: `
        <p class="text-xs text-muted mb-4">Your new API key is ready. Copy it now.</p>
        <div class="mb-4">
          <label class="text-xs font-medium text-muted mb-1 block">Default</label>
          <div class="flex gap-2 items-center">
            <input type="text" class="form-input font-mono text-[0.8125rem]" value="${fullKey || ''}" readonly />
            <button type="button" class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="navigator.clipboard.writeText('${fullKey || ''}'); this.textContent='Copied!'">Copy</button>
          </div>
        </div>
      `,
      submitText: 'Done',
      onSubmit: () => {
        Modal.close()
        fetchSettings()
      },
    })
  }

  if (settings().apiKey) {
    Modal.confirm('Regenerate API key? The current key will stop working immediately.', run)
  } else {
    run()
  }
}

function showAlertModal(): void {
  Modal.open({
    title: 'Create Alert',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Name</label>
        <input type="text" name="name" class="form-input" placeholder="e.g. Traffic spike" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Metric</label>
        <select name="metric" class="form-input">
          <option value="pageviews">Page Views</option>
          <option value="visitors">Visitors</option>
          <option value="bounce_rate">Bounce Rate</option>
          <option value="error_rate">Error Rate</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Condition</label>
        <select name="condition" class="form-input">
          <option value="above">Above threshold</option>
          <option value="below">Below threshold</option>
          <option value="equals">Equals threshold</option>
          <option value="change_percent">% change</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Threshold</label>
        <input type="number" name="threshold" class="form-input" value="1000" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="alert@example.com" />
      </div>
    `,
    submitText: 'Create Alert',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/alerts'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: data.name, metric: data.metric, condition: data.condition, threshold: parseInt(data.threshold), email: data.email }),
      })
      Modal.close()
      fetchSettings()
    },
  })
}

function showEmailReportModal(): void {
  Modal.open({
    title: 'Add Email Report',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="report@example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Frequency</label>
        <select name="schedule" class="form-input">
          <option value="daily">Daily</option>
          <option value="weekly" selected>Weekly</option>
          <option value="monthly">Monthly</option>
        </select>
      </div>
    `,
    submitText: 'Add Report',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/email-reports'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, schedule: data.schedule }),
      })
      Modal.close()
      fetchSettings()
    },
  })
}

function showUptimeModal(): void {
  Modal.open({
    title: 'Add Uptime Monitor',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">URL</label>
        <input type="url" name="url" class="form-input" placeholder="https://example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Check Interval (minutes)</label>
        <select name="interval" class="form-input">
          <option value="1">1 minute</option>
          <option value="5" selected>5 minutes</option>
          <option value="15">15 minutes</option>
          <option value="30">30 minutes</option>
          <option value="60">60 minutes</option>
        </select>
      </div>
    `,
    submitText: 'Add Monitor',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/uptime'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: data.url, interval: parseInt(data.interval) }),
      })
      Modal.close()
      fetchSettings()
    },
  })
}

function showTeamModal(): void {
  Modal.open({
    title: 'Invite Team Member',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="team@example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Role</label>
        <select name="role" class="form-input">
          <option value="viewer">Viewer</option>
          <option value="editor">Editor</option>
          <option value="admin">Admin</option>
        </select>
      </div>
    `,
    submitText: 'Invite',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/team'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, role: data.role }),
      })
      Modal.close()
      fetchSettings()
    },
  })
}

function showWebhookModal(): void {
  Modal.open({
    title: 'Add Webhook',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Webhook URL</label>
        <input type="url" name="url" class="form-input" placeholder="https://example.com/webhook" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Events</label>
        <div class="flex flex-wrap gap-3 mt-2">
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_error" checked /> Error</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_alert" /> Alert triggered</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-muted cursor-not-allowed"><input type="checkbox" disabled /> Page View (coming soon)</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-muted cursor-not-allowed"><input type="checkbox" disabled /> Goal Conversion (coming soon)</label>
        </div>
      </div>
    `,
    submitText: 'Add Webhook',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      const events: string[] = []
      if (data.event_error) events.push('error')
      if (data.event_alert) events.push('alert.triggered')
      await fetch(apiUrl('/webhooks'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: data.url, events }),
      })
      Modal.close()
      fetchSettings()
    },
  })
}

function showPerfBudgetModal(): void {
  Modal.open({
    title: 'Add Performance Budget',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Metric</label>
        <select name="metric" class="form-input" id="perf-metric-select" onchange="document.getElementById('perf-threshold-label').textContent = this.value === 'CLS' ? 'Threshold (score)' : 'Threshold (ms)'">
          <option value="LCP">LCP (Largest Contentful Paint)</option>
          <option value="FID">FID (First Input Delay)</option>
          <option value="CLS">CLS (Cumulative Layout Shift)</option>
          <option value="TTFB">TTFB (Time to First Byte)</option>
          <option value="FCP">FCP (First Contentful Paint)</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block" id="perf-threshold-label">Threshold (ms)</label>
        <input type="number" name="threshold" class="form-input" value="2500" />
      </div>
    `,
    submitText: 'Add Budget',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/performance-budgets'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ metric: data.metric, threshold: parseFloat(data.threshold) }),
      })
      Modal.close()
      fetchSettings()
    },
  })
}

function deleteAlert(alertId: string): void {
  Modal.confirm('Delete this alert?', async () => {
    await fetch(apiUrl(`/alerts/${alertId}`), { method: 'DELETE' })
    fetchSettings()
  })
}

function deleteEmailReport(reportId: string): void {
  Modal.confirm('Delete this email report?', async () => {
    await fetch(apiUrl(`/email-reports/${reportId}`), { method: 'DELETE' })
    fetchSettings()
  })
}

function deleteUptimeMonitor(monitorId: string): void {
  Modal.confirm('Delete this uptime monitor?', async () => {
    await fetch(apiUrl(`/uptime/${monitorId}`), { method: 'DELETE' })
    fetchSettings()
  })
}

function removeTeamMember(memberId: string): void {
  Modal.confirm('Remove this team member?', async () => {
    await fetch(apiUrl(`/team/${memberId}`), { method: 'DELETE' })
    fetchSettings()
  })
}

function deleteWebhook(webhookId: string): void {
  Modal.confirm('Delete this webhook?', async () => {
    await fetch(apiUrl(`/webhooks/${webhookId}`), { method: 'DELETE' })
    fetchSettings()
  })
}

function deletePerfBudget(budgetId: string): void {
  Modal.confirm('Delete this performance budget?', async () => {
    await fetch(apiUrl(`/performance-budgets/${budgetId}`), { method: 'DELETE' })
    fetchSettings()
  })
}

function gdprExport(): void {
  location.href = apiUrl('/gdpr/export')
}

function gdprDelete(): void {
  Modal.open({
    title: 'Delete visitor data (GDPR)',
    content: `
      <p class="text-xs text-muted mb-4">Permanently erase all stored data for a single visitor (right to erasure). This cannot be undone.</p>
      <div class="mb-2">
        <label class="text-xs font-medium text-muted mb-1 block">Visitor ID</label>
        <input type="text" name="visitorId" class="form-input" placeholder="visitor hash / id" />
      </div>
    `,
    submitText: 'Delete data',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      if (!data.visitorId) return
      const res: Response = await fetch(apiUrl('/gdpr/delete'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitorId: data.visitorId }),
      })
      Modal.close()
      Modal.alert(res.ok ? 'Success' : 'Error', res.ok ? 'Visitor data deleted.' : 'Failed to delete visitor data.')
    },
  })
}

async function saveRetention(value: string): Promise<void> {
  const days: number = parseInt(value, 10) || 365
  await fetch(apiUrl('/retention'), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ retentionDays: days }),
  })
  settings.set({ ...settings(), retentionDays: days })
}

onMount(() => {
  fetchSettings()
  fetchSnippet()
  fetchDsn()
})
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-6">Settings</h3>

  <div x-show="!loading() && !error()" class="panel mb-4">
    <div class="panel-header">
      <h4 class="panel-title">Installation</h4>
      <div class="flex items-center gap-2">
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="verifyInstall()" x-class="{ 'opacity-60': verifying() }">
          <span x-show="!verifying()">Verify installation</span>
          <span x-show="verifying()">Verifying…</span>
        </button>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="copySnippet()">
          <span x-show="!snippetCopied()">Copy snippet</span>
          <span x-show="snippetCopied()" class="text-success">Copied!</span>
        </button>
      </div>
    </div>
    <!-- App ID — the one value you paste into any app -->
    <div class="flex items-center gap-2 mb-4 flex-wrap">
      <span class="text-xs font-medium text-muted shrink-0">App ID</span>
      <code class="text-[0.8125rem] font-mono text-text bg-bg border border-border rounded-md px-2 py-1 break-all">{{ siteId() }}</code>
      <button class="btn btn-secondary text-[0.6875rem] py-1 px-2 shrink-0" @click="copyAppId()">
        <span x-show="!copied()">Copy</span>
        <span x-show="copied()" class="text-success">Copied!</span>
      </button>
    </div>

    <!-- Framework picker — one instruction at a time -->
    <div class="flex items-center gap-2 mb-2">
      <label class="text-xs font-medium text-muted">Framework</label>
      <select x-model="framework" class="form-input text-xs py-1 px-2 w-auto">
        <option value="html">HTML</option>
        <option value="nuxt">Nuxt</option>
        <option value="stx">stx / Stacks</option>
      </select>
    </div>

    <p class="text-xs text-muted mb-3">
      <span x-show="framework() === 'html'">Paste this into the <code class="text-text">&lt;head&gt;</code> of every page you want to track. No cookies, no consent banner — visitors are never personally identified.</span>
      <span x-show="framework() === 'nuxt'">Install <code class="text-text">@stacksjs/ts-analytics</code>, then add the module to <code class="text-text">nuxt.config.ts</code> — the tracker loads on every page automatically.</span>
      <span x-show="framework() === 'stx'">Install <code class="text-text">@stacksjs/ts-analytics</code>, then spread it into your stx config's <code class="text-text">app.head.script</code>. The endpoint is baked in.</span>
    </p>

    <div class="flex flex-wrap gap-1.5 mb-3">
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Page views</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">SPA route changes</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Link &amp; outbound clicks</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Engagement time</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">Web vitals</span>
      <span class="text-[0.6875rem] px-2 py-0.5 rounded-full bg-bg border border-border text-muted">JS errors</span>
    </div>
    <pre class="bg-bg border border-border rounded-md p-3 text-[0.75rem] text-text overflow-x-auto whitespace-pre-wrap break-all font-mono leading-relaxed">{{ currentSnippet() }}</pre>
    <p x-show="!currentSnippet()" class="text-xs text-muted italic mt-2">Loading…</p>
    <p x-show="verifyResult() === 'pass'" class="text-xs text-success mt-2">Test event received — ingestion is working end to end.</p>
    <p x-show="verifyResult() === 'fail'" class="text-xs text-error mt-2">No event received. Check that the API is reachable from your browser, then try again.</p>
    <div x-show="framework() === 'html'" class="mt-4 pt-3 border-t border-border">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-medium text-muted">Ad-blocker resilient variant</span>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="copyStealthSnippet()">
          <span x-show="!stealthCopied()">Copy stealth snippet</span>
          <span x-show="stealthCopied()" class="text-success">Copied!</span>
        </button>
      </div>
      <p class="text-xs text-muted mb-2">Sends beacons to a short, unlisted path that generic blocklists miss. For full resilience, serve it from your own domain — see the <a class="text-primary underline" href="https://github.com/stacksjs/ts-analytics/blob/main/docs/guide/tracking-script.md#ad-blocker-resilience-first-party-proxy" target="_blank" rel="noopener">first-party proxy guide</a>.</p>
      <pre class="bg-bg border border-border rounded-md p-3 text-[0.75rem] text-text overflow-x-auto whitespace-pre-wrap break-all font-mono leading-relaxed">{{ stealthSnippet() }}</pre>
    </div>
  </div>

  <div x-show="!loading() && !error()" class="panel mb-4">
    <button type="button" class="w-full flex items-center justify-between text-left gap-3" @click="errorSdkOpen.update(v => !v)">
      <div>
        <h4 class="panel-title">Error tracking SDK <span class="text-xs font-normal text-muted">· optional</span></h4>
        <p class="text-xs text-muted mt-0.5">Uncaught errors are already captured by the analytics snippet. Expand only for standalone use or richer capture.</p>
      </div>
      <svg class="w-4 h-4 text-muted shrink-0 transition-transform" x-class="errorSdkOpen() ? 'rotate-90' : ''" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <div x-show="errorSdkOpen()" class="mt-4 pt-3 border-t border-border">
      <div class="flex items-center justify-end gap-2 mb-3 flex-wrap">
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="copyDsn()">
          <span x-show="!dsnCopied()">Copy DSN</span>
          <span x-show="dsnCopied()" class="text-success">Copied!</span>
        </button>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="copySdkSnippet()">
          <span x-show="!sdkCopied()">Copy snippet</span>
          <span x-show="sdkCopied()" class="text-success">Copied!</span>
        </button>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2 hover:text-error" @click="regenerateDsn()" x-disabled="regeneratingDsn()">{{ regeneratingDsn() ? 'Regenerating…' : 'Regenerate key' }}</button>
      </div>
      <p class="text-xs text-muted mb-3">Use this DSN with the standalone SDK when you want error tracking without analytics, or richer capture (breadcrumbs, releases, <code class="text-text">captureException</code>) in your app code.</p>
      <div class="mb-3">
        <label class="text-xs font-medium text-muted mb-1 block">DSN</label>
        <code class="block bg-bg border border-border rounded-md p-3 text-[0.75rem] text-text break-all font-mono">{{ dsn() }}</code>
      </div>
      <div>
        <label class="text-xs font-medium text-muted mb-1 block">SDK snippet</label>
        <pre class="bg-bg border border-border rounded-md p-3 text-[0.75rem] text-text overflow-x-auto whitespace-pre-wrap break-all font-mono leading-relaxed">{{ sdkSnippet() }}</pre>
      </div>
      <p x-show="!dsn()" class="text-xs text-muted italic mt-2">Loading DSN…</p>
    </div>
  </div>

  <div x-show="loading()" class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
    <Spinner size="sm" color="primary" />
    <span>Loading...</span>
  </div>

  <div x-show="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">
    {{ error() }}
  </div>

  <div x-show="!loading() && !error()" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="flex flex-col gap-4">

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">API Key</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="regenerateApiKey()">
            <span x-show="settings().apiKey">Regenerate</span>
            <span x-show="!settings().apiKey">Generate</span>
          </button>
        </div>
        <p class="text-xs text-muted mb-3">Use this key for programmatic access to your analytics data.</p>
        <div class="flex flex-col gap-2">
          <div x-show="settings().apiKey" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ settings().apiKey ? settings().apiKey.name : '' }}</div>
              <code class="text-[0.6875rem] text-muted break-all">{{ settings().apiKey ? settings().apiKey.key : '' }}</code>
            </div>
            <div class="flex items-center gap-1">
              <button class="icon-btn" @click="copyApiKey()" title="Copy key">
                <Icon x-show="!copied()" name="copy" size="14" />
                <Icon x-show="copied()" name="check" size="14" class="text-success" />
              </button>
            </div>
          </div>
          <p x-show="!settings().apiKey" class="text-xs text-muted italic">No API key found.</p>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Alerts</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showAlertModal()">+ New Alert</button>
        </div>
        <p class="text-xs text-muted mb-3">Get notified when metrics exceed thresholds.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().alerts.length === 0" class="text-xs text-muted italic">No alerts configured.</p>
          <div x-for="alert in settings.alerts" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ alert.metric }}</div>
              <div class="text-[0.6875rem] text-muted">{{ 'Threshold: ' + alert.threshold + ' → ' + alert.email }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteAlert(alert.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Email Reports</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showEmailReportModal()">+ Add Report</button>
        </div>
        <p class="text-xs text-muted mb-3">Schedule automated email reports.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().emailReports.length === 0" class="text-xs text-muted italic">No email reports scheduled.</p>
          <div x-for="report in settings.emailReports" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ report.email }}</div>
              <div class="text-[0.6875rem] text-muted">{{ report.frequency }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteEmailReport(report.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Uptime Monitoring</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showUptimeModal()">+ Add Monitor</button>
        </div>
        <p class="text-xs text-muted mb-3">Monitor your site availability.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().uptimeMonitors.length === 0" class="text-xs text-muted italic">No uptime monitors configured.</p>
          <div x-for="monitor in settings.uptimeMonitors" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <code class="text-[0.6875rem] text-muted break-all">{{ monitor.url }}</code>
              <div class="text-[0.6875rem] text-muted">{{ 'Every ' + monitor.interval + 'min • ' + (monitor.status || 'Pending') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteUptimeMonitor(monitor.id)" title="Delete">×</button>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4">

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Team Members</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showTeamModal()">+ Invite</button>
        </div>
        <p class="text-xs text-muted mb-3">Manage team access to this site.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().teamMembers.length === 0" class="text-xs text-muted italic">No team members added.</p>
          <div x-for="member in settings.teamMembers" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ member.email }}</div>
              <div class="text-[0.6875rem] text-muted">{{ member.role }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="removeTeamMember(member.id)" title="Remove">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Webhooks</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showWebhookModal()">+ Add Webhook</button>
        </div>
        <p class="text-xs text-muted mb-3">Send real-time data to external services.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().webhooks.length === 0" class="text-xs text-muted italic">No webhooks configured.</p>
          <div x-for="webhook in settings.webhooks" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <code class="text-[0.6875rem] text-muted break-all">{{ webhook.url }}</code>
              <div class="text-[0.6875rem] text-muted">{{ (webhook.events || []).join(', ') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteWebhook(webhook.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Performance Budgets</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showPerfBudgetModal()">+ Add Budget</button>
        </div>
        <p class="text-xs text-muted mb-3">Set performance thresholds for alerts.</p>
        <div class="flex flex-col gap-2">
          <p x-show="settings().perfBudgets.length === 0" class="text-xs text-muted italic">No performance budgets set.</p>
          <div x-for="budget in settings.perfBudgets" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ budget.metric }}</div>
              <div class="text-[0.6875rem] text-muted">{{ 'Threshold: ' + budget.threshold + (budget.metric === 'CLS' ? '' : 'ms') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deletePerfBudget(budget.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Data & Privacy</h4>
        </div>
        <div class="flex flex-col gap-3">
          <div class="flex gap-2 items-center">
            <div class="flex-1">
              <div class="text-xs text-muted mb-1">Data Retention</div>
              <select class="form-input max-w-[12rem]" x-value="String(settings().retentionDays)" @change="saveRetention($event.target.value)">
                <option value="30">30 days</option>
                <option value="90">90 days</option>
                <option value="180">180 days</option>
                <option value="365">365 days</option>
                <option value="730">730 days</option>
              </select>
            </div>
          </div>
          <div class="flex gap-2 items-center">
            <button class="btn btn-secondary" @click="gdprExport()">Export Data (GDPR)</button>
            <button class="btn btn-danger" @click="gdprDelete()">Delete Visitor Data</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
