<script client>
/**
 * ErrorsTab Component - Error tracking display
 * Uses STX signals for reactive state management
 */

import type { ErrorItem, ErrorStatuses, StatusCounts, SeverityCounts } from '../../types/analytics'
import { useSiteApi } from '@composables'
const { siteId: _siteId, apiUrl: _apiUrl, dateParams: _dateParams } = useSiteApi()

const errors = state<ErrorItem[]>([])
const errorStatuses = state<ErrorStatuses>({})
const statusFilter = state<string>('all')
const errorDateRange = state<string>('30d')
const loading = state<boolean>(true)
const error = state<string | null>(null)

const severityLabels: Record<string, string> = { critical: 'Critical', high: 'High', medium: 'Medium', low: 'Low' }
const statusLabels: Record<string, string> = { new: 'New', resolved: 'Resolved', ignored: 'Ignored', regression: 'Regression' }

const filteredErrors = derived(() => {
  const filter = statusFilter()
  const all = errors()
  if (filter === 'all') return all
  return all.filter((e: ErrorItem) => getErrorStatus(e.fingerprint) === filter)
})

const statusCounts = derived(() => {
  const counts: StatusCounts = { new: 0, resolved: 0, ignored: 0 }
  errors().forEach((e: ErrorItem) => {
    const status = getErrorStatus(e.fingerprint)
    if (counts[status] !== undefined) counts[status]++
    else counts.new++
  })
  return counts
})

const severityCounts = derived(() => {
  const counts: SeverityCounts = { critical: 0, high: 0, medium: 0, low: 0 }
  filteredErrors().forEach((e: ErrorItem) => {
    if (counts[e.severity] !== undefined) counts[e.severity]++
  })
  return counts
})

function getErrorStatus(fingerprint: string): string {
  return errorStatuses()[fingerprint]?.status || 'new'
}

function timeAgo(ts: string | null): string {
  if (!ts) return ''
  const diff = Date.now() - new Date(ts).getTime()
  const mins = Math.floor(diff / 60000)
  if (mins < 1) return 'just now'
  if (mins < 60) return mins + 'm ago'
  const hrs = Math.floor(mins / 60)
  if (hrs < 24) return hrs + 'h ago'
  const days = Math.floor(hrs / 24)
  if (days < 30) return days + 'd ago'
  return new Date(ts).toLocaleDateString()
}

async function fetchErrors(): Promise<void> {
  if (!_siteId()) { loading.set(false); return }
  try {
    const [errorsRes, statusesRes]: [Response, Response] = await Promise.all([
      fetch(_apiUrl('/errors' + errorDateParams())),
      fetch(_apiUrl('/errors/statuses'))
    ])
    const errorsData: { errors?: ErrorItem[] } = await errorsRes.json()
    const statusesData: { statuses?: ErrorStatuses } = await statusesRes.json()
    errors.set(errorsData.errors || [])
    errorStatuses.set(statusesData.statuses || {})
    error.set(null)
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

async function updateStatus(fingerprint: string, newStatus: string): Promise<void> {
  try {
    await fetch(_apiUrl('/errors/status'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ errorId: fingerprint, status: newStatus })
    })
    errorStatuses.update((s: ErrorStatuses) => ({ ...s, [fingerprint]: { status: newStatus } }))
  } catch (e: unknown) {
    console.error('Failed to update status:', e)
  }
}

async function bulkResolve(): Promise<void> {
  if (!confirm('Mark all new errors as resolved?')) return
  const newErrors = errors().filter((e: ErrorItem) => getErrorStatus(e.fingerprint) === 'new')
  for (const e of newErrors) {
    await updateStatus(e.fingerprint, 'resolved')
  }
}

async function bulkIgnore(): Promise<void> {
  if (!confirm('Ignore all new errors?')) return
  const newErrors = errors().filter((e: ErrorItem) => getErrorStatus(e.fingerprint) === 'new')
  for (const e of newErrors) {
    await updateStatus(e.fingerprint, 'ignored')
  }
}

function errorDateParams(): string {
  const range = errorDateRange()
  const now = new Date()
  const end = now.toISOString()
  let start: Date
  switch (range) {
    case '24h': start = new Date(now.getTime() - 24*60*60*1000); break
    case '7d': start = new Date(now.getTime() - 7*24*60*60*1000); break
    case '30d': start = new Date(now.getTime() - 30*24*60*60*1000); break
    case '90d': start = new Date(now.getTime() - 90*24*60*60*1000); break
    default: start = new Date(now.getTime() - 30*24*60*60*1000)
  }
  return '?startDate=' + start.toISOString() + '&endDate=' + end
}

function setErrorDateRange(range: string): void {
  errorDateRange.set(range)
  loading.set(true)
  fetchErrors()
}

function setFilter(f: string): void {
  statusFilter.set(f)
}

onMount(() => {
  fetchErrors()
})
</script>

<div class="col-span-full">
  <!-- Header -->
  <div class="flex justify-between items-center mb-4 flex-wrap gap-2">
    <div class="flex items-center gap-2">
      <h3 class="panel-title">
        <Icon name="alert-triangle" size="16" />
        Errors
      </h3>
    </div>
    <div @if="errors().length > 0" class="flex gap-1.5">
      <button @if="statusCounts().new > 0" :click="bulkResolve" class="inline-flex items-center gap-1.5 text-[0.6875rem] font-medium py-1.5 px-2.5 rounded-md border border-border bg-transparent text-text-2 cursor-pointer transition-all duration-150 hover:bg-bg-2 hover:text-text hover:border-muted">
        <Icon name="check" size="12" />
        Resolve All
      </button>
      <button @if="statusCounts().new > 0" :click="bulkIgnore" class="inline-flex items-center gap-1.5 text-[0.6875rem] font-medium py-1.5 px-2.5 rounded-md border border-border bg-transparent text-text-2 cursor-pointer transition-all duration-150 hover:bg-bg-2 hover:text-text hover:border-muted">
        <Icon name="slash" size="12" />
        Ignore All
      </button>
    </div>
  </div>

  <!-- Date range filter -->
  <div class="flex gap-1 mb-4">
    <button @for="r in [{id:'24h',label:'24h'},{id:'7d',label:'7d'},{id:'30d',label:'30d'},{id:'90d',label:'90d'}]"
      @class="['date-range-btn', errorDateRange() === r.id ? 'date-range-btn-active' : '']"
      :click="setErrorDateRange(r.id)">
      {{ r.label }}
    </button>
  </div>

  <!-- Loading -->
  <div @if="loading()" class="text-center text-text-2 py-10 px-8 bg-bg-2 border border-border rounded-lg flex flex-col items-center gap-2">
    <div class="spinner"></div>
    <span>Loading errors...</span>
  </div>

  <!-- Error state -->
  <div @if="error()" class="text-error bg-error/5 border border-error/15 rounded-lg flex flex-row items-center justify-center gap-2 p-4 text-[0.8125rem]">
    <Icon name="alert-circle" size="20" />
    {{ error() }}
  </div>

  <!-- Empty state -->
  <div @if="!loading() && !error() && errors().length === 0" class="text-center text-text-2 py-12 px-8 bg-bg-2 border border-border rounded-lg flex flex-col items-center gap-2">
    <Icon name="check-circle" size="40" style="opacity: 0.4" />
    <p class="font-semibold text-text text-sm">No errors recorded</p>
    <p class="text-xs text-muted">Your application is running smoothly</p>
  </div>

  <!-- Content -->
  <div @if="!loading() && !error() && errors().length > 0">
    <!-- Severity stats -->
    <div class="severity-grid grid grid-cols-4 gap-2 mb-3">
      <div @for="sev in ['critical', 'high', 'medium', 'low']" @class="['sev-stat bg-bg-2 border border-border rounded-lg py-2.5 px-3 flex items-baseline gap-2 border-l-[3px] border-l-transparent', 'sev-' + sev]">
        <span class="text-lg font-bold text-text">{{ severityCounts()[sev] }}</span>
        <span class="text-[0.6875rem] text-muted uppercase tracking-wider">{{ severityLabels[sev] }}</span>
      </div>
    </div>

    <!-- Filter tabs -->
    <div class="flex items-center justify-between mb-2 border-b border-border">
      <div class="flex">
        <button @class="['tab-btn gap-1.5 text-xs', statusFilter() === 'all' ? 'tab-btn-active' : '']" :click="setFilter('all')">
          All <span class="tab-count bg-bg-3 text-muted text-[0.625rem] py-px px-1.5 rounded-full font-semibold">{{ errors().length }}</span>
        </button>
        <button @class="['tab-btn gap-1.5 text-xs', statusFilter() === 'new' ? 'tab-btn-active' : '']" :click="setFilter('new')">
          <span class="status-dot w-1.5 h-1.5 rounded-full inline-block bg-error"></span> New <span class="tab-count bg-bg-3 text-muted text-[0.625rem] py-px px-1.5 rounded-full font-semibold">{{ statusCounts().new }}</span>
        </button>
        <button @class="['tab-btn gap-1.5 text-xs', statusFilter() === 'resolved' ? 'tab-btn-active' : '']" :click="setFilter('resolved')">
          <span class="status-dot w-1.5 h-1.5 rounded-full inline-block bg-success"></span> Resolved <span class="tab-count bg-bg-3 text-muted text-[0.625rem] py-px px-1.5 rounded-full font-semibold">{{ statusCounts().resolved }}</span>
        </button>
        <button @class="['tab-btn gap-1.5 text-xs', statusFilter() === 'ignored' ? 'tab-btn-active' : '']" :click="setFilter('ignored')">
          <span class="status-dot w-1.5 h-1.5 rounded-full inline-block bg-muted"></span> Ignored <span class="tab-count bg-bg-3 text-muted text-[0.625rem] py-px px-1.5 rounded-full font-semibold">{{ statusCounts().ignored }}</span>
        </button>
      </div>
      <span class="text-[0.6875rem] text-muted">{{ filteredErrors().length }} result{{ filteredErrors().length !== 1 ? 's' : '' }}</span>
    </div>

    <!-- Empty filter state -->
    <div @if="filteredErrors().length === 0" class="text-center text-text-2 py-10 px-8 bg-bg-2 border border-border rounded-lg flex flex-col items-center gap-2 mt-2">
      <p class="font-semibold text-text text-sm">No {{ statusFilter() }} errors</p>
      <p class="text-xs text-muted">Try a different filter</p>
    </div>

    <!-- Error list -->
    <div class="flex flex-col gap-px bg-border border border-border rounded-lg overflow-hidden mt-2">
      <div @for="e in filteredErrors()">
        <a x-href="`/errors/${encodeURIComponent(e.errorId)}?siteId=${_siteId()}`"
           @class="['error-row group flex items-stretch bg-bg-2 no-underline transition-colors duration-150 relative hover:bg-bg-3', getErrorStatus(e.fingerprint)]">
          <div @class="['severity-bar w-1 shrink-0', e.severity || 'medium']"></div>
          <div class="flex-1 min-w-0 py-3 px-4 flex flex-col gap-1.5">
            <div class="flex items-center justify-between gap-2">
              <div class="flex gap-1.5 items-center flex-wrap">
                <span @class="['badge-severity text-[0.625rem] font-semibold py-0.5 px-[7px] rounded uppercase tracking-wide whitespace-nowrap', e.severity || 'medium']">{{ severityLabels[e.severity] || 'Unknown' }}</span>
                <span class="text-[0.625rem] font-semibold py-0.5 px-[7px] rounded uppercase tracking-wide whitespace-nowrap bg-bg-3 text-text-2">{{ e.category || 'Error' }}</span>
                <span @class="['badge-status text-[0.625rem] font-semibold py-0.5 px-[7px] rounded uppercase tracking-wide whitespace-nowrap', getErrorStatus(e.fingerprint)]">{{ statusLabels[getErrorStatus(e.fingerprint)] || 'New' }}</span>
              </div>
              <span class="inline-flex items-center gap-1 text-[0.6875rem] font-semibold text-text-2 whitespace-nowrap">
                <Icon name="zap" size="12" class="text-muted" />
                {{ e.count }}
              </span>
            </div>
            <div class="text-[0.8125rem] text-text leading-relaxed overflow-hidden text-ellipsis line-clamp-2 break-words">{{ e.message || 'Unknown error' }}</div>
            <div class="flex gap-3 items-center flex-wrap">
              <span class="inline-flex items-center gap-1 text-[0.6875rem] text-muted">
                <Icon name="clock" size="11" class="opacity-60" />
                {{ timeAgo(e.lastSeen) }}
              </span>
              <span @if="e.source" class="inline-flex items-center gap-1 text-[0.6875rem] text-muted font-mono text-text-2">{{ e.source.split('/').pop() }}{{ e.line ? ':' + e.line : '' }}</span>
              <span class="inline-flex items-center gap-1 text-[0.6875rem] text-muted">{{ (e.browsers || []).join(', ') || 'server' }}</span>
            </div>
          </div>
          <div class="error-actions flex flex-col gap-0.5 py-2 px-2 opacity-0 transition-opacity duration-150 items-center justify-center group-hover:opacity-100" :click.stop>
            <button @if="getErrorStatus(e.fingerprint) !== 'resolved'" :click.stop="updateStatus(e.fingerprint, 'resolved')" class="action-btn resolve w-7 h-7 rounded-md border-none bg-transparent text-muted cursor-pointer flex items-center justify-center transition-all duration-150" title="Resolve">
              <Icon name="check" size="14" />
            </button>
            <button @if="getErrorStatus(e.fingerprint) !== 'ignored'" :click.stop="updateStatus(e.fingerprint, 'ignored')" class="action-btn ignore w-7 h-7 rounded-md border-none bg-transparent text-muted cursor-pointer flex items-center justify-center transition-all duration-150" title="Ignore">
              <Icon name="slash" size="14" />
            </button>
            <button @if="getErrorStatus(e.fingerprint) !== 'new'" :click.stop="updateStatus(e.fingerprint, 'new')" class="action-btn reopen w-7 h-7 rounded-md border-none bg-transparent text-muted cursor-pointer flex items-center justify-center transition-all duration-150" title="Reopen">
              <Icon name="refresh-cw" size="14" />
            </button>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
/* Severity stat border-left colors */
.sev-critical { border-left-color: var(--error); }
.sev-high { border-left-color: #f97316; }
.sev-medium { border-left-color: var(--warning); }
.sev-low { border-left-color: var(--muted); }

/* Severity bar colors */
.severity-bar.critical { background-color: var(--error); }
.severity-bar.high { background: #f97316; }
.severity-bar.medium { background-color: var(--warning); }
.severity-bar.low { background-color: var(--muted); }

/* Severity badge colors (rgba values for transparency) */
.badge-severity.critical { background: rgba(239, 68, 68, 0.12); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.2); }
.badge-severity.high { background: rgba(249, 115, 22, 0.12); color: #fdba74; border: 1px solid rgba(249, 115, 22, 0.2); }
.badge-severity.medium { background: rgba(234, 179, 8, 0.12); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.2); }
.badge-severity.low { background: rgba(107, 114, 128, 0.12); color: #d1d5db; border: 1px solid rgba(107, 114, 128, 0.2); }

/* Status badge colors (rgba values for transparency) */
.badge-status.new { background: rgba(239, 68, 68, 0.12); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.15); }
.badge-status.resolved { background: rgba(34, 197, 94, 0.12); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.15); }
.badge-status.ignored { background: rgba(107, 114, 128, 0.12); color: var(--muted); border: 1px solid rgba(107, 114, 128, 0.15); }

/* Light theme badge adjustments */
[data-theme="light"] .badge-severity.critical { background: rgba(239, 68, 68, 0.08); color: #dc2626; border-color: rgba(239, 68, 68, 0.2); }
[data-theme="light"] .badge-severity.high { background: rgba(249, 115, 22, 0.08); color: #ea580c; border-color: rgba(249, 115, 22, 0.2); }
[data-theme="light"] .badge-severity.medium { background: rgba(234, 179, 8, 0.08); color: #b45309; border-color: rgba(234, 179, 8, 0.2); }
[data-theme="light"] .badge-severity.low { background: rgba(107, 114, 128, 0.08); color: #4b5563; border-color: rgba(107, 114, 128, 0.2); }
[data-theme="light"] .badge-status.new { background: rgba(239, 68, 68, 0.08); color: #dc2626; border-color: rgba(239, 68, 68, 0.15); }
[data-theme="light"] .badge-status.resolved { background: rgba(34, 197, 94, 0.08); color: #059669; border-color: rgba(34, 197, 94, 0.15); }
[data-theme="light"] .badge-status.ignored { background: rgba(107, 114, 128, 0.08); color: #6b7280; border-color: rgba(107, 114, 128, 0.15); }

/* Error row opacity for resolved/ignored */
.error-row.resolved { opacity: 0.55; }
.error-row.ignored { opacity: 0.4; }

/* Action button hover colors (rgba values for transparency) */
.action-btn.resolve:hover { background: rgba(34, 197, 94, 0.15); color: var(--success); }
.action-btn.ignore:hover { background: rgba(107, 114, 128, 0.15); color: var(--muted); }
.action-btn.reopen:hover { background: rgba(99, 102, 241, 0.15); color: var(--accent); }

/* Fallback for group-hover on error-actions */
.error-row:hover .error-actions { opacity: 1; }

/* Responsive */
@media (max-width: 640px) {
  .severity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
</style>
