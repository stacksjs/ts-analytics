<script client>
/**
 * SessionsTab Component - User sessions display
 */

import type { Session, PageView, SessionEvent, SessionDetail } from '../../types/analytics'
import { useSiteApi, useModal } from '@composables'
const { siteId: _siteId, apiUrl: _apiUrl, dateParams: _dateParams } = useSiteApi()
const Modal = useModal()

const sessions = state<Session[]>([])
const loading = state<boolean>(true)
const error = state<string | null>(null)

function formatDuration(ms: number): string {
  if (!ms) return '0s'
  const seconds = Math.floor(ms / 1000)
  if (seconds < 60) return seconds + 's'
  const minutes = Math.floor(seconds / 60)
  if (minutes < 60) return minutes + 'm ' + (seconds % 60) + 's'
  const hours = Math.floor(minutes / 60)
  return hours + 'h ' + (minutes % 60) + 'm'
}

function timeAgo(timestamp: string | null): string {
  if (!timestamp) return 'Just now'
  const seconds = Math.floor((Date.now() - new Date(timestamp).getTime()) / 1000)
  if (seconds < 60) return 'Just now'
  if (seconds < 3600) return Math.floor(seconds / 60) + 'm ago'
  if (seconds < 86400) return Math.floor(seconds / 3600) + 'h ago'
  return Math.floor(seconds / 86400) + 'd ago'
}

async function fetchSessions(): Promise<void> {
  if (!_siteId()) { loading.set(false); return }
  loading.set(true)
  error.set(null)
  try {
    const res: Response = await fetch(_apiUrl('/sessions' + _dateParams()))
    const data: { sessions?: Session[] } = await res.json()
    sessions.set(data.sessions || [])
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

async function viewSession(sessionId: string): Promise<void> {
  // Show loading modal
  Modal.open({
    title: `Session ${sessionId.slice(0, 8)}...`,
    content: '<div class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg"><div class="spinner"></div><span>Loading session...</span></div>',
    showFooter: false,
    size: 'lg'
  })

  try {
    const res: Response = await fetch(_apiUrl('/sessions/' + sessionId))
    const data: SessionDetail = await res.json()

    const stats = `
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="stat-card text-center">
          <div class="text-xl font-bold text-text">${data.pageViewCount || data.pageViews?.length || 0}</div>
          <div class="text-[0.6875rem] text-muted uppercase mt-1">Pages</div>
        </div>
        <div class="stat-card text-center">
          <div class="text-xl font-bold text-text">${formatDuration(data.duration)}</div>
          <div class="text-[0.6875rem] text-muted uppercase mt-1">Duration</div>
        </div>
        <div class="stat-card text-center">
          <div class="text-xl font-bold text-text">${data.browser || 'Unknown'}</div>
          <div class="text-[0.6875rem] text-muted uppercase mt-1">Browser</div>
        </div>
        <div class="stat-card text-center">
          <div class="text-xl font-bold text-text">${data.country || 'Unknown'}</div>
          <div class="text-[0.6875rem] text-muted uppercase mt-1">Country</div>
        </div>
      </div>
    `

    const journey = data.pageViews ? `
      <h4 class="text-sm font-medium text-muted mb-3">Session Journey</h4>
      <div class="flex items-center gap-2 flex-wrap">
        ${data.pageViews.map((pv: PageView, i: number) =>
          `${i > 0 ? '<span class="text-accent font-bold">&rarr;</span>' : ''}<div class="bg-bg-2 border border-border py-2 px-3 rounded-md text-[0.8125rem] text-text">${pv.path || '/'}</div>`
        ).join('')}
      </div>
    ` : ''

    const timeline = data.events ? `
      <h4 class="text-sm font-medium text-muted mt-6 mb-3">Timeline (${data.events.length} events)</h4>
      <div class="max-h-[300px] overflow-y-auto flex flex-col gap-2">
        ${data.events.map((e: SessionEvent) => {
          const type = e.type || 'event'
          return `<div class="flex items-center gap-3 p-2 bg-bg-2 rounded-md">
            <div class="timeline-type ${type}">${type}</div>
            <div class="flex-1 text-[0.8125rem] text-text truncate">${e.name || e.path || e.message || ''}</div>
            <div class="text-[0.6875rem] text-muted">${new Date(e.timestamp).toLocaleTimeString()}</div>
          </div>`
        }).join('')}
      </div>
    ` : ''

    Modal.open({
      title: `Session ${sessionId.slice(0, 8)}...`,
      content: stats + journey + timeline,
      showFooter: false,
      size: 'lg',
      className: 'session-modal'
    })
  } catch (e: unknown) {
    Modal.open({
      title: 'Error',
      content: `<p class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">Failed to load session: ${(e as Error).message}</p>`,
      showFooter: false
    })
  }
}

provide('viewSession', viewSession)

onMount(() => {
  fetchSessions()
})
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-4">Sessions (<span>{{ sessions().length }}</span>)</h3>
  <div class="flex flex-col gap-3">
    <div @if="loading()" class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
      <div class="spinner"></div><span>Loading...</span>
    </div>
    <div @if="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">{{ error() }}</div>
    <div @if="!loading() && !error() && sessions().length === 0" class="empty-state">No sessions recorded yet.</div>
    <div @for="session in sessions()" @if="!loading() && !error()" class="session-card" @click="viewSession(session.sessionId || session.id)">
      <div class="flex justify-between items-center mb-2">
        <span class="font-medium text-text">{{ session.entryPage || session.entryPath || '/' }}</span>
        <span class="text-xs text-muted">{{ timeAgo(session.startTime || session.startedAt) }}</span>
      </div>
      <div class="flex gap-4 text-xs text-muted">
        <span>{{ (session.pageViews || session.pageViewCount || 1) }} page{{ (session.pageViews || session.pageViewCount || 1) !== 1 ? 's' : '' }}</span>
        <span @class="[(session.bounced || session.isBounce) ? 'text-error' : '']">{{ (session.bounced || session.isBounce) ? 'Bounced' : formatDuration(session.duration) }}</span>
        <span>{{ session.browser || 'Unknown' }}</span>
        <span>{{ session.country || 'Unknown' }}</span>
      </div>
    </div>
  </div>
</div>

<style>
/* Timeline type badges - base + color variants (rgba values) */
.timeline-type { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; padding: 0.25rem 0.5rem; border-radius: 0.25rem; min-width: 60px; text-align: center; }
.timeline-type.pageview { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.timeline-type.event { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
.timeline-type.click { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
.timeline-type.error { background: rgba(239, 68, 68, 0.15); color: #ef4444; }

</style>
