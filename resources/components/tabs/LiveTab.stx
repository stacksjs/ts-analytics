<script client>
import type { LiveActivity } from '../../types/analytics'
import { useSiteApi } from '@composables'

const { siteId: _siteId, apiUrl: _apiUrl } = useSiteApi()

const activities = state<LiveActivity[]>([])
const loading = state<boolean>(true)
const error = state<string | null>(null)

async function fetchLive(): Promise<void> {
  if (!_siteId()) { loading.set(false); return }
  try {
    const res: Response = await fetch(_apiUrl('/live'))
    const data: { activities?: LiveActivity[] } = await res.json()
    activities.set(data.activities || [])
    error.set(null)
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

function timeAgo(ts: string | null): string {
  if (!ts) return ''
  const diff = Math.floor((Date.now() - new Date(ts).getTime()) / 1000)
  if (diff < 5) return 'just now'
  if (diff < 60) return `${diff}s ago`
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`
  return `${Math.floor(diff / 86400)}d ago`
}

onMount(() => {
  fetchLive()
  const interval = setInterval(fetchLive, 5000)
  return () => clearInterval(interval)
})
</script>

<div class="col-span-full">
  <div class="flex justify-between items-center mb-4">
    <h3 class="panel-title">
      <span class="live-pulse"></span>
      Live Activity
    </h3>
    <span class="text-xs text-muted">Auto-refreshing every 5s</span>
  </div>

  <div @show="error()" class="panel text-center text-error">
    {{ error() }}
  </div>

  <div class="flex flex-col gap-2" @show="!error()">
    <div @for="activity in activities()" @loading="loading()" class="panel flex items-center gap-4 py-3 px-4">
      <div class="w-2 h-2 bg-success rounded-full flex-shrink-0"></div>
      <div class="flex-1 min-w-0">
        <div class="text-sm text-text truncate">{{ activity.path ? activity.path : '/' }}</div>
        <div class="text-[0.6875rem] text-muted">
          {{ activity.country ? activity.country : 'Unknown' }} &bull; {{ activity.device ? activity.device : 'Unknown' }} &bull; {{ activity.browser ? activity.browser : 'Unknown' }}
        </div>
      </div>
      <div class="text-[0.6875rem] text-muted whitespace-nowrap">{{ timeAgo(activity.timestamp) }}</div>
    </div>
    <div @for-loading class="panel flex items-center justify-center gap-2 text-muted">
      <div class="spinner"></div>
      <span>Loading...</span>
    </div>
    <div @for-empty class="empty-state">
      No recent activity. Visitors will appear here in real-time.
    </div>
  </div>
</div>

<style>
.live-pulse {
  width: 0.5rem;
  height: 0.5rem;
  background-color: var(--success);
  border-radius: 9999px;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
</style>
