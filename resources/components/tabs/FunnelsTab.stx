<script client>
import type { Funnel, FunnelAnalysisStep, FunnelAnalysis } from '../../types/analytics'
import { useSiteApi, useModal } from '@composables'

const { siteId: _siteId, apiUrl: _apiUrl, dateParams: _dateParams } = useSiteApi()
const Modal = useModal()

const funnels = state<Funnel[]>([])
const loading = state<boolean>(true)
const error = state<string | null>(null)
const currentAnalysis = state<FunnelAnalysis | null>(null)
const showHeaderBtn = state<boolean>(false)
const newFunnelSteps = state<string[]>(['', ''])

async function fetchFunnels(): Promise<void> {
  if (!_siteId()) { loading.set(false); return }
  loading.set(true)
  error.set(null)
  currentAnalysis.set(null)
  showHeaderBtn.set(false)
  try {
    const res: Response = await fetch(_apiUrl('/funnels'))
    const data: { funnels?: Funnel[] } = await res.json()
    funnels.set(data.funnels || [])
    if ((data.funnels || []).length > 0) showHeaderBtn.set(true)
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

async function analyzeFunnel(funnelId: string): Promise<void> {
  loading.set(true)
  error.set(null)
  try {
    const res: Response = await fetch(_apiUrl(`/funnels/${funnelId}/analysis${_dateParams()}`))
    const data: FunnelAnalysis = await res.json()
    currentAnalysis.set(data)
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

function backToFunnels(): void {
  currentAnalysis.set(null)
  fetchFunnels()
}

function syncStepInputValues(): string[] {
  const overlay = document.getElementById('modal-overlay')
  if (!overlay) return newFunnelSteps()
  const inputs = overlay.querySelectorAll<HTMLInputElement>('.funnel-step-input')
  return newFunnelSteps().map((step: string, i: number) => inputs[i] ? inputs[i].value : step)
}

function getFunnelNameValue(): string {
  const overlay = document.getElementById('modal-overlay')
  if (!overlay) return ''
  const input = overlay.querySelector<HTMLInputElement>('input[name="funnelName"]')
  return input ? input.value : ''
}

function renderStepsHtml(steps: string[]): string {
  return steps.map((step: string, index: number) => `
    <div class="step-input-row">
      <input type="text" class="form-input funnel-step-input" placeholder="/path" value="${step}" data-index="${index}" />
      ${steps.length > 2 ? `<button type="button" class="btn-icon danger" onclick="window.__removeFunnelStep(${index})">×</button>` : ''}
    </div>
  `).join('')
}

function renderFunnelModalContent(funnelName: string = ''): string {
  const steps = newFunnelSteps()
  return `
    <div class="form-group">
      <label class="form-label">Funnel Name</label>
      <input type="text" name="funnelName" class="form-input" placeholder="e.g., Checkout Flow" value="${funnelName}" />
    </div>
    <div class="form-group">
      <label class="form-label">Steps (URL paths)</label>
      <div class="steps-list">${renderStepsHtml(steps)}</div>
      <button type="button" class="btn btn-secondary btn-sm" onclick="window.__addFunnelStep()">+ Add Step</button>
    </div>
  `
}

function openFunnelModal(funnelName: string = ''): void {
  Modal.open({
    title: 'Create Funnel',
    content: renderFunnelModalContent(funnelName),
    submitText: 'Create Funnel',
    onSubmit: createFunnel,
  })
}

function showCreateFunnelModal(): void {
  newFunnelSteps.set(['', ''])
  openFunnelModal()
}

function addFunnelStep(): void {
  const name = getFunnelNameValue()
  const updated = syncStepInputValues()
  updated.push('')
  newFunnelSteps.set(updated)
  openFunnelModal(name)
}

function removeFunnelStep(index: number): void {
  const name = getFunnelNameValue()
  const updated = syncStepInputValues()
  updated.splice(index, 1)
  newFunnelSteps.set(updated)
  openFunnelModal(name)
}

async function createFunnel(): Promise<void> {
  const data: Record<string, string | boolean> = Modal.getFormData()
  const name = String(data.funnelName || '')
  const steps = syncStepInputValues().filter((s: string) => s.trim())

  if (!name || steps.length < 2) {
    alert('Please enter a name and at least 2 steps')
    return
  }

  try {
    await fetch(_apiUrl('/funnels'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, steps }),
    })
    Modal.close()
    fetchFunnels()
  } catch (e: unknown) {
    alert(`Error creating funnel: ${(e as Error).message}`)
  }
}

async function deleteFunnel(funnelId: string): Promise<void> {
  Modal.confirm('Delete this funnel?', async () => {
    try {
      await fetch(_apiUrl(`/funnels/${funnelId}`), { method: 'DELETE' })
      fetchFunnels()
    } catch (e: unknown) {
      alert(`Error deleting funnel: ${(e as Error).message}`)
    }
  })
}

provide('showCreateFunnelModal', showCreateFunnelModal)
provide('analyzeFunnel', analyzeFunnel)
provide('deleteFunnel', deleteFunnel)
provide('backToFunnels', backToFunnels)

window.__addFunnelStep = addFunnelStep
window.__removeFunnelStep = removeFunnelStep

onMount(() => {
  fetchFunnels()
  return () => {
    delete window.__addFunnelStep
    delete window.__removeFunnelStep
  }
})
</script>

<div class="col-span-full">
  <div class="flex justify-between items-center mb-4">
    <h3 class="text-base font-semibold text-text">
      <button x-show="currentAnalysis()" class="back-link" @click="backToFunnels()">&larr; Back to Funnels</button>
      <span x-show="!currentAnalysis()">Conversion Funnels</span>
    </h3>
    <button x-show="showHeaderBtn() && !currentAnalysis()" class="btn btn-primary" @click="showCreateFunnelModal()">
      <Icon name="plus" size="16" />
      New Funnel
    </button>
  </div>

  <div x-show="loading()" class="text-center text-muted p-8 bg-bg-2 border border-border rounded-lg flex items-center justify-center gap-2"><Spinner size="sm" color="primary" /><span>Loading...</span></div>

  <div x-show="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">{{ error() }}</div>

  <div x-show="currentAnalysis() && !loading()">
    <h3 class="text-base font-semibold text-text mb-2">{{ currentAnalysis().name }}</h3>
    <p class="text-xs text-muted mb-6">
      {{ currentAnalysis().totalVisitors }} visitors entered &bull; {{ currentAnalysis().conversionRate }}% overall conversion
    </p>
    <div class="funnel-steps-analysis flex gap-2 items-stretch flex-wrap">
      <div x-for="(step, index) in (currentAnalysis?.steps || [])" class="analysis-step-wrapper flex items-center gap-2 flex-1 min-w-[120px]">
        <div class="flex-1 text-center">
          <div class="bg-bg-2 border border-border rounded-lg p-4 mb-2">
            <div class="text-2xl font-semibold text-text">{{ step.visitors }}</div>
            <div class="text-[0.6875rem] text-muted mt-1"><span>{{ step.rate }}</span>%</div>
          </div>
          <div class="text-xs font-medium text-text">{{ step.path }}</div>
          <div x-show="step.dropoff > 0" class="text-[0.6875rem] text-error mt-1"><span>{{ '-' + step.dropoff + ' dropped' }}</span></div>
        </div>
        <div x-show="index < currentAnalysis().steps.length - 1" class="text-muted text-2xl">&rarr;</div>
      </div>
    </div>
  </div>

  <div x-show="!currentAnalysis() && !loading() && !error()">
    <div x-show="funnels().length === 0" class="empty-state">
      <Icon name="filter" size="48" class="mb-4 opacity-50" />
      <p>No funnels configured yet</p>
      <p class="text-xs mt-2">Create a funnel to track conversion rates through your key user flows.</p>
      <button class="btn btn-primary mt-4" @click="showCreateFunnelModal()">
        <Icon name="plus" size="16" />
        Create Your First Funnel
      </button>
    </div>

    <div x-for="funnel in funnels" class="bg-bg-2 border border-border rounded-lg p-4 mb-3">
      <div class="flex justify-between items-center mb-3">
        <h4 class="text-sm font-semibold text-text m-0">{{ funnel.name }}</h4>
        <div class="flex gap-1">
          <button class="icon-btn" @click="analyzeFunnel(funnel.id)" title="View analysis">
            <Icon name="bar-chart-2" size="16" />
          </button>
          <button class="icon-btn danger" @click="deleteFunnel(funnel.id)" title="Delete">
            <Icon name="trash-2" size="16" />
          </button>
        </div>
      </div>
      <div class="flex gap-2 flex-wrap items-center">
        <span x-for="(step, idx) in funnel.steps" class="text-[0.6875rem] py-1 px-2 bg-bg rounded text-text">
          <span>{{ step }}</span>
          <span x-show="idx < funnel.steps.length - 1" class="text-accent">&rarr;</span>
        </span>
      </div>
    </div>
  </div>
</div>

<style>
.back-link { background: transparent; border: none; color: var(--muted); cursor: pointer; font-size: 0.8125rem; padding: 0; }
.back-link:hover { color: var(--text); }

.icon-btn.danger:hover { background: rgba(239, 68, 68, 0.15); color: #ef4444; }

.form-group { margin-bottom: 1rem; }
.form-label { display: block; font-size: 0.8125rem; font-weight: 500; color: var(--text); margin-bottom: 0.375rem; }
.steps-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.5rem; }
.step-input-row { display: flex; gap: 0.5rem; }
.btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }

@media (max-width: 640px) {
  .funnel-steps-analysis { flex-direction: column; }
  .analysis-step-wrapper { min-width: 100%; }
}
</style>
