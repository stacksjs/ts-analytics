<script client>
import type { Vital, BudgetViolation } from '../../types/analytics'
import { useSiteApi } from '@composables'

const { siteId: _siteId, apiUrl: _apiUrl, dateParams: _dateParams } = useSiteApi()

const vitals = state<Vital[]>([])
const violations = state<BudgetViolation[]>([])
const loading = state<boolean>(true)
const error = state<string | null>(null)

async function fetchVitals(): Promise<void> {
  if (!_siteId()) { loading.set(false); return }
  try {
    const [vitalsRes, budgetsRes]: [Response, Response] = await Promise.all([
      fetch(_apiUrl(`/vitals${_dateParams()}`)),
      fetch(_apiUrl('/performance-budgets/check')),
    ])
    const vitalsData: { vitals?: Vital[] } = await vitalsRes.json()
    const budgetsData: { violations?: BudgetViolation[] } = await budgetsRes.json()

    vitals.set(vitalsData.vitals || [])
    violations.set(budgetsData.violations || [])
    error.set(null)
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

function getRating(v: Vital | null): string {
  if (!v || v.samples === 0) return ''
  if ((v.good || 0) >= 75) return 'good'
  if ((v.poor || 0) >= 25) return 'poor'
  return 'needs-improvement'
}

function vitalValueClass(v: Vital): string {
  return `text-2xl font-bold text-text mb-1 vital-value ${getRating(v)}`
}

function formatValue(metric: string, value: number): string {
  if (metric === 'CLS') return (value / 1000).toFixed(3)
  return `${value}ms`
}

onMount(() => {
  fetchVitals()
})
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-4">Core Web Vitals</h3>

  <div @show="loading()" class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
    <div class="spinner"></div>
    <span>Loading...</span>
  </div>

  <div @show="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">
    {{ error() }}
  </div>

  <div @show="!loading() && !error()">
    <div @show="violations().length > 0" class="bg-error/10 border border-error/30 rounded-lg p-4 mb-4">
      <h4 class="text-sm font-semibold text-error mb-2">Performance Budget Violations</h4>
      <div class="flex flex-col gap-2">
        <div @for="v in violations()" class="text-[0.8125rem] flex gap-2 items-center">
          <span class="font-semibold text-text">{{ v.metric }}</span>
          <span class="text-error">{{ v.currentValue }}{{ v.metric === 'CLS' ? '' : 'ms' }}</span>
          <span class="text-muted">
            (exceeds {{ v.threshold }}{{ v.metric === 'CLS' ? '' : 'ms' }} by {{ v.exceededBy }}{{ v.metric === 'CLS' ? '' : 'ms' }})
          </span>
        </div>
      </div>
    </div>

    <div class="vitals-grid">
      <div @for="v in vitals()" class="vital-card">
        <div class="text-xs font-semibold text-muted uppercase tracking-wider mb-1">{{ v.metric }}</div>
        <div x-class="vitalValueClass(v)">
          {{ v.samples > 0 ? formatValue(v.metric, v.p75) : '—' }}
        </div>
        <div class="text-[0.6875rem] text-muted mb-2">{{ v.samples }} samples</div>
        <div @show="v.samples > 0" class="h-1 rounded-sm flex overflow-hidden bg-bg">
          <div class="good" x-style="'width: ' + v.good + '%'"></div>
          <div class="needs-improvement" x-style="'width: ' + v.needsImprovement + '%'"></div>
          <div class="poor" x-style="'width: ' + v.poor + '%'"></div>
        </div>
      </div>
    </div>

    <div @show="vitals().length === 0" class="empty-state">
      No Web Vitals data available yet.
    </div>
  </div>
</div>

<style>
.vitals-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.vital-value.good { color: var(--success); }
.vital-value.needs-improvement { color: var(--warning); }
.vital-value.poor { color: var(--error); }

.good { background: var(--success); }
.needs-improvement { background: var(--warning); }
.poor { background: var(--error); }
</style>
