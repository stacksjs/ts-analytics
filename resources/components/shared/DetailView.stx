<script client>
interface DataItem {
  [key: string]: string | number | null
}

interface SectionConfig {
  title: string
  icon: string
}

interface StealthMap {
  [key: string]: string
}

const allData = state<DataItem[]>([])
const filteredData = state<DataItem[]>([])
const loading = state<boolean>(true)
const error = state<string | null>(null)
const searchQuery = state<string>('')
const currentPage = state<number>(1)
const pageSize: number = 50

const urlParams: URLSearchParams = new URLSearchParams(window.location.search)
const API: string = window.ANALYTICS_API || urlParams.get('api') || window.location.origin
const SITE_ID: string = urlParams.get('siteId') || window.ANALYTICS_SITE_ID || ''
const USE_STEALTH: boolean = urlParams.get('stealth') !== 'false'

const sectionAttr: string | undefined = document.currentScript?.closest('[data-section]')?.dataset.section
const pathMatch: RegExpMatchArray | null = window.location.pathname.match(/\/dashboard\/(.+)/)
const SECTION: string = sectionAttr || (pathMatch ? pathMatch[1] : 'pages')

const STEALTH_MAP: StealthMap = {
  sites: 'projects', stats: 'summary', realtime: 'pulse', pages: 'content',
  referrers: 'sources', devices: 'clients', browsers: 'agents', countries: 'geo',
  regions: 'area', cities: 'locale', timeseries: 'series', events: 'actions',
  campaigns: 'promo', comparison: 'diff', sessions: 'visits', flow: 'journey',
  live: 'now', heatmap: 'touch', errors: 'issues', vitals: 'metrics',
  goals: 'targets', funnels: 'pipelines', annotations: 'notes',
}

function apiPath(path: string): string {
  if (!USE_STEALTH) return path
  let result: string = path.replace('/api/sites/', '/api/p/').replace('/api/sites', '/api/projects')
  Object.keys(STEALTH_MAP).sort((a: string, b: string) => b.length - a.length).forEach((k: string) => {
    result = result.replace(new RegExp(`/${k}(?=/|\\?|$)`, 'g'), `/${STEALTH_MAP[k]}`)
  })
  return result
}

const sections: Record<string, SectionConfig> = {
  pages: { title: 'Pages', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  referrers: { title: 'Referrers', icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1' },
  devices: { title: 'Devices', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  browsers: { title: 'Browsers', icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9' },
  countries: { title: 'Countries', icon: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  campaigns: { title: 'Campaigns', icon: 'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z' },
  events: { title: 'Events', icon: 'M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122' },
  goals: { title: 'Goals', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
}

const sectionConfig: SectionConfig = sections[SECTION] || sections.pages

const paginatedData = derived((): DataItem[] => {
  const start: number = (currentPage() - 1) * pageSize
  return filteredData().slice(start, start + pageSize)
})

const totalPages = derived((): number => Math.ceil(filteredData().length / pageSize))

const columnKeys = derived((): string[] => {
  const data: DataItem[] = filteredData()
  return data.length > 0 ? Object.keys(data[0]) : []
})

const backHref = `/dashboard?siteId=${SITE_ID}`

async function loadData(): Promise<void> {
  loading.set(true)
  try {
    const res: Response = await fetch(apiPath(`${API}/api/sites/${SITE_ID}/${SECTION}`))
    if (!res.ok) throw new Error('Failed to load')
    const data: Record<string, DataItem[]> = await res.json()
    const items: DataItem[] = data[SECTION] || data.pages || data.referrers || data.browsers || data.countries || data.campaigns || data.events || data.goals || []
    allData.set(items)
    filteredData.set([...items])
    error.set(null)
  } catch (err) {
    error.set('Failed to load data')
  } finally {
    loading.set(false)
  }
}

function filterData(): void {
  const query: string = searchQuery().toLowerCase()
  if (!query) {
    filteredData.set([...allData()])
  } else {
    filteredData.set(allData().filter((item: DataItem) =>
      Object.values(item).some((val: string | number | null) => String(val).toLowerCase().includes(query)),
    ))
  }
  currentPage.set(1)
}

function goToPage(page: number): void {
  currentPage.set(page)
}

function formatKey(key: string): string {
  return key.replace(/([A-Z])/g, ' $1').replace(/^./, (s: string) => s.toUpperCase())
}

function formatValue(value: string | number | null, key: string): string {
  if (value == null) return '-'
  if ((key.includes('time') || key.includes('Time')) && typeof value === 'number') {
    const mins: number = Math.floor(value / 60000)
    const secs: number = Math.floor((value % 60000) / 1000)
    return `${mins}:${secs.toString().padStart(2, '0')}`
  }
  if ((key.includes('rate') || key.includes('Rate') || key === 'percentage') && typeof value === 'number') {
    return `${value.toFixed(1)}%`
  }
  return typeof value === 'number' ? value.toLocaleString() : String(value)
}

onMount(() => {
  document.title = `${sectionConfig.title} - Analytics`
  loadData()
})

effect(() => {
  searchQuery()
  filterData()
})
</script>

<div class="p-8 max-w-7xl mx-auto" data-section="{{ SECTION }}">
  <a href="{{ backHref }}" class="inline-flex items-center gap-1 text-accent text-sm mb-4 hover:underline">
    <Icon name="chevron-left" size="16" />
    Back to Dashboard
  </a>

  <header class="mb-6">
    <h1 class="flex items-center gap-3 text-2xl font-semibold text-text">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="sectionConfig.icon" />
      </svg>
      <span>{{ sectionConfig.title }}</span>
    </h1>
  </header>

  <div class="mb-4">
    <input
      type="text"
      placeholder="Search..."
      class="form-input max-w-[20rem] placeholder:text-muted"
      x-model="searchQuery"
    />
  </div>

  <div x-show="loading()" class="flex items-center justify-center gap-2 text-center p-8 text-muted">
    <Spinner size="sm" color="primary" />
    <span>Loading...</span>
  </div>

  <div x-show="error()" class="text-center p-8 text-error">
    {{ error() }}
  </div>

  <div x-show="!loading() && !error()">
    <div x-show="filteredData().length === 0" class="empty-state">
      No data available
    </div>

    <div x-show="filteredData().length > 0" class="overflow-x-auto">
      <table class="data-table w-full">
        <thead>
          <tr>
            <th x-for="key in columnKeys()" class="text-left p-3 text-muted font-medium text-sm border-b border-border">{{ formatKey(key) }}</th>
          </tr>
        </thead>
        <tbody>
          <tr x-for="item in paginatedData()" class="hover:bg-bg-3">
            <td x-for="key in columnKeys()" class="p-3 text-sm border-b border-bg-3">{{ formatValue(item[key], key) }}</td>
          </tr>
        </tbody>
      </table>

      <div x-show="totalPages() > 1" class="flex items-center justify-center gap-4 mt-4">
        <button
          @click="goToPage(currentPage() - 1)"
          x-disabled="currentPage() === 1"
          class="btn btn-secondary disabled:opacity-50 disabled:cursor-not-allowed"
        >Previous</button>
        <span class="text-muted text-sm">Page {{ currentPage() }} of {{ totalPages() }}</span>
        <button
          @click="goToPage(currentPage() + 1)"
          x-disabled="currentPage() === totalPages()"
          class="btn btn-secondary disabled:opacity-50 disabled:cursor-not-allowed"
        >Next</button>
      </div>
    </div>
  </div>
</div>
