<script client>
/**
 * InsightCard Component
 * Displays an individual insight with icon and description
 */
const type: string = $props.type || 'info'
const title: string = $props.title || ''
const description: string = $props.description || ''
const severity: string = $props.severity || 'info'

const iconMap: Record<string, string> = {
  growth: '📈',
  decline: '📉',
  warning: '⚠️',
  success: '✅',
  info: 'ℹ️'
}

const icon = derived(() => iconMap[type] || iconMap.info)
</script>

<div class="flex gap-3 p-3 bg-bg-2 rounded-lg border border-border">
  <div @class="['w-8 h-8 flex items-center justify-center rounded-md text-base insight-icon', severity]">{{ icon() }}</div>
  <div class="flex-1 min-w-0">
    <div class="font-medium text-sm text-text mb-1">{{ title }}</div>
    <div class="text-xs text-muted leading-relaxed">{{ description }}</div>
  </div>
</div>

<style>
.insight-icon.info { background: rgba(59, 130, 246, 0.1); }
.insight-icon.warning { background: rgba(245, 158, 11, 0.1); }
.insight-icon.success { background: rgba(16, 185, 129, 0.1); }
.insight-icon.error { background: rgba(239, 68, 68, 0.1); }
</style>
