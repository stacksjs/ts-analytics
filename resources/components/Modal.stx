<script client>
import type { ModalOptions } from '../types/dashboard'

const visible = state<boolean>(false)
const modalOptions = state<ModalOptions | null>(null)
const isSubmitting = state<boolean>(false)
let onSubmitCallback: (() => Promise<void>) | null = null
let onCancelCallback: (() => void) | null = null

function modalClass(): string {
  const opts = modalOptions()
  if (!opts) return 'modal'
  const parts = ['modal']
  if (opts.size) parts.push(`modal-${opts.size}`)
  if (opts.className) parts.push(opts.className)
  return parts.join(' ')
}

function open(options?: ModalOptions): void {
  options = options || {}
  onSubmitCallback = options.onSubmit || null
  onCancelCallback = options.onCancel || null
  isSubmitting.set(false)
  modalOptions.set(options)
  visible.set(true)

  setTimeout(() => {
    const input = document.querySelector<HTMLElement>('#modal-overlay input, #modal-overlay select, #modal-overlay textarea')
    if (input) input.focus()
  }, 50)
}

function close(): void {
  visible.set(false)
  modalOptions.set(null)
  if (onCancelCallback) onCancelCallback()
  onSubmitCallback = null
  onCancelCallback = null
  isSubmitting.set(false)
}

async function handleSubmit(): Promise<void> {
  if (!onSubmitCallback || isSubmitting()) return
  isSubmitting.set(true)
  try {
    await onSubmitCallback()
  } catch (e) {
    console.error('Modal submit error:', e)
    isSubmitting.set(false)
  }
}

function getFormData(): Record<string, string | boolean> {
  const data: Record<string, string | boolean> = {}
  document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('#modal-overlay input, #modal-overlay select, #modal-overlay textarea').forEach((el) => {
    if (el.name) data[el.name] = (el as HTMLInputElement).type === 'checkbox' ? (el as HTMLInputElement).checked : el.value
  })
  return data
}

function confirm(message: string, onConfirm: () => Promise<void>): void {
  return open({
    title: 'Confirm',
    content: `<p class="confirm-message">${message}</p>`,
    size: 'sm',
    submitText: 'Confirm',
    onSubmit: async () => { await onConfirm(); close() },
  })
}

function alertModal(alertTitle: string, message: string): void {
  return open({
    title: alertTitle,
    content: `<p class="alert-message">${message}</p>`,
    size: 'sm',
    showFooter: true,
    onSubmit: null,
  })
}

const Modal = { open, close, handleSubmit, getFormData, confirm, alert: alertModal }

provide('Modal', Modal)
// useModal() resolves `window.Modal` (with a no-op fallback), and provide()/
// inject() alone doesn't reach that composable — so without exposing it here
// every Modal.open()/confirm() silently does nothing.
window.Modal = Modal

onMount(() => {
  const handleEsc = (e: KeyboardEvent): void => {
    if (e.key === 'Escape' && visible()) close()
  }
  document.addEventListener('keydown', handleEsc)
  return () => document.removeEventListener('keydown', handleEsc)
})
</script>

<div id="modal-overlay" class="modal-overlay backdrop-blur-sm" x-show="visible()" @click.self="close()">
  <div x-show="modalOptions()" x-class="modalClass()">
    <div class="modal-header">
      <h3 class="modal-title">{{ modalOptions()?.title || '' }}</h3>
      <button class="modal-close" type="button" aria-label="Close" @click="close()">
        <Icon name="x" size="20" />
      </button>
    </div>
    <div class="modal-body" @html="modalOptions()?.content || ''"></div>
    <div x-show="modalOptions()?.showFooter !== false" class="modal-footer">
      <button type="button" class="btn btn-secondary modal-cancel" @click="close()">{{ modalOptions()?.cancelText || 'Cancel' }}</button>
      <button x-show="modalOptions()?.onSubmit" type="button" class="btn btn-primary modal-submit"
              @click="handleSubmit()" x-disabled="isSubmitting()">
        {{ isSubmitting() ? 'Saving...' : (modalOptions()?.submitText || 'Save') }}
      </button>
    </div>
  </div>
</div>

<style>
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95) translateY(-10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal {
  background-color: var(--bg);
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  width: 100%;
  max-width: 480px;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  animation: modalIn 0.15s ease-out;
}

.modal-sm { max-width: 360px; }
.modal-lg { max-width: 640px; }
.modal-xl { max-width: 900px; }

.modal-header { background-color: var(--bg2); }

.modal-title { font-size: 1rem; line-height: 1.5rem; font-weight: 600; margin: 0; color: var(--text); }

.modal-close {
  background-color: transparent;
  border: none;
  color: var(--muted);
  cursor: pointer;
  padding: 0.375rem;
  margin-right: -0.375rem;
  margin-bottom: -0.375rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.375rem;
  transition: all 150ms;
}
.modal-close:hover { background-color: var(--bg3); color: var(--text); }

.modal-body { overflow-y: auto; flex: 1 1 0%; }

.modal-footer { background-color: var(--bg2); }

.modal .form-group { margin-bottom: 1rem; }
.modal .form-group:last-child { margin-bottom: 0; }
.modal .form-label { display: block; font-size: 0.8125rem; font-weight: 500; color: var(--text); margin-bottom: 0.375rem; }
.modal .form-hint { font-size: 0.75rem; line-height: 1rem; color: var(--muted); margin-top: 0.25rem; }

.modal .form-input:focus,
.modal .form-select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.modal .form-input::placeholder { color: var(--muted); }

.modal .checkbox-group { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
.modal .checkbox-label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; line-height: 1.25rem; color: var(--text); cursor: pointer; }

.modal .checkbox-label input[type="checkbox"] {
  width: 1rem;
  height: 1rem;
  accent-color: var(--accent);
}

.modal .btn:disabled { opacity: 0.6; cursor: not-allowed; }

.modal .confirm-message,
.modal .alert-message {
  margin: 0;
  font-size: 0.9375rem;
  color: var(--text);
  line-height: 1.625;
}
</style>
