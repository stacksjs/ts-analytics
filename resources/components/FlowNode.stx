<script server lang="ts">
import { defineProps, withDefaults } from 'stx'

interface FlowNodeProps {
  path?: string
  count?: number
}

const { path, count } = withDefaults(defineProps<FlowNodeProps>(), {
  path: '/',
  count: 0,
})
</script>

<div class="bg-bg-2 border border-border rounded-md py-2 px-3 mb-2">
  <div class="text-[0.8125rem] font-medium text-text break-all">{{ path }}</div>
  <div class="text-[0.6875rem] text-muted mt-0.5">{{ count }} visits</div>
</div>
