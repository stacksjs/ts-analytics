<script client>
/**
 * StatCard Component
 * Displays a statistic with optional change indicator
 */
const value: string = $props.value || '0'
const label: string = $props.label || ''
const change: number | undefined = $props.change
const id: string = $props.id || ''

const hasChange = derived(() => change !== undefined && change !== null)
const isPositive = derived(() => change >= 0)
const changeClass = derived(() => isPositive() ? 'text-success' : 'text-error')
const changeText = derived(() => (isPositive() ? '+' : '') + change + '%')
</script>

<div class="bg-bg-2 rounded-lg p-4 text-center border border-border">
  <div class="text-2xl font-semibold text-text mb-1" x-id="id">{{ value }}</div>
  <div class="text-xs text-muted uppercase tracking-wide">{{ label }}</div>
  <div @if="hasChange()" @class="['text-[0.6875rem] mt-1', changeClass()]">
    {{ changeText() }}
  </div>
</div>
