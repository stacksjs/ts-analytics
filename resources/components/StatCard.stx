<script server>
import { defineProps, withDefaults } from 'stx'

interface StatCardProps {
  value?: string
  label?: string
  change?: number
  id?: string
}

const { value, label, change, id } = withDefaults(defineProps<StatCardProps>(), {
  value: '0',
  label: '',
  change: undefined,
  id: '',
})

const hasChange = change !== undefined && change !== null
const isPositive = (change ?? 0) >= 0
const changeClass = isPositive ? 'text-success' : 'text-error'
const changeText = `${isPositive ? '+' : ''}${change}%`
</script>

<div class="bg-bg-2 rounded-lg p-4 text-center border border-border">
  <div class="text-2xl font-semibold text-text mb-1" id="{{ id }}">{{ value }}</div>
  <div class="text-xs text-muted uppercase tracking-wide">{{ label }}</div>
  @if (hasChange)
    <div class="text-[0.6875rem] mt-1 {{ changeClass }}">{{ changeText }}</div>
  @endif
</div>
