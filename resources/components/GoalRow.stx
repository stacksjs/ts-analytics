<script client>
/**
 * GoalRow Component
 * Displays a goal in the goals table
 */
interface Goal {
  id?: string
  name?: string
  type?: string
  conversions?: number
  totalValue?: number
}

const goal: Goal = $props.goal || {}
const onEdit: ((id: string | undefined) => void) | undefined = $props.onEdit
const onDelete: ((id: string | undefined) => void) | undefined = $props.onDelete

const name = derived(() => goal.name || 'Unnamed')
const type = derived(() => goal.type || 'pageview')
const conversions = derived(() => goal.conversions || 0)
const value = derived(() => goal.totalValue ? '$' + goal.totalValue.toFixed(2) : '-')

function handleEdit(): void {
  if (onEdit) onEdit(goal.id)
}

function handleDelete(): void {
  if (onDelete) onDelete(goal.id)
}
</script>

<tr>
  <td class="font-medium">{{ name() }}</td>
  <td>
    <span @class="['text-[0.6875rem] py-0.5 px-1.5 rounded-sm uppercase goal-type-badge', type()]">{{ type() }}</span>
  </td>
  <td class="text-right">{{ conversions() | fmt }}</td>
  <td class="text-right">{{ value() }}</td>
  <td class="flex gap-2 justify-end">
    <button class="py-1 px-2 text-xs rounded border-none cursor-pointer bg-bg-3 text-text hover:bg-accent hover:text-white edit-btn" @click="handleEdit">Edit</button>
    <button class="py-1 px-2 text-xs rounded border-none cursor-pointer bg-transparent text-muted delete-btn" @click="handleDelete">Delete</button>
  </td>
</tr>

<style>
.goal-type-badge.pageview {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}
.goal-type-badge.event {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}
.goal-type-badge.duration {
  background: rgba(168, 85, 247, 0.1);
  color: #a855f7;
}
.delete-btn:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}
</style>
