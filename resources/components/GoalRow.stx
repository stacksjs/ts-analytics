<script server>
import { defineProps, withDefaults } from 'stx'

interface Goal {
  id?: string
  name?: string
  type?: string
  conversions?: number
  totalValue?: number
}

interface GoalRowProps {
  goal?: Goal
}

const { goal } = withDefaults(defineProps<GoalRowProps>(), {
  goal: () => ({}),
})

const goalId = goal.id || ''
const name = goal.name || 'Unnamed'
const type = goal.type || 'pageview'
const conversions = goal.conversions || 0
const value = goal.totalValue ? `$${goal.totalValue.toFixed(2)}` : '-'
</script>

<script client>
function dispatchGoal(action, e) {
  const id = e.currentTarget.getAttribute('data-goal-id') || ''
  window.dispatchEvent(new CustomEvent('goal-action', { detail: { id, action } }))
}
</script>

<tr>
  <td class="font-medium">{{ name }}</td>
  <td>
    <span class="text-[0.6875rem] py-0.5 px-1.5 rounded-sm uppercase goal-type-badge {{ type }}">{{ type }}</span>
  </td>
  <td class="text-right">{{ conversions | fmt }}</td>
  <td class="text-right">{{ value }}</td>
  <td class="flex gap-2 justify-end">
    <button class="py-1 px-2 text-xs rounded border-none cursor-pointer bg-bg-3 text-text hover:bg-accent hover:text-white edit-btn" data-goal-id="{{ goalId }}" @click="(e) => dispatchGoal('edit', e)">Edit</button>
    <button class="py-1 px-2 text-xs rounded border-none cursor-pointer bg-transparent text-muted delete-btn" data-goal-id="{{ goalId }}" @click="(e) => dispatchGoal('delete', e)">Delete</button>
  </td>
</tr>

<style>
.goal-type-badge.pageview {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}
.goal-type-badge.event {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}
.goal-type-badge.duration {
  background: rgba(168, 85, 247, 0.1);
  color: #a855f7;
}
.delete-btn:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}
</style>
