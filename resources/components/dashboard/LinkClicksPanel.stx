<script client>
/**
 * LinkClicksPanel Component
 * Top clicked links (outbound / internal / download / mailto / tel) plus a
 * per-kind summary. Loop-variable values use x-text (not interpolation) per
 * the stx #1748 workaround; :for/x-for use bare signal refs.
 */
const dashboard = useStore('dashboard')

const clicks = state([])
const byKind = state({})
const loading = state(true)

const maxCount = derived(() => Math.max(...clicks().map(c => c.count || 0), 1))

const kindChips = derived(() => {
  const counts = byKind()
  const labels = { outbound: 'Outbound', internal: 'Internal', download: 'Downloads', mailto: 'Email', tel: 'Phone' }
  return Object.keys(labels)
    .map(key => ({ key, label: labels[key], count: counts[key] || 0 }))
    .filter(c => c.count > 0)
})

function fmtNum(n) {
  return (n || 0).toLocaleString()
}

function barWidth(count) {
  const max = maxCount()
  return max > 0 ? Math.round((count / max) * 100) : 0
}

function clickLabel(c) {
  return (c.text && c.text.trim()) ? c.text : c.url
}

async function fetchClicks() {
  if (!dashboard.siteId()) {
    loading.set(false)
    return
  }
  try {
    const res = await fetch(dashboard.apiUrlWithDates('/clicks'))
    const data = await res.json()
    clicks.set((data.clicks || []).slice(0, 10))
    byKind.set(data.byKind || {})
  } catch (e) {
    console.error('Failed to fetch clicks:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (dashboard.siteId()) fetchClicks()
  window.refreshLinkClicksPanel = fetchClicks
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="mouse-pointer" size="16" class="text-muted" />
      Link Clicks
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('clicks')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>

  <div x-show="kindChips().length > 0" class="flex flex-wrap gap-2 mb-3">
    <span x-for="chip in kindChips" class="inline-flex items-center gap-1 rounded-full bg-bg-3 px-2 py-0.5 text-[0.6875rem] text-muted">
      <span x-text="chip.label"></span>
      <span class="font-medium text-text" x-text="fmtNum(chip.count)"></span>
    </span>
  </div>

  <div class="flex flex-col gap-3">
    <div x-for="c in clicks" @loading="loading()" class="flex flex-col gap-1">
      <div class="flex justify-between items-center gap-2">
        <span class="text-[0.8125rem] text-text font-medium truncate" x-text="clickLabel(c)"></span>
        <span class="shrink-0 rounded-sm bg-bg-3 px-1.5 py-0.5 text-[0.625rem] uppercase tracking-wide text-muted" x-text="c.kind"></span>
      </div>
      <div class="h-1.5 bg-bg-3 rounded-sm overflow-hidden">
        <div class="h-full bg-accent rounded-sm transition-[width] duration-300" x-style="'width: ' + barWidth(c.count ? c.count : 0) + '%'"></div>
      </div>
      <div class="text-[0.6875rem] text-muted text-right" x-text="fmtNum(c.count) + ' clicks'"></div>
    </div>
    <div @for-loading class="text-center text-muted py-4 text-[0.8125rem]">Loading...</div>
    <div @for-empty class="text-center text-muted py-4 text-[0.8125rem]">No link clicks tracked yet</div>
  </div>
</div>
