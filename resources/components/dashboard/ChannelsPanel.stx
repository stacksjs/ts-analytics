<script client>
/**
 * ChannelsPanel Component
 * Traffic grouped by acquisition channel (Search / Social / AI / Email /
 * Referral / Paid / Direct), from the /referrers byChannel rollup.
 * Loop-variable values use x-text (not interpolation) per the stx #1748
 * workaround; :for/x-for use bare signal refs.
 */
const dashboard = useStore('dashboard')

const channels = state([])
const loading = state(true)

const totalVisitors = derived(() => channels().reduce((sum, c) => sum + (c.visitors || 0), 0))

function fmtNum(n) {
  return (n || 0).toLocaleString()
}

function pct(visitors) {
  const total = totalVisitors()
  return total > 0 ? Math.round((visitors / total) * 100) : 0
}

async function fetchChannels() {
  if (!dashboard.siteId()) {
    loading.set(false)
    return
  }
  try {
    const res = await fetch(dashboard.apiUrlWithDates('/referrers'))
    const data = await res.json()
    channels.set(data.byChannel || [])
  } catch (e) {
    console.error('Failed to fetch channels:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (dashboard.siteId()) fetchChannels()
  window.refreshChannelsPanel = fetchChannels
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="pie-chart" size="16" class="text-muted" />
      Channels
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('referrers')" class="text-xs text-accent no-underline hover:underline">Referrers &rarr;</a>
  </div>

  <div class="flex flex-col gap-3">
    <div x-for="ch in channels" @loading="loading()" class="flex flex-col gap-1">
      <div class="flex justify-between items-center">
        <span class="text-[0.8125rem] text-text font-medium" x-text="ch.channel"></span>
        <span class="text-xs text-muted shrink-0 ml-2" x-text="pct(ch.visitors ? ch.visitors : 0) + '%'"></span>
      </div>
      <div class="h-1.5 bg-bg-3 rounded-sm overflow-hidden">
        <div class="h-full bg-accent rounded-sm transition-[width] duration-300" x-style="'width: ' + pct(ch.visitors ? ch.visitors : 0) + '%'"></div>
      </div>
      <div class="text-[0.6875rem] text-muted text-right" x-text="fmtNum(ch.visitors) + ' visitors'"></div>
    </div>
    <div @for-loading class="text-center text-muted py-4 text-[0.8125rem]">Loading...</div>
    <div @for-empty class="text-center text-muted py-4 text-[0.8125rem]">No channel data</div>
  </div>
</div>
