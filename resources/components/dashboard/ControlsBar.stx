<script client>
import type { DateRange } from '../../types/dashboard'

const dashboard = useStore('dashboard')
const analytics = useStore('analytics')

const activeRange = state<string>('7d')
const showComparison = state<boolean>(false)
const lastUpdated = state<string>('')
const isRefreshing = state<boolean>(false)

// Realtime visitor count comes from the shared stats; reflect singular/plural.
function realtimeLabel(): string {
  const n = analytics.stats()?.realtime ?? 0
  return n === 1 ? '1 visitor online' : `${n} visitors online`
}

// Stamp "last updated" whenever fresh stats land.
effect(() => {
  if (analytics.stats()) lastUpdated.set(`Updated ${new Date().toLocaleTimeString()}`)
})

const ranges: DateRange[] = [
  { id: '1h', label: '1h' },
  { id: '6h', label: '6h' },
  { id: '12h', label: '12h' },
  { id: '24h', label: '24h' },
  { id: '7d', label: '7d' },
  { id: '30d', label: '30d' },
  { id: '90d', label: '90d' },
]

function setRange(range: string): void {
  activeRange.set(range)
  // Keep the store in sync so store-driven fetches (chart, panels) use the
  // selected range, then let the legacy controller refresh its own pieces.
  dashboard.dateRange.set(range)
  if (window.setDateRange) {
    window.setDateRange(range)
  }
}

function toggleComparison(): void {
  // Drive the shared store (#153) — the chart overlay and stat-card deltas
  // react to it. (window.toggleComparison was a dead legacy-controller hook.)
  showComparison.update((v: boolean) => !v)
  dashboard.showComparison.set(showComparison())
}

async function refresh(): Promise<void> {
  if (isRefreshing()) return
  isRefreshing.set(true)

  if (window.fetchDashboardData) {
    await window.fetchDashboardData()
  }

  setTimeout(() => {
    isRefreshing.set(false)
  }, 500)
}

function exportData(format: string): void {
  if (window.exportData) {
    window.exportData(format)
  } else {
    const siteId: string | undefined = window.siteId
    if (siteId) {
      navigate(window, true).apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/export?format=${format}`)
    }
  }
}

function rangeBtnClass(range: DateRange): string {
  return activeRange() === range.id ? 'date-range-btn date-range-btn-active' : 'date-range-btn'
}

function compareBtnClass(): string {
  const base = 'date-range-btn flex items-center gap-1 text-[0.6875rem] py-1 px-2'
  return showComparison() ? `${base} date-range-btn-active` : base
}

function refreshBtnClass(): string {
  return isRefreshing() ? 'icon-btn spinning' : 'icon-btn'
}

onMount(() => {
  window.controlsSetDateRange = (range: string) => activeRange.set(range)
  window.controlsBar = {
    setRange,
    toggleComparison,
    refresh,
    exportData,
    activeRange: () => activeRange(),
    showComparison: () => showComparison(),
    isRefreshing: () => isRefreshing(),
  }

  if (window.dateRange) {
    activeRange.set(window.dateRange)
    dashboard.dateRange.set(window.dateRange)
  }
})

provide('controlsBar', {
  activeRange,
  showComparison,
  lastUpdated,
  isRefreshing,
  setRange,
  toggleComparison,
  refresh,
  exportData,
})
</script>

<div id="controls-bar" class="flex justify-between items-center py-3 px-6 bg-bg border-b border-border gap-4 flex-wrap max-sm:flex-col max-sm:items-stretch" x-show="dashboard.controlsVisible()">
  <div class="flex items-center gap-1 max-sm:justify-center">
    <button x-for="range in ranges" x-class="rangeBtnClass(range)" @click="setRange(range.id)">{{ range.label }}</button>
    <span class="border-l border-border h-6 mx-2"></span>
    <button id="compare-btn" x-class="compareBtnClass()" @click="toggleComparison()" title="Compare with previous period">
      <Icon name="bar-chart-2" size="14" />
      Compare
    </button>
  </div>
  <div class="flex items-center gap-3 max-sm:justify-between">
    <div class="realtime-badge flex items-center gap-2 py-1.5 px-3 rounded-full text-xs font-medium text-success">
      <span class="pulse"></span>
      <span id="realtime-count">{{ realtimeLabel() }}</span>
    </div>
    <span id="last-updated" class="text-xs text-muted" x-show="lastUpdated()">{{ lastUpdated() }}</span>
    <button id="refresh-btn" x-class="refreshBtnClass()" @click="refresh()" title="Refresh data">
      <Icon name="refresh-cw" size="16" />
    </button>
    <button class="icon-btn" @click="exportData('csv')" title="Export CSV">
      <Icon name="download" size="16" />
    </button>
  </div>
</div>

<style>
.pulse {
  width: 0.5rem;
  height: 0.5rem;
  background-color: var(--success);
  border-radius: 9999px;
  animation: pulse 2s infinite;
}
/* crosswind renders bg-success/10 as SOLID (opacity modifier on a var() color),
   so the green text/dot become invisible. Use a real translucent green. */
.realtime-badge {
  background-color: color-mix(in srgb, var(--success) 14%, transparent);
}
@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1); }
}
.spinning svg {
  animation: spin 0.5s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
</style>
