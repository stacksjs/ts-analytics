<script client>
const dashboard = useStore('dashboard')
const analytics = useStore('analytics')

const lastUpdated = state<string>('')
const isRefreshing = state<boolean>(false)

// Realtime visitor count comes from the shared stats; reflect singular/plural.
function realtimeLabel(): string {
  const n = analytics.stats()?.realtime ?? 0
  return n === 1 ? '1 visitor online' : `${n} visitors online`
}

// Stamp "last updated" whenever fresh stats land.
effect(() => {
  if (analytics.stats()) lastUpdated.set(`Updated ${new Date().toLocaleTimeString()}`)
})

async function refresh(): Promise<void> {
  if (isRefreshing()) return
  isRefreshing.set(true)

  if (window.fetchDashboardData) {
    await window.fetchDashboardData()
  }

  setTimeout(() => {
    isRefreshing.set(false)
  }, 500)
}

function exportData(format: string): void {
  if (window.exportData) {
    window.exportData(format)
  } else {
    const siteId: string | undefined = window.siteId
    if (siteId) {
      navigate(window, true).apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/export?format=${format}`)
    }
  }
}

function refreshBtnClass(): string {
  return isRefreshing() ? 'icon-btn spinning' : 'icon-btn'
}

onMount(() => {
  // Legacy deep-links (?range=7d style bootstrapping via window.dateRange).
  if (window.dateRange) {
    dashboard.dateRange.set(window.dateRange)
  }
})

provide('controlsBar', {
  lastUpdated,
  isRefreshing,
  refresh,
  exportData,
})
</script>

<div id="controls-bar" class="flex justify-between items-center py-3 px-6 bg-bg border-b border-border gap-4 flex-wrap max-sm:flex-col max-sm:items-stretch" x-show="dashboard.controlsVisible()">
  <!-- Left-aligned: refresh at the far left, then the range picker. -->
  <div class="flex items-center justify-start gap-2 mr-auto">
    <button id="refresh-btn" x-class="refreshBtnClass()" @click="refresh()" title="Refresh data">
      <Icon name="refresh-cw" size="16" />
    </button>
    <date-range-picker />
  </div>
  <div class="flex items-center gap-3 max-sm:justify-between">
    <div class="realtime-badge flex items-center gap-2 py-1.5 px-3 rounded-full text-xs font-medium text-success">
      <span class="pulse"></span>
      <span id="realtime-count">{{ realtimeLabel() }}</span>
    </div>
    <span id="last-updated" class="text-xs text-muted" x-show="lastUpdated()">{{ lastUpdated() }}</span>
    <button class="icon-btn" @click="exportData('csv')" title="Export CSV">
      <Icon name="download" size="16" />
    </button>
  </div>
</div>

<style>
.pulse {
  width: 0.5rem;
  height: 0.5rem;
  background-color: var(--success);
  border-radius: 9999px;
  animation: pulse 2s infinite;
}
/* crosswind renders bg-success/10 as SOLID (opacity modifier on a var() color),
   so the green text/dot become invisible. Use a real translucent green. */
.realtime-badge {
  background-color: color-mix(in srgb, var(--success) 14%, transparent);
}
@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1); }
}
.spinning svg {
  animation: spin 0.5s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
</style>
