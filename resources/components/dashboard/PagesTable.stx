<script client>
/**
 * PagesTable Component
 * Displays top pages with entries, visitors, and views
 */

interface Page {
  path: string
  entries?: number
  visitors: number
  views: number
}

interface PagesTableProps {
  pages?: Page[]
  siteHostname?: string | null
  loading?: boolean
}

const pages = state<Page[]>($props.pages || [])
const siteHostname = state<string | null>($props.siteHostname || null)
const loading = state<boolean>($props.loading || false)

// Watch for prop changes
effect(() => {
  if ($props.pages) pages.set($props.pages)
  if ($props.siteHostname !== undefined) siteHostname.set($props.siteHostname)
  if ($props.loading !== undefined) loading.set($props.loading)
})

function getPageUrl(path: string): string | null {
  const host: string | null = siteHostname()
  return host ? `https://${host}${path}` : null
}
</script>

<div class="overflow-x-auto">
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="text-left py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Path</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Entries</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Visitors</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr @if="loading()">
        <td colspan="4" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @if="!loading() && pages().length === 0">
        <td colspan="4" class="text-center text-muted py-4">No page data</td>
      </tr>
      <tr @for="page in pages()" @if="!loading()">
        <td class="cell-name" :title="page.path">
          <a @if="getPageUrl(page.path)"
             x-href="getPageUrl(page.path)"
             target="_blank"
             rel="noopener"
             class="inline-flex items-center gap-1 hover:text-accent">
            {{ page.path }}
            <Icon name="external-link" size="12" class="opacity-50" />
          </a>
          <span @if="!getPageUrl(page.path)">{{ page.path }}</span>
        </td>
        <td class="cell-value">{{ (page.entries ? page.entries : 0) | fmt }}</td>
        <td class="cell-value">{{ (page.visitors ? page.visitors : 0) | fmt }}</td>
        <td class="cell-value">{{ (page.views ? page.views : 0) | fmt }}</td>
      </tr>
    </tbody>
  </table>
</div>
