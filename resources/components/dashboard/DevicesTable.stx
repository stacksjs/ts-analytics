<script client>
import { defineProps, withDefaults } from 'stx'

interface Device {
  type: string
  visitors: number
  percentage?: number
}

interface DevicesTableProps {
  devices?: Device[]
  loading?: boolean
}

const props = withDefaults(defineProps<DevicesTableProps>(), {
  devices: () => [],
  loading: false,
})

const devices = state<Device[]>(props.devices)
const loading = state<boolean>(props.loading)

effect(() => {
  if (props.devices) devices.set(props.devices)
  if (props.loading !== undefined) loading.set(props.loading)
})

const deviceIcons: Record<string, string> = {
  desktop: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  mobile: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  tablet: 'M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
}

function getIconPath(type: string): string {
  return deviceIcons[type?.toLowerCase()] || deviceIcons.desktop
}
</script>

<div class="overflow-x-auto">
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="text-left py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Type</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Visitors</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">%</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="device in devices()" @loading="loading()">
        <td class="cell-name flex items-center gap-1.5">
          <svg class="text-muted shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="getIconPath(device.type)" />
          </svg>
          {{ device.type }}
        </td>
        <td class="cell-value">{{ (device.visitors ? device.visitors : 0) | fmt }}</td>
        <td class="cell-value">{{ device.percentage ? device.percentage : 0 }}%</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No device data</td>
      </tr>
    </tbody>
  </table>
</div>
