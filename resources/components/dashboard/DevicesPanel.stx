<script client>
/**
 * DevicesPanel Component
 * Displays device breakdown with reactive data fetching
 */
const dashboard = useStore('dashboard')
const analytics = useStore('analytics')

const deviceIcons = {
  desktop: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  mobile: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  tablet: 'M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
}

function getIconPath(type) {
  return deviceIcons[type?.toLowerCase()] || deviceIcons.desktop
}

function fmt(n) {
  if (n === undefined || n === null) return '0'
  return n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${(n / 1e3).toFixed(1)}k` : String(n)
}

function capitalize(s) {
  const str = s || ''
  return str.charAt(0).toUpperCase() + str.slice(1)
}

onMount(() => {
  if (dashboard.siteId()) analytics.fetchSection('devices')
  window.refreshDevicesPanel = () => analytics.fetchSection('devices')
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="monitor" size="16" class="text-muted" />
      Devices
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('devices')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Type</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">%</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="device in analytics.devices" @loading="analytics.loading()">
        <td class="cell-name flex items-center gap-1.5">
          <svg class="text-muted shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="getIconPath(device.type)"/>
          </svg>
          <span>{{ capitalize(device.type ? device.type : 'Unknown') }}</span>
        </td>
        <td class="cell-value">{{ fmt(device.visitors) }}</td>
        <td class="cell-value">{{ (device.percentage ? device.percentage : 0) + '%' }}</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No device data</td>
      </tr>
    </tbody>
  </table>
</div>
