<script client>
const analytics = useStore('analytics')
const dashboard = useStore('dashboard')

// Goals data is shared via the analytics store; loading stays panel-local so the
// table doesn't flicker when other panels fetch.
const goals = analytics.goals
const loading = state<boolean>(true)

function formatCurrency(n: number): string {
  return `$${(n || 0).toFixed(2)}`
}

function getTypeBadgeClass(type: string): string {
  const classes: Record<string, string> = {
    pageview: 'badge type-badge-pageview',
    event: 'badge type-badge-event',
    duration: 'badge type-badge-duration',
    scroll: 'badge type-badge-scroll',
  }
  return classes[type?.toLowerCase()] || 'badge'
}

async function loadGoals(): Promise<void> {
  loading.set(true)
  await analytics.fetchSection('goals')
  loading.set(false)
}

function editGoal(goalId: string): void {
  if (window.goalModal) {
    window.goalModal.openEdit(goalId)
  }
}

function deleteGoal(goalId: string): void {
  if (window.Modal) {
    window.Modal.confirm('Delete this goal? Conversion data will be preserved.', async () => {
      try {
        const res: Response = await fetch(dashboard.apiUrl(`/goals/${goalId}`), { method: 'DELETE' })
        if (res.ok) loadGoals()
      } catch (err: unknown) {
        console.error('Delete goal error:', err)
      }
    })
  }
}

function openCreateGoal(): void {
  if (window.goalModal) {
    window.goalModal.openCreate()
  }
}

onMount(() => {
  if (dashboard.siteId()) loadGoals()
})

window.refreshGoalsPanel = loadGoals
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="check-circle" size="16" class="text-muted" />
      Goals
    </div>
    <button class="btn btn-primary text-xs py-1.5 px-3" @click="openCreateGoal()">+ Add Goal</button>
  </div>

  <div x-show="loading()" class="empty-state text-[0.8125rem]">Loading...</div>

  <div x-show="!loading() && goals().length === 0" class="empty-state text-[0.8125rem]">
    <p>No goals configured yet.</p>
    <p class="text-xs mt-2 opacity-80">Click "+ Add Goal" to create your first conversion goal.</p>
  </div>

  <table x-show="!loading() && goals().length > 0" class="w-full border-collapse text-[0.8125rem]">
    <thead>
      <tr>
        <th class="text-left py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Goal</th>
        <th class="text-left py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Type</th>
        <th class="text-right py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Conversions</th>
        <th class="text-right py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Value</th>
        <th class="text-right py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Actions</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="goal in goals()" class="goal-row">
        <td class="font-medium">{{ goal.name }}</td>
        <td>
          <span x-class="getTypeBadgeClass(goal.type)">{{ goal.type }}</span>
        </td>
        <td class="text-right tabular-nums">{{ (goal.conversions ? goal.conversions : 0) | fmt }}</td>
        <td class="text-right tabular-nums">
          <span x-show="goal.value">{{ formatCurrency(goal.value) }}</span>
          <span x-show="!goal.value">-</span>
        </td>
        <td class="text-right whitespace-nowrap">
          <button class="icon-btn" title="Edit" @click="editGoal(goal.id)">
            <Icon name="edit" size="14" />
          </button>
          <button class="icon-btn icon-btn-danger" title="Delete" @click="deleteGoal(goal.id)">
            <Icon name="trash-2" size="14" />
          </button>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<style>
.type-badge-pageview { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.type-badge-event { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
.type-badge-duration { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
.type-badge-scroll { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
.icon-btn-danger:hover {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}
</style>
