<script client>
/**
 * StatsRow Component
 *
 * Static card layout (realtime, sessions, visitors, ...). The card values are
 * bound reactively to the shared analytics store and counted up to their new
 * targets, rather than poked into the DOM by id.
 */
interface Stat {
  id: string
  label: string
  icon: string
  highlight?: boolean
}

const stats: Stat[] = [
  {
    id: 'realtime',
    label: 'Realtime',
    icon: 'M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41',
    highlight: true,
  },
  {
    id: 'sessions',
    label: 'Sessions',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    id: 'people',
    label: 'Visitors',
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  },
  {
    id: 'views',
    label: 'Pageviews',
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  },
  {
    id: 'avgtime',
    label: 'Avg Time',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    id: 'bounce',
    label: 'Bounce Rate',
    icon: 'M13 17h8m0 0V9m0 8l-8-8-4 4-6-6',
  },
]

const analytics = useStore('analytics')
const dashboard = useStore('dashboard')

// Compare-mode deltas (#153): map each card to its /comparison field.
const CHANGE_FIELDS: Record<string, string> = {
  sessions: 'sessions',
  people: 'visitors',
  views: 'views',
  bounce: 'bounceRate',
  avgtime: 'avgDuration',
}

function statChange(id: string): string {
  const cmp = analytics.comparison()
  const field = CHANGE_FIELDS[id]
  if (!cmp || !field || !dashboard.showComparison()) return ''
  const change = cmp.changes?.[field]
  if (change === undefined || change === null) return ''
  if (cmp.previous?.[field] === 0 && cmp.current?.[field] > 0) return 'new'
  return `${change > 0 ? '+' : ''}${change}%`
}

function statChangeClass(id: string): string {
  const cmp = analytics.comparison()
  const field = CHANGE_FIELDS[id]
  const change = cmp?.changes?.[field] ?? 0
  // For bounce rate, up is bad.
  const good = id === 'bounce' ? change < 0 : change > 0
  const base = 'text-[0.6875rem] font-medium mt-0.5'
  if (change === 0) return `${base} text-muted`
  return good ? `${base} text-success` : `${base} text-error`
}

// Reactive values the cards display. Animated toward the store's stats so the
// numbers count up on each update.
const display = state({ realtime: 0, sessions: 0, people: 0, views: 0, bounceRate: 0, avgTime: '00:00' })

// Untracked snapshot of the values currently shown, used as the animation start
// point. Kept outside the reactive graph so tweening it never re-triggers the
// effect that watches the store.
let current = { realtime: 0, sessions: 0, people: 0, views: 0, bounceRate: 0 }
let primed = false
let raf = 0

function fmtCompact(n) {
  const num = typeof n === 'number' ? n : Number(n) || 0
  return num >= 1000 ? `${(num / 1000).toFixed(1)}k` : String(num)
}

function cardClass(stat) {
  return stat.highlight ? 'stat-card text-center highlight' : 'stat-card text-center'
}

function statValue(id) {
  const d = display()
  if (id === 'avgtime')
    return d.avgTime || '—'
  if (id === 'bounce')
    return `${d.bounceRate ?? 0}%`
  return fmtCompact(d[id] ?? 0)
}

// Count the displayed numbers up to `target` over ~600ms with an ease-out curve.
// The first application paints instantly (preserves the cache-seeded instant
// paint on load); subsequent updates animate.
function applyStats(target) {
  const next = {
    realtime: target.realtime || 0,
    sessions: target.sessions || 0,
    people: target.people || 0,
    views: target.views || 0,
    bounceRate: target.bounceRate || 0,
  }

  if (!primed) {
    primed = true
    current = next
    display.set({ ...next, avgTime: target.avgTime || '00:00' })
    return
  }

  const from = { ...current }
  const start = performance.now()
  const duration = 600
  cancelAnimationFrame(raf)

  function tick(now) {
    const progress = Math.min((now - start) / duration, 1)
    const ease = 1 - (1 - progress) ** 3
    const frame = {
      realtime: Math.round(from.realtime + (next.realtime - from.realtime) * ease),
      sessions: Math.round(from.sessions + (next.sessions - from.sessions) * ease),
      people: Math.round(from.people + (next.people - from.people) * ease),
      views: Math.round(from.views + (next.views - from.views) * ease),
      bounceRate: Math.round(from.bounceRate + (next.bounceRate - from.bounceRate) * ease),
    }
    current = frame
    display.set({ ...frame, avgTime: target.avgTime || '00:00' })
    if (progress < 1)
      raf = requestAnimationFrame(tick)
  }
  raf = requestAnimationFrame(tick)
}

// Re-run whenever the store's stats change (cache hydrate, fetch, poll).
effect(() => {
  const s = analytics.stats()
  if (s)
    applyStats(s)
})

// Fetch/clear the headline comparison when the toggle or range changes (#153).
effect(() => {
  dashboard.showComparison()
  dashboard.dateRange()
  analytics.fetchComparison()
})

onMount(() => {
  analytics.hydrateStatsFromCache()
  analytics.fetchStats()
  const poll = setInterval(() => analytics.fetchStats(), 15000)
  return () => {
    clearInterval(poll)
    cancelAnimationFrame(raf)
  }
})
</script>

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 p-6">
  <div x-for="stat in stats" x-class="cardClass(stat)">
    <svg class="text-muted mb-2 mx-auto" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <circle x-show="stat.id === 'realtime'" cx="12" cy="12" r="3"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="stat.icon"/>
    </svg>
    <div class="text-2xl font-bold text-text leading-tight" x-text="statValue(stat.id)">—</div>
    <div class="text-xs text-text-2 mt-1 uppercase tracking-wide">{{ stat.label }}</div>
    <div x-show="statChange(stat.id) !== ''" x-class="statChangeClass(stat.id)">{{ statChange(stat.id) }}</div>
  </div>
</div>

<style>
/* Highlight variant - gradient background can't be expressed as a utility */
.highlight {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%);
  border-color: transparent;
}
.highlight .text-text,
.highlight .text-text-2,
.highlight .text-muted {
  color: white;
}

/* Hover lift effect */
.stat-card:hover {
  transform: translateY(-1px);
}
</style>
