<script client>
/**
 * CountriesPanel Component
 * Displays country breakdown with reactive data fetching
 */
const dashboard = useStore('dashboard')

const countries = state([])
const loading = state(true)

const countryFlags = {
  'United States': '🇺🇸', 'United Kingdom': '🇬🇧', 'Germany': '🇩🇪', 'France': '🇫🇷',
  'Canada': '🇨🇦', 'Australia': '🇦🇺', 'Japan': '🇯🇵', 'China': '🇨🇳',
  'India': '🇮🇳', 'Brazil': '🇧🇷', 'Netherlands': '🇳🇱', 'Spain': '🇪🇸',
  'Italy': '🇮🇹', 'Russia': '🇷🇺', 'South Korea': '🇰🇷', 'Mexico': '🇲🇽',
  'Indonesia': '🇮🇩', 'Poland': '🇵🇱', 'Sweden': '🇸🇪', 'Switzerland': '🇨🇭',
  'Argentina': '🇦🇷', 'Belgium': '🇧🇪', 'Austria': '🇦🇹', 'Norway': '🇳🇴',
  'Denmark': '🇩🇰', 'Finland': '🇫🇮', 'Ireland': '🇮🇪', 'New Zealand': '🇳🇿',
  'Portugal': '🇵🇹', 'Singapore': '🇸🇬', 'Hong Kong': '🇭🇰', 'Taiwan': '🇹🇼',
  'Thailand': '🇹🇭', 'Vietnam': '🇻🇳', 'Malaysia': '🇲🇾', 'Philippines': '🇵🇭',
  'South Africa': '🇿🇦', 'Turkey': '🇹🇷', 'Israel': '🇮🇱', 'UAE': '🇦🇪'
}

function getFlag(name) {
  return countryFlags[name] || '🌍'
}

async function fetchCountries() {
  if (!dashboard.siteId()) {
    loading.set(false)
    return
  }
  try {
    const res = await fetch(dashboard.apiUrlWithDates('/countries'))
    const data = await res.json()
    countries.set((data.countries || []).slice(0, 10))
  } catch (e) {
    console.error('Failed to fetch countries:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (dashboard.siteId()) fetchCountries()
  window.refreshCountriesPanel = fetchCountries
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="globe" size="16" class="text-muted" />
      Countries
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('countries')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Country</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
      </tr>
    </thead>
    <tbody>
      <tr @for="country in countries()" @loading="loading()" @if="!loading()">
        <td class="cell-name flex items-center gap-1.5">
          <span class="text-base">{{ getFlag(country.name ? country.name : country.code) }}</span>
          {{ country.name ? country.name : (country.code ? country.code : 'Unknown') }}
        </td>
        <td class="cell-value">{{ country.visitors | fmt }}</td>
      </tr>
      <tr @for-loading>
        <td colspan="2" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="2" class="text-center text-muted py-4">No location data</td>
      </tr>
    </tbody>
  </table>
</div>

