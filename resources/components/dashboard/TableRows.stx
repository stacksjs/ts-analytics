{{-- TableRows Component --}}
{{-- Provides row rendering for all dashboard tables --}}

{{-- Props: type ('pages' | 'referrers' | 'devices' | 'browsers' | 'countries' | 'campaigns') --}}
{{-- Props: data (array of items to display) --}}
{{-- Props: loading (boolean) --}}

@ts
function getFlag(name: string): string {
  const flags: Record<string, string> = {
    'United States': '🇺🇸', 'United Kingdom': '🇬🇧', 'Germany': '🇩🇪', 'France': '🇫🇷',
    'Canada': '🇨🇦', 'Australia': '🇦🇺', 'Japan': '🇯🇵', 'China': '🇨🇳',
    'India': '🇮🇳', 'Brazil': '🇧🇷', 'Netherlands': '🇳🇱', 'Spain': '🇪🇸',
    'Italy': '🇮🇹', 'Russia': '🇷🇺', 'South Korea': '🇰🇷', 'Mexico': '🇲🇽',
    'Indonesia': '🇮🇩', 'Poland': '🇵🇱', 'Sweden': '🇸🇪', 'Switzerland': '🇨🇭'
  }
  return flags[name] || '🌍'
}

function getDomain(source: string): string {
  return source.replace(/^https?:\/\//, '').split('/')[0]
}

function isExternalLink(source: string): boolean {
  const lower = source.toLowerCase()
  return lower !== 'direct' && !source.includes('(') && source.includes('.')
}
@endts

{{-- Pages Table Body --}}
<template id="pages-table-component">
  @if(loading)
    <tr><td colspan="4" class="text-center text-muted p-4">Loading...</td></tr>
  @elseif(pages.length === 0)
    <tr><td colspan="4" class="text-center text-muted p-4">No page data</td></tr>
  @else
    @foreach(pages as page)
      <tr>
        <td class="font-medium text-text max-w-[200px] truncate" title="{{ page.path }}">
          <a href="{{ page.path }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 no-underline text-inherit hover:text-accent">
            {{ page.path }}
            <Icon name="external-link" size="10" class="opacity-50" />
          </a>
        </td>
        <td class="text-right tabular-nums text-text">{{ (page.entries ? page.entries : 0) | fmt }}</td>
        <td class="text-right tabular-nums text-text">{{ (page.visitors ? page.visitors : 0) | fmt }}</td>
        <td class="text-right tabular-nums text-text">{{ (page.views ? page.views : 0) | fmt }}</td>
      </tr>
    @endforeach
  @endif
</template>

{{-- Referrers Table Body --}}
<template id="referrers-table-component">
  @if(loading)
    <tr><td colspan="3" class="text-center text-muted p-4">Loading...</td></tr>
  @elseif(referrers.length === 0)
    <tr><td colspan="3" class="text-center text-muted p-4">No referrer data</td></tr>
  @else
    @foreach(referrers as ref)
      <tr>
        <td class="font-medium text-text max-w-[200px] truncate">
          @if(isExternalLink(ref.source ? ref.source : 'Direct'))
            <a href="{{ ref.source.startsWith('http') ? ref.source : 'https://' + ref.source }}"
               target="_blank" rel="noopener" class="inline-flex items-center gap-1 no-underline text-inherit hover:text-accent">
              <img src="https://www.google.com/s2/favicons?domain={{ getDomain(ref.source) }}&sz=16"
                   width="14" height="14" class="w-3.5 h-3.5 align-middle rounded-sm" onerror="this.style.display='none'" />
              {{ ref.source ? ref.source : 'Direct' }}
              <Icon name="external-link" size="10" class="opacity-50" />
            </a>
          @else
            {{ ref.source ? ref.source : 'Direct' }}
          @endif
        </td>
        <td class="text-right tabular-nums text-text">{{ (ref.visitors ? ref.visitors : 0) | fmt }}</td>
        <td class="text-right tabular-nums text-text">{{ (ref.views ? ref.views : 0) | fmt }}</td>
      </tr>
    @endforeach
  @endif
</template>

{{-- Devices Table Body --}}
<template id="devices-table-component">
  @if(loading)
    <tr><td colspan="3" class="text-center text-muted p-4">Loading...</td></tr>
  @elseif(devices.length === 0)
    <tr><td colspan="3" class="text-center text-muted p-4">No device data</td></tr>
  @else
    @foreach(devices as device)
      <tr>
        <td class="font-medium text-text max-w-[200px] truncate">
          @if(device.type?.toLowerCase() === 'mobile')
            <Icon name="smartphone" size="14" class="text-muted flex-shrink-0 mr-1.5 inline" />
          @elseif(device.type?.toLowerCase() === 'tablet')
            <Icon name="tablet" size="14" class="text-muted flex-shrink-0 mr-1.5 inline" />
          @else
            <Icon name="monitor" size="14" class="text-muted flex-shrink-0 mr-1.5 inline" />
          @endif
          {{ device.type ? device.type : 'Unknown' }}
        </td>
        <td class="text-right tabular-nums text-text">{{ (device.visitors ? device.visitors : 0) | fmt }}</td>
        <td class="text-right tabular-nums text-text">{{ device.percentage ? device.percentage : 0 }}%</td>
      </tr>
    @endforeach
  @endif
</template>

{{-- Browsers Table Body --}}
<template id="browsers-table-component">
  @if(loading)
    <tr><td colspan="3" class="text-center text-muted p-4">Loading...</td></tr>
  @elseif(browsers.length === 0)
    <tr><td colspan="3" class="text-center text-muted p-4">No browser data</td></tr>
  @else
    @foreach(browsers as browser)
      <tr>
        <td class="font-medium text-text max-w-[200px] truncate">{{ browser.name ? browser.name : 'Unknown' }}</td>
        <td class="text-right tabular-nums text-text">{{ (browser.visitors ? browser.visitors : 0) | fmt }}</td>
        <td class="text-right tabular-nums text-text">{{ browser.percentage ? browser.percentage : 0 }}%</td>
      </tr>
    @endforeach
  @endif
</template>

{{-- Countries Table Body --}}
<template id="countries-table-component">
  @if(loading)
    <tr><td colspan="2" class="text-center text-muted p-4">Loading...</td></tr>
  @elseif(countries.length === 0)
    <tr><td colspan="2" class="text-center text-muted p-4">No location data</td></tr>
  @else
    @foreach(countries as country)
      <tr>
        <td class="font-medium text-text max-w-[200px] truncate">
          <span class="mr-1.5">{{ getFlag(country.name ? country.name : country.code) }}</span>
          {{ country.name ? country.name : (country.code ? country.code : 'Unknown') }}
        </td>
        <td class="text-right tabular-nums text-text">{{ (country.visitors ? country.visitors : 0) | fmt }}</td>
      </tr>
    @endforeach
  @endif
</template>

{{-- Campaigns Table Body --}}
<template id="campaigns-table-component">
  @if(loading)
    <tr><td colspan="3" class="text-center text-muted p-4">Loading...</td></tr>
  @elseif(campaigns.length === 0)
    <tr><td colspan="3" class="text-center text-muted p-4">No campaign data</td></tr>
  @else
    @foreach(campaigns as campaign)
      <tr>
        <td class="font-medium text-text max-w-[200px] truncate">{{ campaign.name ? campaign.name : (campaign.source ? campaign.source : 'Unknown') }}</td>
        <td class="text-right tabular-nums text-text">{{ (campaign.visitors ? campaign.visitors : 0) | fmt }}</td>
        <td class="text-right tabular-nums text-text">{{ (campaign.views ? campaign.views : 0) | fmt }}</td>
      </tr>
    @endforeach
  @endif
</template>

<style>
/* Hover effect on link icons - requires parent hover pseudo-selector */
a:hover svg { opacity: 1; }
</style>
