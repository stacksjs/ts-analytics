<script client>
/**
 * PagesPanel Component
 * Displays top pages with reactive data fetching
 */
const dashboard = useStore('dashboard')
const analytics = useStore('analytics')

function fmt(n) {
  if (n === undefined || n === null) return '0'
  return n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${(n / 1e3).toFixed(1)}k` : String(n)
}

onMount(() => {
  if (dashboard.siteId()) analytics.fetchSection('pages')
  window.refreshPagesPanel = () => analytics.fetchSection('pages')
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="file-text" size="16" class="text-muted" />
      Top Pages
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('pages')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Path</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Entries</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="page in analytics.pages" @loading="analytics.loading()">
        <td class="cell-name" :title="page.path">
          <a x-href="page.path" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-accent">
            <span x-text="page.path"></span>
            <Icon name="external-link" size="10" class="opacity-50" />
          </a>
        </td>
        <td class="cell-value" x-text="fmt(page.entries)"></td>
        <td class="cell-value" x-text="fmt(page.visitors)"></td>
        <td class="cell-value" x-text="fmt(page.views)"></td>
      </tr>
      <tr @for-loading>
        <td colspan="4" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="4" class="text-center text-muted py-4">No page data</td>
      </tr>
    </tbody>
  </table>
</div>
