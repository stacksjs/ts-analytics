<script client>
import type { NavTab } from '../../types/dashboard'

// Resolve the initial theme synchronously (stored preference, else OS setting)
// so the data-theme effect paints the right theme on first run — no flash.
function preferredDark(): boolean {
  const stored: string | null = localStorage.getItem('ts-analytics-theme')
  if (stored) return stored === 'dark'
  return !window.matchMedia('(prefers-color-scheme: light)').matches
}

const dashboard = useStore('dashboard')

const siteName = state<string>('Analytics Dashboard')
const isDark = state<boolean>(preferredDark())
const siteId = state<string>('')

// Signed-in identity (#115): the layout's session gate stashes the user on
// window and broadcasts tsa:user — cover both orders (gate may resolve
// before or after this component mounts).
const userEmail = state<string>('')

function adoptUser(u: { email?: string } | undefined): void {
  if (u && u.email) userEmail.set(u.email)
}

// Document titles per tab (mirrors the controller's old tabTitles map).
const TAB_TITLES: Record<string, string> = {
  dashboard: 'Dashboard',
  live: 'Live View',
  sessions: 'Sessions',
  funnels: 'Funnels',
  flow: 'User Flow',
  vitals: 'Web Vitals',
  errors: 'Errors',
  insights: 'Insights',
  settings: 'Settings',
}

const tabs: NavTab[] = [
  { id: 'dashboard', label: 'Dashboard', href: '/dashboard' },
  { id: 'live', label: 'Live', href: '/dashboard/live' },
  { id: 'sessions', label: 'Sessions', href: '/dashboard/sessions' },
  { id: 'funnels', label: 'Funnels', href: '/dashboard/funnels' },
  { id: 'flow', label: 'User Flow', href: '/dashboard/flow' },
  { id: 'clicks', label: 'Link Clicks', href: '/dashboard/clicks' },
  { id: 'engagement', label: 'Engagement', href: '/dashboard/engagement' },
  { id: 'event-properties', label: 'Event Properties', href: '/dashboard/event-properties' },
  { id: 'vitals', label: 'Web Vitals', href: '/dashboard/vitals' },
  { id: 'errors', label: 'Errors', href: '/dashboard/errors' },
  { id: 'insights', label: 'Insights', href: '/dashboard/insights' },
]

function detectCurrentTab(): string {
  const path: string = window.location.pathname
  if (path === '/dashboard' || path === '/') return 'dashboard'
  const match: RegExpMatchArray | null = path.match(/\/dashboard\/([^/]+)/)
  return match ? match[1] : 'dashboard'
}

function toggleTheme(): void {
  isDark.update((v: boolean) => !v)
  localStorage.setItem('ts-analytics-theme', isDark() ? 'dark' : 'light')
  // The data-theme effect repaints; ChartSection redraws via its data-theme observer.
}

// Named handleBack (not goBack) to avoid shadowing stx's injected goBack global.
function handleBack(): void {
  // Clear the source-of-truth siteId so store-bound components reset; the
  // controller still handles shell visibility + history.
  dashboard.siteId.set('')
  if (window.goBack) {
    window.goBack()
  } else {
    navigate('/', true)
  }
}

function tabHref(tab: NavTab): string {
  const sid: string = siteId()
  return tab.href + (sid ? `?siteId=${encodeURIComponent(sid)}` : '')
}

function tabClass(tab: NavTab): string {
  const base = 'text-text-2 py-2 px-3 rounded-md text-[0.8125rem] font-medium transition-all duration-150 hover:bg-bg-3 hover:text-text no-underline'
  return dashboard.currentTab() === tab.id ? `${base} bg-accent text-white` : base
}

effect(() => {
  document.documentElement.setAttribute('data-theme', isDark() ? 'dark' : 'light')
})

// Keep the document title in sync with the active tab.
effect(() => {
  document.title = `${TAB_TITLES[dashboard.currentTab()] || 'Dashboard'} - Analytics`
})

onMount(() => {
  siteId.set(new URLSearchParams(window.location.search).get('siteId') || '')
  dashboard.currentTab.set(detectCurrentTab())

  adoptUser((window as { CURRENT_USER?: { email?: string } }).CURRENT_USER)
  document.addEventListener('tsa:user', (e: Event) => adoptUser((e as CustomEvent).detail))

  window.headerSetSiteName = (name: string) => siteName.set(name || 'Analytics Dashboard')
  window.dashboardHeader = {
    toggleTheme,
    goBack: handleBack,
    isDarkTheme: () => isDark(),
  }

  // Sync the active tab + siteId from the URL after SPA navigation or history nav.
  const syncFromUrl = (): void => {
    const urlSiteId = new URLSearchParams(window.location.search).get('siteId') || ''
    dashboard.currentTab.set(detectCurrentTab())
    dashboard.siteId.set(urlSiteId)
    siteId.set(urlSiteId)
  }
  window.addEventListener('stx:navigate', syncFromUrl)
  window.addEventListener('popstate', syncFromUrl)

  return () => {
    window.removeEventListener('stx:navigate', syncFromUrl)
    window.removeEventListener('popstate', syncFromUrl)
  }
})

provide('dashboardHeader', {
  siteName,
  isDark,
  currentTab: dashboard.currentTab,
  siteId,
  toggleTheme,
  goBack: handleBack,
})
</script>

<header class="flex items-center justify-between py-3 px-6 bg-bg-2 border-b border-border gap-4">
  <div class="flex items-center gap-3">
    <button class="icon-btn" @click="handleBack()" title="Back to sites">
      <Icon name="chevron-left" size="20" />
    </button>
    <span id="current-site-name" class="font-semibold text-base text-text">{{ siteName() }}</span>
  </div>

  <nav id="header-nav" class="header-nav flex gap-1 flex-wrap justify-center">
    <a x-for="tab in tabs"
       x-class="tabClass(tab)"
       x-href="tabHref(tab)"
       x-data-tab="tab.id"
       data-stx-prefetch
       x-text="tab.label"></a>
  </nav>

  <div class="flex items-center gap-2">
    <a x-href="'/dashboard/settings' + (siteId() ? '?siteId=' + encodeURIComponent(siteId()) : '')"
       x-class="dashboard.currentTab() === 'settings' ? 'icon-btn text-accent' : 'icon-btn'"
       title="Project settings"
       data-stx-prefetch>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
    </a>
    <button id="theme-toggle" class="icon-btn" @click="toggleTheme()" title="Toggle dark/light mode">
      <Icon name="moon" size="20" id="moon-icon" x-show="isDark()" />
      <Icon name="sun" size="20" id="sun-icon" x-show="!isDark()" />
    </button>
    <a x-href="'/dashboard/account' + (siteId() ? '?siteId=' + encodeURIComponent(siteId()) : '')" x-show="userEmail()" class="flex items-center gap-1.5 icon-btn no-underline" title="Account settings" data-stx-prefetch>
      <Icon name="user" size="18" />
      <span class="text-xs text-muted max-w-[160px] truncate hidden md:inline" x-text="userEmail()"></span>
    </a>
    <form method="POST" action="/logout" class="inline">
      <button type="submit" class="icon-btn hover:text-error" title="Logout">
        <Icon name="log-out" size="20" />
      </button>
    </form>
  </div>
</header>

<style>
@media (max-width: 1200px) {
  header {
    flex-wrap: wrap;
  }
  .header-nav {
    order: 3;
    width: 100%;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .header-nav::-webkit-scrollbar {
    display: none;
  }
}
</style>
