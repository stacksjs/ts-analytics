<script client>
import type { NavTab } from '../../types/dashboard'

// Resolve the initial theme synchronously (stored preference, else OS setting)
// so the data-theme effect paints the right theme on first run — no flash.
function preferredDark(): boolean {
  const stored: string | null = localStorage.getItem('ts-analytics-theme')
  if (stored) return stored === 'dark'
  return !window.matchMedia('(prefers-color-scheme: light)').matches
}

const dashboard = useStore('dashboard')

const siteName = state<string>('Analytics Dashboard')
const isDark = state<boolean>(preferredDark())
const currentTab = state<string>('dashboard')
const siteId = state<string>('')

const tabs: NavTab[] = [
  { id: 'dashboard', label: 'Dashboard', href: '/dashboard' },
  { id: 'live', label: 'Live', href: '/dashboard/live' },
  { id: 'sessions', label: 'Sessions', href: '/dashboard/sessions' },
  { id: 'funnels', label: 'Funnels', href: '/dashboard/funnels' },
  { id: 'flow', label: 'User Flow', href: '/dashboard/flow' },
  { id: 'vitals', label: 'Web Vitals', href: '/dashboard/vitals' },
  { id: 'errors', label: 'Errors', href: '/dashboard/errors' },
  { id: 'insights', label: 'Insights', href: '/dashboard/insights' },
  { id: 'settings', label: 'Settings', href: '/dashboard/settings' },
]

function detectCurrentTab(): string {
  const path: string = window.location.pathname
  if (path === '/dashboard' || path === '/') return 'dashboard'
  const match: RegExpMatchArray | null = path.match(/\/dashboard\/([^/]+)/)
  return match ? match[1] : 'dashboard'
}

function toggleTheme(): void {
  isDark.update((v: boolean) => !v)
  localStorage.setItem('ts-analytics-theme', isDark() ? 'dark' : 'light')
  // The data-theme effect repaints; ChartSection redraws via its data-theme observer.
}

function goBack(): void {
  // Clear the source-of-truth siteId so store-bound components reset; the
  // controller still handles shell visibility + history.
  dashboard.siteId.set('')
  if (window.goBack) {
    window.goBack()
  } else {
    navigate('/', true)
  }
}

function tabHref(tab: NavTab): string {
  const sid: string = siteId()
  return tab.href + (sid ? `?siteId=${encodeURIComponent(sid)}` : '')
}

function tabClass(tab: NavTab): string {
  const base = 'text-text-2 py-2 px-3 rounded-md text-[0.8125rem] font-medium transition-all duration-150 hover:bg-bg-3 hover:text-text no-underline'
  return currentTab() === tab.id ? `${base} bg-accent text-white` : base
}

effect(() => {
  document.documentElement.setAttribute('data-theme', isDark() ? 'dark' : 'light')
})

onMount(() => {
  siteId.set(new URLSearchParams(window.location.search).get('siteId') || '')
  currentTab.set(detectCurrentTab())

  window.headerSetSiteName = (name: string) => siteName.set(name || 'Analytics Dashboard')
  window.dashboardHeader = {
    toggleTheme,
    goBack,
    isDarkTheme: () => isDark(),
  }

  const onNavigate = (): void => {
    currentTab.set(detectCurrentTab())
    siteId.set(new URLSearchParams(window.location.search).get('siteId') || '')
  }
  window.addEventListener('stx:navigate', onNavigate)

  return () => {
    window.removeEventListener('stx:navigate', onNavigate)
  }
})

provide('dashboardHeader', {
  siteName,
  isDark,
  currentTab,
  siteId,
  toggleTheme,
  goBack,
})
</script>

<header class="flex items-center justify-between py-3 px-6 bg-bg-2 border-b border-border gap-4">
  <div class="flex items-center gap-3">
    <button class="icon-btn" @click="goBack()" title="Back to sites">
      <Icon name="chevron-left" size="20" />
    </button>
    <span id="current-site-name" class="font-semibold text-base text-text">{{ siteName() }}</span>
  </div>

  <nav id="header-nav" class="header-nav flex gap-1 flex-wrap justify-center">
    <a x-for="tab in tabs"
       x-class="tabClass(tab)"
       x-href="tabHref(tab)"
       x-data-tab="tab.id"
       data-stx-prefetch>{{ tab.label }}</a>
  </nav>

  <div class="flex items-center gap-2">
    <button id="theme-toggle" class="icon-btn" @click="toggleTheme()" title="Toggle dark/light mode">
      <Icon name="moon" size="20" id="moon-icon" x-show="isDark()" />
      <Icon name="sun" size="20" id="sun-icon" x-show="!isDark()" />
    </button>
    <form method="POST" action="/logout" class="inline">
      <button type="submit" class="icon-btn hover:text-error" title="Logout">
        <Icon name="log-out" size="20" />
      </button>
    </form>
  </div>
</header>

<style>
@media (max-width: 1200px) {
  header {
    flex-wrap: wrap;
  }
  .header-nav {
    order: 3;
    width: 100%;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .header-nav::-webkit-scrollbar {
    display: none;
  }
}
</style>
