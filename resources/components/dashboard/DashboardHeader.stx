<script client>
import type { NavTab } from '../../types/dashboard'

// Resolve the initial theme synchronously (stored preference, else OS setting)
// so the data-theme effect paints the right theme on first run — no flash.
function preferredDark(): boolean {
  const stored: string | null = localStorage.getItem('ts-analytics-theme')
  if (stored) return stored === 'dark'
  return !window.matchMedia('(prefers-color-scheme: light)').matches
}

const dashboard = useStore('dashboard')

const siteName = state<string>('Analytics Dashboard')
const isDark = state<boolean>(preferredDark())
const siteId = state<string>('')

// Signed-in identity (#115): the layout's session gate stashes the user on
// window and broadcasts tsa:user — cover both orders (gate may resolve
// before or after this component mounts).
const userEmail = state<string>('')

function adoptUser(u: { email?: string } | undefined): void {
  if (u && u.email) userEmail.set(u.email)
}

// Document titles per tab (mirrors the controller's old tabTitles map).
const TAB_TITLES: Record<string, string> = {
  dashboard: 'Dashboard',
  live: 'Live View',
  sessions: 'Sessions',
  funnels: 'Funnels',
  flow: 'User Flow',
  vitals: 'Web Vitals',
  insights: 'Insights',
  settings: 'Settings',
  account: 'Account',
}

const tabs: NavTab[] = [
  { id: 'dashboard', label: 'Dashboard', href: '/dashboard' },
  { id: 'live', label: 'Live', href: '/dashboard/live' },
  { id: 'sessions', label: 'Sessions', href: '/dashboard/sessions' },
  { id: 'funnels', label: 'Funnels', href: '/dashboard/funnels' },
  { id: 'flow', label: 'User Flow', href: '/dashboard/flow' },
  { id: 'clicks', label: 'Link Clicks', href: '/dashboard/clicks' },
  { id: 'engagement', label: 'Engagement', href: '/dashboard/engagement' },
  { id: 'event-properties', label: 'Event Properties', href: '/dashboard/event-properties' },
  { id: 'vitals', label: 'Web Vitals', href: '/dashboard/vitals' },
  { id: 'insights', label: 'Insights', href: '/dashboard/insights' },
]

function detectCurrentTab(): string {
  const path: string = window.location.pathname
  if (path === '/dashboard' || path === '/') return 'dashboard'
  const match: RegExpMatchArray | null = path.match(/\/dashboard\/([^/]+)/)
  return match ? match[1] : 'dashboard'
}

function toggleTheme(): void {
  isDark.update((v: boolean) => !v)
  localStorage.setItem('ts-analytics-theme', isDark() ? 'dark' : 'light')
  // The data-theme effect repaints; ChartSection redraws via its data-theme observer.
}

// Avatar dropdown: identity, theme switcher, account, sign out.
const userMenuOpen = state<boolean>(false)

// Named handler — an arrow function inside the @click attribute ('v => !v')
// contains '>' which stx's tag parser treats as the tag terminator, silently
// truncating the attribute; every other handler in the codebase is a plain
// call for the same reason.
function toggleUserMenu(): void {
  userMenuOpen.update((v: boolean) => !v)
}

function setTheme(dark: boolean): void {
  isDark.set(dark)
  localStorage.setItem('ts-analytics-theme', dark ? 'dark' : 'light')
}

function themeChipClass(dark: boolean): string {
  const base = 'inline-flex items-center gap-1 text-[0.6875rem] font-medium py-1 px-2 rounded-md cursor-pointer border-none transition-all duration-150'
  return isDark() === dark
    ? `${base} bg-accent text-white shadow-sm`
    : `${base} bg-transparent text-muted hover:text-text hover:bg-bg-3`
}

// Named handleBack (not goBack) to avoid shadowing stx's injected goBack global.
function handleBack(): void {
  // Return to the projects / site list. Clear the source-of-truth siteId so
  // store-bound components reset, then navigate straight to the selector at '/'.
  // Direct navigation (not browser-back) so it works on deep-links + refreshes.
  dashboard.siteId.set('')
  // Explicit exit: suppress the selector's ONE auto-restore so it doesn't
  // immediately bounce back to the last site. Cleared by restoreLastSite.
  try { sessionStorage.setItem('tsa:pickProject', '1') } catch (_e) {}
  navigate('/', true)
}

function tabHref(tab: NavTab): string {
  // The selected site is held in state + localStorage, not the URL, so tab links
  // stay clean (/dashboard/…). The dashboard store persists across SPA navigation.
  return tab.href
}

function tabClass(tab: NavTab): string {
  const base = 'text-text-2 py-2 px-3 rounded-md text-[0.8125rem] font-medium transition-all duration-150 hover:bg-bg-3 hover:text-text no-underline'
  return dashboard.currentTab() === tab.id ? `${base} bg-accent text-white` : base
}

effect(() => {
  document.documentElement.setAttribute('data-theme', isDark() ? 'dark' : 'light')
})

// Keep the document title in sync with the active tab.
effect(() => {
  document.title = `${TAB_TITLES[dashboard.currentTab()] || 'Dashboard'} - Analytics`
})

// Mirror the store's siteId into the header-local copy used by the settings /
// account links, so they recompute when a site is picked from the selector
// (pickSite sets the store but fires no navigation event).
effect(() => {
  siteId.set(dashboard.siteId())
})

onMount(() => {
  // Normal navigation uses clean URLs and the site is restored from localStorage
  // by the selector. But still HONOR a ?siteId= when one is present — deep-links
  // (error-detail pages, external/alert links, old bookmarks) rely on it.
  const urlSiteId: string = new URLSearchParams(window.location.search).get('siteId') || ''
  if (urlSiteId) dashboard.siteId.set(urlSiteId)
  dashboard.currentTab.set(detectCurrentTab())

  adoptUser((window as { CURRENT_USER?: { email?: string } }).CURRENT_USER)
  document.addEventListener('tsa:user', (e: Event) => adoptUser((e as CustomEvent).detail))

  window.headerSetSiteName = (name: string) => siteName.set(name || 'Analytics Dashboard')
  window.dashboardHeader = {
    toggleTheme,
    goBack: handleBack,
    isDarkTheme: () => isDark(),
  }

  // Sync the active tab from the path after SPA navigation / history nav. Adopt a
  // ?siteId= if a deep-link carries one, but NEVER clear the store when it's
  // absent — clean navigation must keep the selected site (else every tab switch
  // would drop it).
  const syncFromUrl = (): void => {
    dashboard.currentTab.set(detectCurrentTab())
    const urlSiteId = new URLSearchParams(window.location.search).get('siteId') || ''
    if (urlSiteId) {
      dashboard.siteId.set(urlSiteId)
      siteId.set(urlSiteId)
    }
  }
  window.addEventListener('stx:navigate', syncFromUrl)
  window.addEventListener('popstate', syncFromUrl)

  // Close the avatar menu on outside click (capture phase — the stx router
  // stops propagation on bubbled clicks), Escape, or SPA navigation.
  const closeOnOutside = (e: Event): void => {
    if (!userMenuOpen()) return
    const menu = document.getElementById('user-menu')
    if (menu && !menu.contains(e.target as Node)) userMenuOpen.set(false)
  }
  const closeOnEscape = (e: KeyboardEvent): void => {
    if (e.key === 'Escape') userMenuOpen.set(false)
  }
  const closeMenu = (): void => userMenuOpen.set(false)
  document.addEventListener('click', closeOnOutside, true)
  document.addEventListener('keydown', closeOnEscape)
  window.addEventListener('stx:navigate', closeMenu)

  return () => {
    window.removeEventListener('stx:navigate', syncFromUrl)
    window.removeEventListener('popstate', syncFromUrl)
    document.removeEventListener('click', closeOnOutside, true)
    document.removeEventListener('keydown', closeOnEscape)
    window.removeEventListener('stx:navigate', closeMenu)
  }
})

provide('dashboardHeader', {
  siteName,
  isDark,
  currentTab: dashboard.currentTab,
  siteId,
  toggleTheme,
  goBack: handleBack,
})
</script>

<header class="flex items-center justify-between py-3 px-6 bg-bg-2 border-b border-border gap-4">
  <div class="flex items-center gap-3">
    <button class="btn btn-secondary gap-1.5 py-1.5 px-3 text-[0.8125rem] shrink-0" @click="handleBack()" title="Back to your projects">
      <Icon name="chevron-left" size="16" />
      Projects
    </button>
    <span id="current-site-name" class="font-semibold text-base text-text">{{ siteName() }}</span>
  </div>

  <nav id="header-nav" class="header-nav flex gap-1 flex-wrap justify-center">
    <a x-for="tab in tabs"
       x-class="tabClass(tab)"
       x-href="tabHref(tab)"
       x-data-tab="tab.id"
       data-stx-prefetch
>{{ tab.label }}</a>
  </nav>

  <div class="flex items-center gap-2">
    <a x-href="'/dashboard/settings'"
       x-class="dashboard.currentTab() === 'settings' ? 'icon-btn text-accent' : 'icon-btn'"
       title="Project settings"
       data-stx-prefetch>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
    </a>
    <div id="user-menu" class="relative">
      <button class="w-8 h-8 rounded-full bg-bg-3 border border-border text-muted inline-flex items-center justify-center cursor-pointer transition-all duration-150 hover:text-text hover:border-accent/60 hover:shadow-[0_0_0_3px_rgba(132,107,255,0.15)]"
              @click="toggleUserMenu()" title="Account" aria-haspopup="menu">
        <Icon name="user" size="16" />
      </button>

      <div x-show="userMenuOpen()" class="absolute right-0 top-full mt-2 w-60 bg-bg-2 border border-border rounded-xl shadow-2xl p-1.5 z-50">
        <div class="px-2.5 pt-2 pb-2.5 border-b border-border mb-1.5">
          <div class="text-[0.6875rem] uppercase tracking-wide text-muted mb-0.5">Signed in as</div>
          <div class="text-[0.8125rem] font-medium text-text truncate">{{ userEmail() || 'Guest' }}</div>
        </div>

        <div class="flex items-center justify-between px-2.5 py-1.5 mb-1">
          <span class="text-xs text-muted">Theme</span>
          <div class="inline-flex bg-bg rounded-lg border border-border p-0.5 gap-0.5">
            <button x-class="themeChipClass(false)" @click="setTheme(false)" title="Light mode">
              <Icon name="sun" size="14" />
              Light
            </button>
            <button x-class="themeChipClass(true)" @click="setTheme(true)" title="Dark mode">
              <Icon name="moon" size="14" />
              Dark
            </button>
          </div>
        </div>

        <a x-href="'/dashboard/account'" class="flex items-center gap-2 px-2.5 py-2 rounded-lg text-[0.8125rem] text-text-2 no-underline transition-colors duration-150 hover:bg-bg-3 hover:text-text" data-stx-prefetch @click="userMenuOpen.set(false)">
          <Icon name="user" size="15" />
          Account settings
        </a>

        <div class="border-t border-border my-1.5"></div>

        <form method="POST" action="/logout" class="block">
          <button type="submit" class="w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-[0.8125rem] text-text-2 bg-transparent border-none cursor-pointer text-left transition-colors duration-150 hover:bg-error/10 hover:text-error">
            <Icon name="log-out" size="15" />
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</header>

<style>
@media (max-width: 1200px) {
  header {
    flex-wrap: wrap;
  }
  .header-nav {
    order: 3;
    width: 100%;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .header-nav::-webkit-scrollbar {
    display: none;
  }
}
</style>
