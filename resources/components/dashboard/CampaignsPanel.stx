<script client>
/**
 * CampaignsPanel Component
 * Displays campaign breakdown with reactive data fetching
 */
const dashboard = useStore('dashboard')

const campaigns = state([])
const loading = state(true)

function fmt(n) {
  if (n === undefined || n === null) return '0'
  return n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${(n / 1e3).toFixed(1)}k` : String(n)
}

async function fetchCampaigns() {
  if (!dashboard.siteId()) {
    loading.set(false)
    return
  }
  try {
    const res = await fetch(dashboard.apiUrlWithDates('/campaigns'))
    const data = await res.json()
    campaigns.set((data.campaigns || []).slice(0, 10))
  } catch (e) {
    console.error('Failed to fetch campaigns:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (dashboard.siteId()) fetchCampaigns()
  window.refreshCampaignsPanel = fetchCampaigns
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="pie-chart" size="16" class="text-muted" />
      Campaigns
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('campaigns')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Campaign</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="campaign in campaigns" @loading="loading()">
        <td class="cell-name">{{ campaign.name ? campaign.name : (campaign.source ? campaign.source : 'Unknown') }}</td>
        <td class="cell-value">{{ fmt(campaign.visitors ? campaign.visitors : 0) }}</td>
        <td class="cell-value">{{ fmt(campaign.views ? campaign.views : 0) }}</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No campaign data</td>
      </tr>
    </tbody>
  </table>
</div>
