<script client>
/**
 * NoDataMessage Component
 *
 * Onboarding instructions shown when a site has never collected data. Visibility
 * and the tracking snippet are bound to the analytics store; when shown, the
 * dashboard's main content is hidden so only the onboarding appears.
 */
const analytics = useStore('analytics')
const dashboard = useStore('dashboard')

// Show only once stats have loaded, there's no data now, and the site has never
// had data this session (mirrors the controller's siteHasHistoricalData gate).
function showOnboarding(): boolean {
  const s = analytics.stats()
  if (!s || analytics.hasHistoricalData()) return false
  return !(s.views > 0 || s.sessions > 0 || s.people > 0)
}

function trackingSnippet(): string {
  // Fathom/Plausible-style one-liner: a single shared, cacheable /script.js for
  // every site, with the site in a data-site attribute. Build the tag from parts
  // so no literal script-tag text appears in this component's source — a literal
  // opening/closing tag corrupts stx's script-block parser and would terminate
  // the inlined block in the browser.
  const open = ['<', 'script'].join('')
  const close = ['<', '/script>'].join('')
  const origin = dashboard.apiEndpoint() || window.location.origin
  return `${open} defer data-site="${dashboard.siteId()}" src="${origin}/script.js">${close}`
}

// The onboarding replaces the dashboard body, so hide #main-content while shown.
effect(() => {
  const main = document.getElementById('main-content')
  if (main) main.style.display = showOnboarding() ? 'none' : ''
})
</script>

<div id="no-data-msg" class="bg-bg-2 rounded-lg p-12 text-center border border-border mb-6" style="display:none" x-show="showOnboarding()">
  <Icon name="bar-chart-2" size="48" class="text-warning mb-4 mx-auto" />
  <h3 class="mb-2 text-warning">No analytics data yet</h3>
  <p class="text-text-2 mb-4">Add the tracking script to your website to start collecting data.</p>
  <code id="tracking-script" class="block bg-bg p-4 rounded-md text-xs mt-4 text-accent-2 break-all text-left">{{ trackingSnippet() }}</code>
  <div class="flex items-start gap-4 text-left mt-6 pt-6 border-t border-border">
    <div class="bg-accent text-white w-6 h-6 rounded-full inline-flex items-center justify-center text-xs font-semibold flex-shrink-0">1</div>
    <div class="flex-1">
      <h4 class="text-sm mb-1">Copy the script tag</h4>
      <p class="text-[0.8125rem] text-muted">Copy the code above and paste it in your HTML</p>
    </div>
  </div>
  <div class="flex items-start gap-4 text-left mt-6 pt-6 border-t border-border">
    <div class="bg-accent text-white w-6 h-6 rounded-full inline-flex items-center justify-center text-xs font-semibold flex-shrink-0">2</div>
    <div class="flex-1">
      <h4 class="text-sm mb-1">Add to your pages</h4>
      <p class="text-[0.8125rem] text-muted">Place it in the &lt;head&gt; section of your website</p>
    </div>
  </div>
  <div class="flex items-start gap-4 text-left mt-6 pt-6 border-t border-border">
    <div class="bg-accent text-white w-6 h-6 rounded-full inline-flex items-center justify-center text-xs font-semibold flex-shrink-0">3</div>
    <div class="flex-1">
      <h4 class="text-sm mb-1">View your analytics</h4>
      <p class="text-[0.8125rem] text-muted">Data will appear here within a few seconds of your first visit</p>
    </div>
  </div>
</div>

<style>
/* No remaining vanilla CSS needed - all styles expressed as utility classes */
</style>
