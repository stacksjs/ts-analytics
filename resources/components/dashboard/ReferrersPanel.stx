<script client>
// Named handler: '>' inside an @-attribute silently kills the handler
// (stacksjs/stx#1771), so no arrows in event attributes.
function hideBrokenIcon(e) {
  e.target.style.display = 'none'
}

/**
 * ReferrersPanel Component
 * Displays top referrers with reactive data fetching
 */
const dashboard = useStore('dashboard')

const referrers = state([])
const loading = state(true)

function getDomain(source) {
  return source.replace(/^https?:\/\//, '').split('/')[0]
}

function isExternalLink(source) {
  const lower = (source || '').toLowerCase()
  return lower !== 'direct' && !source.includes('(') && source.includes('.')
}

function getHref(source) {
  return source.startsWith('http') ? source : `https://${source}`
}

function getFaviconUrl(source) {
  // x-show only CSS-hides the "Direct" anchor — its <img> src still evaluates
  // and fires a request. Transparent pixel for anything that isn't a domain.
  if (!source || !isExternalLink(source)) return 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
  return `https://www.google.com/s2/favicons?domain=${getDomain(source)}&sz=16`
}

function fmt(n) {
  if (n === undefined || n === null) return '0'
  return n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${(n / 1e3).toFixed(1)}k` : String(n)
}

async function fetchReferrers() {
  if (!dashboard.siteId()) {
    loading.set(false)
    return
  }
  try {
    const res = await fetch(dashboard.apiUrlWithDates('/referrers'))
    const data = await res.json()
    const rows = (data.referrers || []).slice(0, 10)
    // Precompute the Fathom-style bar width: percentage distribution (share of
    // the list total, min 2%) — the row-fill span binds it via x-style width.
    let total = 0
    for (const r of rows) total += r.visitors || 0
    for (const r of rows) r._bar = total > 0 ? Math.max(2, Math.round(((r.visitors || 0) / total) * 100)) : 0
    referrers.set(rows)
  } catch (e) {
    console.error('Failed to fetch referrers:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (dashboard.siteId()) fetchReferrers()
  window.refreshReferrersPanel = fetchReferrers
})

</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="link" size="16" class="text-muted" />
      Top Referrers
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('referrers')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Source</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="ref in referrers" @loading="loading()">
        <td class="cell-name">
          <span class="row-fill" x-style="'width: ' + (ref._bar ? ref._bar : 0) + '%'"></span>
          <a x-show="isExternalLink(ref.source ? ref.source : 'Direct')"
             x-href="getHref(ref.source)"
             target="_blank"
             rel="noopener"
             class="inline-flex items-center gap-1.5 hover:text-accent">
            <img
              x-src="getFaviconUrl(ref.source)"
              width="14"
              height="14"
              class="align-middle rounded-sm"
              @error="hideBrokenIcon($event)"
            />
            <span>{{ ref.source ? ref.source : 'Direct' }}</span>
            <Icon name="external-link" size="10" class="opacity-50" />
          </a>
          <span x-show="!isExternalLink(ref.source ? ref.source : 'Direct')">{{ ref.source ? ref.source : 'Direct' }}</span>
        </td>
        <td class="cell-value">{{ fmt(ref.visitors) }}</td>
        <td class="cell-value">{{ fmt(ref.views) }}</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No referrer data</td>
      </tr>
    </tbody>
  </table>
</div>
