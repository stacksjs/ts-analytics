<script server>
/**
 * DataPanel Component
 *
 * Generic panel for displaying data tables (pages, referrers, devices, etc.)
 */
import { defineProps, withDefaults } from 'stx'

interface Column {
  key: string
  label: string
  align?: 'left' | 'right'
}

interface DataPanelProps {
  id: string
  title: string
  icon: string
  viewAllLink?: string
  columns?: Column[]
  bodyId?: string
}

const { id, title, icon, viewAllLink, columns, bodyId } = withDefaults(
  defineProps<DataPanelProps>(),
  {
    viewAllLink: '#',
    columns: () => [],
  }
)
</script>

<div class="panel" id="{{ id }}-panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="inline text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ icon }}"/>
      </svg>
      {{ title }}
    </div>
    @if (viewAllLink)
      <a href="#" @click.prevent="window.navigateTo('{{ viewAllLink }}')" class="text-xs text-muted no-underline transition-colors duration-150 hover:text-text hover:underline">View all &rarr;</a>
    @endif
  </div>
  <table class="data-table w-full text-[0.8125rem]">
    <thead>
      <tr>
        @foreach (columns as col)
          <th class="text-left py-2 border-b border-border text-muted font-medium text-xs uppercase tracking-wide {{ col.align === 'right' ? 'text-right' : '' }}">{{ col.label }}</th>
        @endforeach
      </tr>
    </thead>
    <tbody id="{{ bodyId ? bodyId : (id + '-body') }}">
      <tr>
        <td colspan="{{ columns.length }}" class="text-center text-muted p-4">Loading...</td>
      </tr>
    </tbody>
  </table>
</div>

<style>
/* Styles for dynamically-populated table rows */
.data-table td {
  padding: 0.625rem 0;
  border-bottom: 1px solid var(--border);
}
.data-table tr:last-child td {
  border-bottom: none;
}
.data-table .name {
  color: var(--text);
  max-width: 180px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.data-table .value {
  color: var(--text2);
  text-align: right;
  white-space: nowrap;
}
.page-link {
  color: var(--text);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}
.page-link:hover {
  color: var(--accent);
  text-decoration: underline;
}
</style>
