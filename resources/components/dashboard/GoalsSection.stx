{{-- GoalsSection Component --}}
{{-- Props: goals (array), loading (boolean), onEdit (function), onDelete (function) --}}

@ts
function formatCurrency(n: number): string {
  return '$' + n.toFixed(2)
}

function getTypeBadgeClass(type: string): string {
  const base = 'inline-block text-[0.6875rem] py-0.5 px-1.5 rounded capitalize bg-bg-3 text-muted'
  const variants: Record<string, string> = {
    pageview: 'goal-type-pageview',
    event: 'goal-type-event',
    duration: 'goal-type-duration',
    scroll: 'goal-type-scroll'
  }
  return base + (variants[type?.toLowerCase()] ? ' ' + variants[type?.toLowerCase()] : '')
}
@endts

<script client>
/**
 * GoalsSection client-side logic
 */

function editGoalAction(goalId: string): void {
  if (window.goalModal) {
    window.goalModal.openEdit(goalId)
  }
}

function deleteGoalAction(goalId: string): void {
  if (window.Modal) {
    window.Modal.confirm('Delete this goal? Conversion data will be preserved.', async () => {
      try {
        const res: Response = await fetch(
          window.apiPath(`${window.API_ENDPOINT}/api/sites/${window.siteId}/goals/${goalId}`),
          { method: 'DELETE' }
        )
        if (res.ok) {
          if (window.fetchDashboardData) window.fetchDashboardData()
          if (window.refreshAllPanels) window.refreshAllPanels()
        }
      } catch (err: unknown) {
        console.error('Delete goal error:', err)
      }
    })
  }
}
</script>

<div id="goals-content">
  @if(loading)
    <div class="p-6 text-center text-muted text-[0.8125rem]">Loading...</div>
  @elseif(goals.length === 0)
    <div class="p-6 text-center text-muted text-[0.8125rem]">
      <p>No goals configured yet.</p>
      <p class="mt-2 text-xs opacity-80">Click "+ Add Goal" to create your first conversion goal.</p>
    </div>
  @else
    <table class="w-full border-collapse text-[0.8125rem]">
      <thead>
        <tr>
          <th class="text-left py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Goal</th>
          <th class="text-left py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Type</th>
          <th class="text-right py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Conversions</th>
          <th class="text-right py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Value</th>
          <th class="text-right py-2 px-2 border-b border-border text-[0.6875rem] font-medium uppercase tracking-wide text-muted">Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach(goals as goal)
          <tr class="goal-row" data-goal-id="{{ goal.id }}">
            <td class="font-medium">{{ goal.name }}</td>
            <td>
              <span class="{{ getTypeBadgeClass(goal.type) }}">{{ goal.type }}</span>
            </td>
            <td class="goal-conversions text-right">{{ (goal.conversions ? goal.conversions : 0) | fmt }}</td>
            <td class="goal-value text-right">
              @if(goal.value)
                {{ formatCurrency(goal.value) }}
              @else
                -
              @endif
            </td>
            <td class="text-right whitespace-nowrap">
              <button class="icon-btn edit-btn" title="Edit" @click="editGoalAction('{{ goal.id }}')">
                <Icon name="edit" size="14" />
              </button>
              <button class="icon-btn danger delete-btn" title="Delete" @click="deleteGoalAction('{{ goal.id }}')">
                <Icon name="trash-2" size="14" />
              </button>
            </td>
          </tr>
        @endforeach
      </tbody>
    </table>
  @endif
</div>

<style>
/* Color variants (rgba values) */
.goal-type-pageview { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
.goal-type-event { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
.goal-type-duration { background: rgba(168, 85, 247, 0.15); color: #a855f7; }
.goal-type-scroll { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }

/* Tabular nums (no utility equivalent) */
.goal-conversions, .goal-value { font-variant-numeric: tabular-nums; }

/* Danger hover (rgba) */
.icon-btn.danger:hover { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
</style>
