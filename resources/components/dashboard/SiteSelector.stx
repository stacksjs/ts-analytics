<script client>
const dashboard = useStore('dashboard')

const loading = state(true)
const error = state(null)
const sites = state([])
const newName = state('')
const newDomain = state('')
const createError = state(null)
const creating = state(false)

// Project-hub state (#61): search, recents, and last-selected persistence —
// keyed per authenticated user so shared machines don't leak selections.
const searchQuery = state('')
const userScope = state('anon')

function storageKey(name: string): string {
  return `tsa:${name}:${userScope()}`
}

async function loadUserScope(): Promise<void> {
  try {
    const res = await fetch(dashboard.apiPath(`${dashboard.apiEndpoint()}/api/auth/me`))
    if (res.ok) {
      const data = await res.json()
      if (data.user && data.user.id) userScope.set(data.user.id)
    }
  } catch (_e) {
    // unauthenticated → anon scope
  }
}

function readRecentIds(): string[] {
  try {
    return JSON.parse(localStorage.getItem(storageKey('recent')) || '[]')
  } catch (_e) {
    return []
  }
}

function rememberSite(id) {
  try {
    localStorage.setItem(storageKey('lastSite'), id)
    const recent = [id, ...readRecentIds().filter((r) => r !== id)].slice(0, 3)
    localStorage.setItem(storageKey('recent'), JSON.stringify(recent))
  } catch (_e) {
    // storage unavailable (private mode) — selection just won't persist
  }
}

const filteredSites = derived(() => {
  const q = searchQuery().trim().toLowerCase()
  if (!q) return sites()
  return sites().filter((s) => {
    const name = (s.name || '').toLowerCase()
    const domain = ((s.domains && s.domains[0]) || '').toLowerCase()
    return name.includes(q) || domain.includes(q) || String(s.id).toLowerCase().includes(q)
  })
})

const recentSites = derived(() => {
  // touch userScope so recents recompute once /me resolves
  userScope()
  const ids = readRecentIds()
  return ids
    .map((id) => sites().find((s) => s.id === id))
    .filter((s) => !!s)
})

// Build the /api/sites URL at call time via the store (resolves the endpoint
// lazily). Capturing window.API_ENDPOINT at eval time gets the origin fallback,
// because the layout sets window.ANALYTICS_API_ENDPOINT after components init.
function sitesUrl(): string {
  return dashboard.apiPath(`${dashboard.apiEndpoint()}/api/sites`)
}

async function fetchSites() {
  loading.set(true)
  error.set(null)
  try {
    const res = await fetch(sitesUrl())
    if (!res.ok) throw new Error('Failed to fetch')
    const data = await res.json()
    sites.set(data.sites || [])
    window._availableSites = data.sites || []
  } catch (e) {
    error.set(e.message)
  } finally {
    loading.set(false)
  }
}

async function handleCreate(e) {
  e.preventDefault()
  const name = newName().trim()
  if (!name) {
    createError.set('Site name is required')
    return
  }

  creating.set(true)
  createError.set(null)
  try {
    const res = await fetch(sitesUrl(), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, domain: newDomain().trim() || undefined }),
    })
    const data = await res.json()
    if (!res.ok) {
      createError.set(data.error || 'Failed to create site')
      return
    }
    newName.set('')
    newDomain.set('')
    await fetchSites()
    if (data.site) {
      // Store is the source of truth for siteId so store-bound panels/chart pick
      // up the new site; the controller still orchestrates the shell + fetches.
      rememberSite(data.site.id)
      dashboard.siteId.set(data.site.id)
      if (window.selectSite) window.selectSite(data.site.id, data.site.name)
    }
  } catch (e) {
    createError.set('Failed to create site')
  } finally {
    creating.set(false)
  }
}

function pickSite(id, label) {
  rememberSite(id)
  // Store is the source of truth for siteId — the shell effect below reacts to it.
  dashboard.siteId.set(id)
  if (window.selectSite) window.selectSite(id, label)
}

// Survive reloads (#61): with no site in the URL/store, restore the user's
// last-selected project — but only if it's still in their list (deleted or
// revoked projects fall back to the selector).
function restoreLastSite(): boolean {
  if (dashboard.siteId()) return false
  // Only auto-restore on the hub itself — restoring (via selectSite) rewrites
  // the URL to /dashboard, which would yank the user off project-independent
  // pages like /dashboard/account.
  if (window.location.pathname !== '/dashboard') return false
  let last = ''
  try {
    last = localStorage.getItem(storageKey('lastSite')) || ''
  } catch (_e) {
    return false
  }
  const site = sites().find((s) => s.id === last)
  if (!site) return false
  pickSite(site.id, site.name || '')
  return true
}

// Show the dashboard when a site is selected, the selector otherwise.
// setProperty('important') overrides the layout's inline pre-paint style rule so
// this stays authoritative across SPA transitions. (No literal tag text in this
// comment — it would corrupt stx's component block parsing.)
function applyShellVisibility() {
  // The account page is project-independent (#115): always show the shell there.
  const hasSite = !!dashboard.siteId() || window.location.pathname === '/dashboard/account'
  const sel = document.getElementById('site-selector')
  const dash = document.getElementById('dashboard')
  if (sel) sel.style.setProperty('display', hasSite ? 'none' : 'flex', 'important')
  if (dash) dash.style.setProperty('display', hasSite ? 'flex' : 'none', 'important')
}

// Reactive: re-apply on every site change (pick / create / goBack transitions).
effect(() => {
  dashboard.siteId()
  applyShellVisibility()
})

onMount(() => {
  // Re-apply now that this component's #site-selector root is actually mounted —
  // the top-level effect's first run happens before the root is attached, so on a
  // no-siteId load it would otherwise leave the selector hidden (black page).
  applyShellVisibility()
  window.fetchSites = fetchSites
  const boot = async () => {
    await loadUserScope()
    await fetchSites()
    restoreLastSite()
  }
  boot()
})
</script>

<div id="site-selector" class="site-selector-wrapper" style="display:none">
  <h1 class="text-3xl font-bold text-text mb-2">Analytics Dashboard</h1>
  <p class="text-text-2 mb-8">Select a site to view analytics</p>

  <div class="site-selector-content">
    <div x-show="loading()" class="site-status">
      <div class="site-spinner"></div>
      <p>Loading sites...</p>
    </div>

    <div x-show="!loading() && error()" class="site-status">
      <Icon name="alert-triangle" size="32" class="text-error" style="opacity:0.7;margin-bottom:0.75rem" />
      <p x-text="error()"></p>
      <button class="retry-btn" @click="fetchSites()">Retry</button>
    </div>

    <div x-show="!loading() && !error()">
      <div class="create-form">
        <h3 class="section-label">Create New Site</h3>
        <form class="create-form-row" @submit="handleCreate($event)">
          <input type="text" placeholder="Site name (e.g. My Website)" required
                 x-value="newName()" @input="newName.set($event.target.value)"
                 class="form-input" />
          <input type="text" placeholder="Domain (optional)"
                 x-value="newDomain()" @input="newDomain.set($event.target.value)"
                 class="form-input" />
          <button type="submit" class="create-btn" x-disabled="creating()" x-text="creating() ? 'Creating...' : 'Create'"></button>
        </form>
        <p x-show="createError()" class="create-error" x-text="createError()"></p>
      </div>

      <div x-show="sites().length === 0" class="site-empty">
        <Icon name="bar-chart-2" size="48" />
        <p>No sites yet</p>
        <p class="text-xs text-muted mt-2">Create your first site above to start tracking analytics</p>
      </div>

      <div x-show="recentSites().length > 0 && !searchQuery()" class="site-list-section">
        <h3 class="section-label">Recent</h3>
        <button x-for="site in recentSites" class="site-card" @click="pickSite(site.id, site.name || '')">
          <div class="site-icon">
            <Icon name="clock" size="24" />
          </div>
          <div class="site-info">
            <span class="site-name" x-text="site.name || 'Unnamed'"></span>
            <span class="site-domain" x-text="site.domains?.[0] || site.id"></span>
          </div>
          <Icon name="chevron-right" size="20" class="site-arrow" />
        </button>
      </div>

      <div x-show="sites().length > 0" class="site-list-section">
        <h3 class="section-label">Your Projects</h3>
        <input x-show="sites().length > 4" type="text" placeholder="Search projects…"
               x-value="searchQuery()" @input="searchQuery.set($event.target.value)"
               class="form-input site-search" />
        <button x-for="site in filteredSites" class="site-card" @click="pickSite(site.id, site.name || '')">
          <div class="site-icon">
            <Icon name="globe" size="24" />
          </div>
          <div class="site-info">
            <span class="site-name" x-text="site.name || 'Unnamed'"></span>
            <span class="site-domain" x-text="site.domains?.[0] || site.id"></span>
          </div>
          <Icon name="chevron-right" size="20" class="site-arrow" />
        </button>
        <p x-show="searchQuery() && filteredSites().length === 0" class="text-xs text-muted mt-2">No projects match "<span x-text="searchQuery()"></span>"</p>
      </div>
    </div>
  </div>
</div>

<style>
.site-selector-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 2rem;
  text-align: center;
}
.site-selector-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  width: 100%;
  max-width: 600px;
}

.site-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 3rem 2rem;
  color: var(--muted);
  font-size: 0.875rem;
}
.site-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: site-spin 0.8s linear infinite;
  margin-bottom: 1rem;
}
@keyframes site-spin { to { transform: rotate(360deg); } }
.retry-btn {
  padding: 0.375rem 1rem;
  font-size: 0.8125rem;
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: 6px;
  color: var(--text);
  cursor: pointer;
  transition: all 150ms;
  margin-top: 0.5rem;
}
.retry-btn:hover {
  border-color: var(--accent);
  background: var(--bg2);
}

.create-form {
  width: 100%;
  margin-bottom: 1.5rem;
}
.section-label {
  font-size: 0.875rem;
  margin-bottom: 0.75rem;
  color: var(--text2);
}
.create-form-row {
  display: flex;
  gap: 0.5rem;
}
.form-input {
  flex: 1;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg2);
  color: var(--text);
  font-size: 0.875rem;
}
.form-input:focus {
  outline: none;
  border-color: var(--accent);
}
.create-btn {
  padding: 0.5rem 1rem;
  border-radius: 6px;
  background: var(--accent);
  color: white;
  border: none;
  cursor: pointer;
  font-weight: 500;
  font-size: 0.875rem;
  transition: opacity 150ms;
}
.create-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.create-error {
  color: var(--error);
  font-size: 0.75rem;
  margin-top: 0.5rem;
}

.site-empty {
  color: var(--muted);
  padding: 2rem;
}

.site-list-section {
  width: 100%;
}
.site-search {
  width: 100%;
  margin-bottom: 0.75rem;
}
.site-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: 100%;
  padding: 1rem;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  cursor: pointer;
  text-align: left;
  margin-bottom: 0.5rem;
  transition: all 200ms;
  color: var(--text);
}
.site-card:hover {
  border-color: var(--accent);
  background: var(--bg3);
  transform: translateY(-1px);
}
.site-icon {
  width: 2.5rem;
  height: 2.5rem;
  background: var(--bg3);
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--accent);
}
.site-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 0;
}
.site-name {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
}
.site-domain {
  font-size: 0.75rem;
  color: var(--muted);
}
.site-arrow {
  color: var(--muted);
  flex-shrink: 0;
  transition: color 150ms;
}
.site-card:hover .site-arrow {
  color: var(--accent);
}
</style>
