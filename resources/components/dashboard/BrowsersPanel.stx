<script client>
/**
 * BrowsersPanel Component
 * Displays browser breakdown with reactive data fetching
 */
const dashboard = useStore('dashboard')
const analytics = useStore('analytics')

function fmt(n) {
  if (n === undefined || n === null) return '0'
  return n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${(n / 1e3).toFixed(1)}k` : String(n)
}

onMount(() => {
  if (dashboard.siteId()) analytics.fetchSection('browsers')
  window.refreshBrowsersPanel = () => analytics.fetchSection('browsers')
})
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <Icon name="globe" size="16" class="text-muted" />
      Browsers
    </div>
    <a href="#" @click.prevent="dashboard.navigateTo('browsers')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Browser</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">%</th>
      </tr>
    </thead>
    <tbody>
      <tr x-for="browser in analytics.browsers" @loading="analytics.loading()">
        <td class="cell-name" x-text="browser.name ? browser.name : 'Unknown'"></td>
        <td class="cell-value" x-text="fmt(browser.visitors)"></td>
        <td class="cell-value" x-text="(browser.percentage ? browser.percentage : 0) + '%'"></td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No browser data</td>
      </tr>
    </tbody>
  </table>
</div>
