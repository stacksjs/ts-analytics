<script server>
import { defineProps, withDefaults } from 'stx'

interface PageHeaderProps {
  title?: string
  iconPath?: string
  subtitle?: string
}

const { title, iconPath, subtitle } = withDefaults(defineProps<PageHeaderProps>(), {
  title: 'Page Title',
  iconPath: '',
  subtitle: '',
})

const iconHidden = iconPath ? '' : 'hidden'
const subtitleHidden = subtitle ? '' : 'hidden'
</script>

<template>
<header class="mb-6">
  <h1 class="flex items-center gap-3 text-2xl font-semibold text-white">
    <svg class="w-6 h-6 {{ iconHidden }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      {!! iconPath !!}
    </svg>
    {{ title }}
  </h1>
  <p class="text-gray-400 mt-2 {{ subtitleHidden }}">{{ subtitle }}</p>
</header>
</template>
