<script server lang="ts">
import { defineProps, withDefaults } from 'stx'

interface Session {
  id?: string
  entryPath?: string
  startedAt?: string
  pageViewCount?: number
  duration?: number
  browser?: string
  country?: string
  isBounce?: boolean
}

interface SessionCardProps {
  session?: Session
}

const { session } = withDefaults(defineProps<SessionCardProps>(), {
  session: () => ({}),
})

function formatDuration(ms: number | undefined): string {
  if (!ms)
    return '0s'
  const s = Math.floor(ms / 1000)
  if (s < 60)
    return `${s}s`
  const m = Math.floor(s / 60)
  return `${m}m ${s % 60}s`
}

const sessionId = session.id || ''
const entryPath = session.entryPath || '/'
const startTime = session.startedAt ? new Date(session.startedAt).toLocaleString() : ''
const pageCount = session.pageViewCount || 0
const duration = formatDuration(session.duration)
const browser = session.browser || 'Unknown'
const country = session.country || 'Unknown'
const isBounce = !!session.isBounce
</script>

<script client>
function selectSession(id) {
  window.dispatchEvent(new CustomEvent('session-select', { detail: { id } }))
}
</script>

<div class="session-card" @click="selectSession('{{ sessionId }}')">
  <div class="flex justify-between items-center mb-2">
    <span class="font-medium text-sm text-text">{{ entryPath }}</span>
    <span class="text-xs text-muted">{{ startTime }}</span>
  </div>
  <div class="flex gap-3 flex-wrap text-xs text-muted">
    <span>{{ pageCount }} pages</span>
    <span>{{ duration }}</span>
    <span>{{ browser }}</span>
    <span>{{ country }}</span>
    @if (isBounce)
      <span class="text-warning font-medium">Bounced</span>
    @endif
  </div>
</div>
