<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error Tracking Test - Analytics</title>
</head>
<body class="bg-gray-900 text-gray-200 font-sans antialiased min-h-screen p-8">
  <div class="max-w-3xl mx-auto">
    <a x-href="'/dashboard?siteId=' + siteId()" class="inline-flex items-center gap-1 text-blue-400 hover:text-blue-300 hover:underline mb-4">
      <Icon name="chevron-left" size="16" />
      Back to Dashboard
    </a>

    <header class="mb-6">
      <h1 class="text-2xl font-semibold text-white">Error Tracking Test</h1>
      <p class="text-gray-400 mt-2">Site ID: {{ siteId() }}</p>
    </header>

    <div class="bg-gray-800 rounded-lg p-6 mb-6">
      <h2 class="text-lg font-medium mb-2">Test JavaScript Errors</h2>
      <p class="text-gray-400 mb-4">Click the buttons below to trigger different types of JavaScript errors. These will be captured and sent to the analytics API.</p>

      <div class="flex flex-wrap gap-2">
        <button @click="testSyntaxError()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-sm font-medium">Syntax Error</button>
        <button @click="testTypeError()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-sm font-medium">Type Error</button>
        <button @click="testReferenceError()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-sm font-medium">Reference Error</button>
        <button @click="testCustomError()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-sm font-medium">Custom Error</button>
        <button @click="testAsyncError()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded text-sm font-medium">Async Error</button>
      </div>
    </div>

    <div class="bg-gray-800 rounded-lg p-6">
      <h2 class="text-lg font-medium mb-4">Event Log</h2>
      <div class="bg-gray-900 rounded p-4 font-mono text-sm max-h-48 overflow-y-auto">
        <div x-for="entry in logEntries()" @class="['py-1 border-b border-gray-700 last:border-0', entry.type === 'error' ? 'text-red-400' : '', entry.type === 'success' ? 'text-green-400' : '']">
          {{ entry.text }}
        </div>
      </div>
    </div>
  </div>

  <script client>
interface LogEntry {
  text: string
  type: string
}

const urlParams: URLSearchParams = new URLSearchParams(window.location.search)
const API: string = window.ANALYTICS_API || urlParams.get('api') || window.location.origin
const SITE_ID: string = urlParams.get('siteId') || window.ANALYTICS_SITE_ID || 'test-site'

const siteId = state<string>(SITE_ID)
const logEntries = state<LogEntry[]>([
  { text: '[' + new Date().toLocaleTimeString() + '] Ready to capture errors...', type: 'info' }
])

function log(message: string, type: string = 'info'): void {
  const entry: LogEntry = {
    text: '[' + new Date().toLocaleTimeString() + '] ' + message,
    type
  }
  logEntries.update((entries: LogEntry[]) => [...entries, entry])
}

function sendError(payload: Record<string, unknown>): void {
  fetch(API + '/collect', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).then(() => log('Error sent to API', 'success'))
    .catch((err: Error) => log('Failed to send error: ' + err.message, 'error'))
}

function testSyntaxError(): void {
  log('Triggering syntax error...')
  eval('function() {')
}

function testTypeError(): void {
  log('Triggering type error...')
  ;(null as any).toString()
}

function testReferenceError(): void {
  log('Triggering reference error...')
  ;(window as any).undefinedVariable.doSomething()
}

function testCustomError(): void {
  log('Triggering custom error...')
  throw new Error('Test custom error from test page')
}

async function testAsyncError(): Promise<void> {
  log('Triggering async error...')
  await Promise.reject(new Error('Test async error'))
}

onMount(() => {
  const handleError = (msg: Event | string, source?: string, line?: number, col?: number, error?: Error): boolean => {
    log('Caught: ' + String(msg), 'error')
    sendError({
      s: SITE_ID,
      e: 'error',
      u: window.location.href,
      p: { message: String(msg), source, line, col, stack: error?.stack }
    })
    return false
  }

  const handleRejection = (event: PromiseRejectionEvent): void => {
    log('Unhandled rejection: ' + String(event.reason), 'error')
    sendError({
      s: SITE_ID,
      e: 'error',
      u: window.location.href,
      p: { message: String(event.reason), type: 'unhandledrejection', stack: event.reason?.stack }
    })
  }

  window.onerror = handleError
  window.onunhandledrejection = handleRejection

  log('Error handlers initialized', 'success')

  return () => {
    window.onerror = null
    window.onunhandledrejection = null
  }
})
  </script>
</body>
</html>
