<script server>
export const error: string = props.error || ''
export const reset: string = props.reset || ''
</script>

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Analytics</title>
  <style>
    :root, [data-theme="dark"] {
      --bg: #0f1117;
      --bg2: #1a1d27;
      --bg3: #252830;
      --text: #e4e6eb;
      --text2: #8b8fa3;
      --muted: #8b8fa3;
      --border: #2d3040;
      --accent: #6366f1;
      --accent-hover: #5558e6;
      --error-bg: #3b1219;
      --error-text: #f87171;
      --error-border: #5c2130;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    .submit-btn:hover {
      background: var(--accent-hover);
    }
    .form-input:focus {
      border-color: var(--accent);
    }
    .form-input::placeholder {
      color: var(--text2);
    }
  </style>
</head>
<body class="font-sans bg-bg text-text min-h-screen flex items-center justify-center">
  <div class="bg-bg-2 border border-border rounded-xl p-10 w-full max-w-[400px] m-4">
    <h1 class="text-2xl mb-2">Welcome back</h1>
    <p class="text-text-2 text-sm mb-8">Sign in to your analytics dashboard</p>

    @if(error === 'invalid')
    <div class="bg-[var(--error-bg)] text-[var(--error-text)] border border-[var(--error-border)] py-3 px-4 rounded-lg mb-6 text-sm">Invalid email or password</div>
    @elseif(error === 'missing')
    <div class="bg-[var(--error-bg)] text-[var(--error-text)] border border-[var(--error-border)] py-3 px-4 rounded-lg mb-6 text-sm">Please fill in all fields</div>
    @elseif(error === 'server')
    <div class="bg-[var(--error-bg)] text-[var(--error-text)] border border-[var(--error-border)] py-3 px-4 rounded-lg mb-6 text-sm">An error occurred. Please try again.</div>
    @elseif(error === 'oauth')
    <div class="bg-[var(--error-bg)] text-[var(--error-text)] border border-[var(--error-border)] py-3 px-4 rounded-lg mb-6 text-sm">Social sign-in failed. Please try again or use your password.</div>
    @elseif(error === 'oauth-unverified-email')
    <div class="bg-[var(--error-bg)] text-[var(--error-text)] border border-[var(--error-border)] py-3 px-4 rounded-lg mb-6 text-sm">Your email is not verified with that provider, so it can't be linked to an existing account.</div>
    @elseif(error === 'csrf')
    <div class="bg-[var(--error-bg)] text-[var(--error-text)] border border-[var(--error-border)] py-3 px-4 rounded-lg mb-6 text-sm">Security check failed — please submit the form again from this page.</div>
    @endif

    @if(reset === '1')
    <div class="border border-border bg-bg-3 py-3 px-4 rounded-lg mb-6 text-sm text-[#34d399]">Password updated — sign in with your new password.</div>
    @endif

    <form method="POST" action="/login">
      <div class="mb-5">
        <label for="email" class="block text-sm font-medium mb-1.5 text-text-2">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" autofocus
          class="form-input w-full py-2.5 px-3.5 bg-bg-3 border border-border rounded-lg text-text text-[0.9375rem] outline-none transition-colors duration-150">
      </div>
      <div class="mb-5">
        <label for="password" class="block text-sm font-medium mb-1.5 text-text-2">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password"
          class="form-input w-full py-2.5 px-3.5 bg-bg-3 border border-border rounded-lg text-text text-[0.9375rem] outline-none transition-colors duration-150">
      </div>
      <div class="text-right mb-2"><a href="/forgot" class="text-text-2 text-xs no-underline hover:text-accent">Forgot password?</a></div>
      <button type="submit" class="submit-btn w-full py-3 bg-accent text-white border-none rounded-lg text-[0.9375rem] font-semibold cursor-pointer transition-colors duration-150 mt-2">Sign in</button>
    </form>

    <div class="flex items-center gap-3 my-6">
      <div class="flex-1 h-px bg-border"></div>
      <span class="text-xs text-muted">or continue with</span>
      <div class="flex-1 h-px bg-border"></div>
    </div>
    <div class="flex gap-3">
      <a href="/api/auth/oauth/google" class="flex-1 flex items-center justify-center gap-2 py-2.5 bg-bg-3 border border-border rounded-lg text-text text-sm font-medium no-underline transition-colors duration-150 hover:border-accent">
        <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Google
      </a>
      <a href="/api/auth/oauth/github" class="flex-1 flex items-center justify-center gap-2 py-2.5 bg-bg-3 border border-border rounded-lg text-text text-sm font-medium no-underline transition-colors duration-150 hover:border-accent">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        GitHub
      </a>
    </div>

    <p class="text-text-2 text-sm text-center mt-6">New here? <a href="/signup" class="text-accent no-underline">Create an account</a></p>
  </div>
</body>
</html>
