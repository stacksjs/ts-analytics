{{-- Dashboard Layout - Shared layout for all dashboard pages --}}
@include('dashboard/DashboardStyles')

<stx-loading-indicator color="var(--accent)" height="3px" />
<site-selector />

<script>
  // Show the dashboard immediately when a siteId is in the URL (pre-paint).
  // Must NOT use document.write: after the document has loaded it reopens and
  // wipes everything, which nulled the body element during SPA navigation (every
  // tab swap broke the page). Append a style node instead.
  (function() {
    var params = new URLSearchParams(window.location.search);
    var siteId = params.get('siteId');
    // The account page is project-independent (#115) — always show the shell there.
    if (siteId || window.location.pathname === '/dashboard/account') {
      var s = document.createElement('style');
      s.textContent = '#dashboard{display:flex!important}#site-selector{display:none!important}';
      (document.head || document.documentElement).appendChild(s);
    }
  })();
</script>

<script>window.ANALYTICS_API_ENDPOINT = {{ $env.STX_PUBLIC_API_ENDPOINT || '' }};</script>

<script>
  // Account-first session gate (#115): the dashboard never renders without a
  // signed-in user. A 401 from /api/auth/me redirects to /login — unless the
  // server reports enforcement is off (ANALYTICS_REQUIRE_AUTH=false installs).
  // Network errors fail open: an unreachable API shouldn't lock the shell.
  (function() {
    var api = window.ANALYTICS_API_ENDPOINT || '';
    fetch(api + '/api/auth/me', { credentials: 'include' })
      .then(function(r) {
        if (r.status === 401) {
          return r.json().then(function(body) {
            if (!body || body.requireAuth !== false) window.location.replace('/login');
            return null;
          });
        }
        return r.ok ? r.json() : null;
      })
      .then(function(data) {
        if (data && data.user) {
          window.CURRENT_USER = data.user;
          document.dispatchEvent(new CustomEvent('tsa:user', { detail: data.user }));
        }
      })
      .catch(function() {});
  })();
</script>

<script src="/assets/functions/composables.ts"></script>
<script src="/assets/functions/dashboard.ts"></script>

<div id="dashboard" class="min-h-screen flex flex-col" style="display:none">
  {{-- Crosswind class-safelist sentinel.
       The per-page crosswind generator only emits CSS for classes it sees in
       the RENDERED HTML — static class="" attributes and x-class string/object
       literals. Shortcuts applied purely via x-class FUNCTION return values
       (e.g. rangeBtnClass(), tab-btn toggles, status-driven badge/card classes)
       are invisible to it, so their rules never generate and the elements
       render unstyled. The config's `safelist` does NOT expand shortcut names,
       so we list those dynamic-only shortcuts here as real static classes —
       one occurrence per page (this layout wraps all 22 dashboard views) is
       enough to force every rule to generate. Hidden; never displayed. --}}
  <div hidden aria-hidden="true" class="date-range-btn date-range-btn-active tab-btn tab-btn-active badge badge-success badge-warning badge-error badge-info btn-danger session-card error-card vital-card"></div>

  <dashboard-header />

  @yield('controls')

  @include('dashboard/NoDataMessage')

  <main id="main-content" class="flex-1 p-6 max-w-[1400px] mx-auto w-full">
    @yield('content')
  </main>

  <goal-modal />
  @include('Modal')
  @include('SessionModal')
</div>

@include('shared/EmptyStates')
@yield('scripts')
