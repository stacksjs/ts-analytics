{{-- Dashboard Layout - Shared layout for all dashboard pages --}}
@include('dashboard/DashboardStyles')

<stx-loading-indicator color="var(--accent)" height="3px" />
<site-selector />

<script>
  // Show the dashboard immediately when a siteId is in the URL (pre-paint).
  // Must NOT use document.write: after the document has loaded it reopens and
  // wipes everything, which nulled the body element during SPA navigation (every
  // tab swap broke the page). Append a style node instead.
  (function() {
    var params = new URLSearchParams(window.location.search);
    var siteId = params.get('siteId');
    if (siteId) {
      var s = document.createElement('style');
      s.textContent = '#dashboard{display:flex!important}#site-selector{display:none!important}';
      (document.head || document.documentElement).appendChild(s);
    }
  })();
</script>

<script>window.ANALYTICS_API_ENDPOINT = {{ $env.STX_PUBLIC_API_ENDPOINT || '' }};</script>
<script src="/assets/functions/composables.ts"></script>
<script src="/assets/functions/dashboard.ts"></script>

<div id="dashboard" class="min-h-screen flex flex-col" style="display:none">
  <dashboard-header />

  @yield('controls')

  @include('dashboard/NoDataMessage')

  <main id="main-content" class="flex-1 p-6 max-w-[1400px] mx-auto w-full">
    @yield('content')
  </main>

  <goal-modal />
  @include('Modal')
  @include('SessionModal')
</div>

@include('shared/EmptyStates')
@yield('scripts')
