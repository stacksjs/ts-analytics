{{-- Dashboard Layout - Shared layout for all dashboard pages --}}
@include('dashboard/DashboardStyles')

<stx-loading-indicator color="var(--accent)" height="3px" />
<site-selector />

<script>
  // Show the dashboard shell immediately (pre-paint) when the user has a
  // remembered site, so a refresh doesn't flash the selector. The selected site
  // now lives in localStorage (tsa:lastSite:<scope>), not the URL — scan for any
  // non-empty last-site key. The reactive applyShellVisibility corrects the edge
  // case where the remembered site was deleted.
  // Must NOT use document.write: after load it reopens and wipes everything
  // (nulled the body during SPA nav). Append a style node instead.
  (function() {
    // An explicit "back to projects" click suppresses the auto-restore — show the
    // selector, not the dashboard shell, even if a last-site is remembered.
    var pickProject = false;
    try { pickProject = !!sessionStorage.getItem('tsa:pickProject'); } catch (e) {}
    // Deep-links (error-detail, external/alert) may still carry ?siteId=; honor
    // it. Otherwise fall back to a remembered last-site in localStorage.
    var hasSite = !pickProject && (window.location.pathname === '/dashboard/account'
      || !!new URLSearchParams(window.location.search).get('siteId'));
    if (!hasSite && !pickProject) {
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && k.indexOf('tsa:lastSite:') === 0 && localStorage.getItem(k)) { hasSite = true; break; }
        }
      } catch (e) {}
    }
    if (hasSite) {
      var s = document.createElement('style');
      s.textContent = '#dashboard{display:flex!important}#site-selector{display:none!important}';
      (document.head || document.documentElement).appendChild(s);
    }
  })();
</script>

<script>
  // Dead-binding canary v2 (moustache deep-dive): captures FORENSICS at the
  // moment bindings die — router/stx console lines since the last nav, the
  // dead scope's registration + script state — so a field repro hands us the
  // mechanism directly. Dev-only.
  (function(){
    if (!/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) return;
    var buffer = [];
    ['log','warn','error','debug','info'].forEach(function(k){
      var orig = console[k] && console[k].bind(console);
      if (!orig) return;
      console[k] = function(){
        try {
          var msg = Array.prototype.map.call(arguments, String).join(' ');
          if (/router|stx|script|scope|swap|dedup|fragment/i.test(msg) && msg.indexOf('[canary]') === -1) {
            buffer.push(k + ': ' + msg.slice(0, 180));
            if (buffer.length > 40) buffer.shift();
          }
        } catch (e) {}
        orig.apply(null, arguments);
      };
    });
    window.addEventListener('error', function(e){
      buffer.push('ONERROR: ' + e.message + ' @ ' + (e.filename || '').split('/').pop() + ':' + e.lineno);
    });
    function forensics() {
      try {
        var el = document.getElementById('chart');
        var scopeEl = el ? el.closest('[data-stx-scope]') : null;
        var id = scopeEl ? scopeEl.getAttribute('data-stx-scope') : '(no chart scope el)';
        var scopes = (window.stx && window.stx._scopes) || {};
        var sv = scopes[id];
        var scripts = scopeEl ? scopeEl.querySelectorAll('script').length : -1;
        var containerScope = null;
        try {
          var main = document.querySelector('main') || document.getElementById('main-content');
          containerScope = main && main.__stx_scope ? 'SET' : 'unset';
        } catch (e2) {}
        return JSON.stringify({
          chartScopeId: id,
          registered: !!sv,
          mounted: sv ? !!sv.__mounted : null,
          titleType: sv ? typeof sv.title : null,
          scopeKeyCount: sv ? Object.keys(sv).length : null,
          scriptsInScope: scripts,
          containerScopeFlag: containerScope,
          totalScopes: Object.keys(scopes).length,
          build: (window.__stxBuild || 'n/a'),
        });
      } catch (e) { return 'forensics failed: ' + e.message; }
    }
    function check(trigger) {
      setTimeout(function(){
        try {
          var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
          var moustaches = [];
          while (w.nextNode()) {
            var m = w.currentNode.textContent && w.currentNode.textContent.match(/\{\{[^}]*\}\}/);
            if (m) moustaches.push(m[0]);
            if (moustaches.length > 3) break;
          }
          var scopes = (window.stx && window.stx._scopes) || {};
          var dead = [];
          document.querySelectorAll('[data-stx-scope]').forEach(function(el){
            var id = el.getAttribute('data-stx-scope');
            if (id && !scopes[id]) dead.push(id);
          });
          if (moustaches.length || dead.length) {
            console.error('[canary] dead bindings after ' + trigger
              + ' | literal moustaches: ' + (moustaches.join(' ') || 'none')
              + ' | unregistered scopes: ' + (dead.join(',') || 'none')
              + ' | path: ' + location.pathname
              + '\n[canary] forensics: ' + forensics()
              + '\n[canary] console since nav:\n' + (buffer.join('\n') || '(nothing captured)'));
          }
          buffer = [];
        } catch (e) {}
      }, 800);
    }
    window.addEventListener('stx:navigate', function(){ buffer = []; check('spa-nav'); });
    window.addEventListener('load', function(){ check('load'); });
  })();
</script>
<script>window.ANALYTICS_API_ENDPOINT = {{ $env.STX_PUBLIC_API_ENDPOINT || '' }};</script>

<script>
  // Split-domain credentialed fetches (#118): when the API lives on a
  // different origin, every dashboard fetch to it must send the session
  // cookie (credentials: 'include') — the browser default (same-origin)
  // silently drops it and the dashboard fails open. Wrapping fetch here
  // covers every panel/store call without touching each call site; explicit
  // credentials options are respected.
  (function() {
    var api = window.ANALYTICS_API_ENDPOINT || '';
    if (!api) return;
    var apiOrigin;
    try { apiOrigin = new URL(api).origin; } catch (e) { return; }
    if (apiOrigin === window.location.origin) return;
    var origFetch = window.fetch.bind(window);
    window.fetch = function(input, init) {
      try {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        if (url.indexOf(apiOrigin) === 0 && (!init || init.credentials === undefined)) {
          init = init || {};
          init.credentials = 'include';
        }
      } catch (e) {}
      return origFetch(input, init);
    };
  })();
</script>

<script>
  // Account-first session gate (#115): the dashboard never renders without a
  // signed-in user. A 401 from /api/auth/me redirects to /login — unless the
  // server reports enforcement is off (ANALYTICS_REQUIRE_AUTH=false installs).
  // Network errors fail open: an unreachable API shouldn't lock the shell.
  (function() {
    var api = window.ANALYTICS_API_ENDPOINT || '';
    fetch(api + '/api/auth/me', { credentials: 'include' })
      .then(function(r) {
        if (r.status === 401) {
          return r.json().then(function(body) {
            if (!body || body.requireAuth !== false) window.location.replace('/login');
            return null;
          });
        }
        return r.ok ? r.json() : null;
      })
      .then(function(data) {
        if (data && data.user) {
          window.CURRENT_USER = data.user;
          document.dispatchEvent(new CustomEvent('tsa:user', { detail: data.user }));
        }
      })
      .catch(function() {});
  })();
</script>

<script src="/assets/functions/composables.ts"></script>
<script src="/assets/functions/dashboard.ts"></script>

<div id="dashboard" class="min-h-screen flex flex-col" style="display:none">
  {{-- Crosswind class-safelist sentinel.
       The per-page crosswind generator only emits CSS for classes it sees in
       the RENDERED HTML — static class="" attributes and x-class string/object
       literals. Shortcuts applied purely via x-class FUNCTION return values
       (e.g. rangeBtnClass(), tab-btn toggles, status-driven badge/card classes)
       are invisible to it, so their rules never generate and the elements
       render unstyled. The config's `safelist` does NOT expand shortcut names,
       so we list those dynamic-only shortcuts here as real static classes —
       one occurrence per page (this layout wraps all 22 dashboard views) is
       enough to force every rule to generate. Hidden; never displayed. --}}
  <div hidden aria-hidden="true" class="date-range-btn date-range-btn-active tab-btn tab-btn-active badge badge-success badge-warning badge-error badge-info btn-danger session-card error-card vital-card"></div>

  <dashboard-header />

  @yield('controls')

  @include('dashboard/NoDataMessage')

  <main id="main-content" class="flex-1 p-6 max-w-[1400px] mx-auto w-full">
    @yield('content')
  </main>

  <goal-modal />
  @include('Modal')
  @include('SessionModal')
</div>

@include('shared/EmptyStates')
@yield('scripts')
