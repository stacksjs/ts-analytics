<script client lang="ts">
/**
 * Error Detail Page - Individual error view
 * Uses STX signals for reactive state management
 */

interface ErrorOccurrence {
  url?: string
  browser?: string
  browserVersion?: string
  os?: string
  osVersion?: string
  environment?: string
  framework?: string
  componentName?: string
  deviceType?: string
  stack?: string
  timestamp?: string
  tags?: Record<string, string>
  breadcrumbs?: Breadcrumb[]
}

interface Breadcrumb {
  type: string
  category: string
  message: string
  timestamp: string
}

interface ErrorDetail {
  message?: string
  severity?: string
  status?: string
  count?: number
  firstSeen?: string
  lastSeen?: string
  affectedVisitors?: number
  browsers?: string[]
  operatingSystems?: string[]
  devices?: string[]
  frameworks?: string[]
  environments?: Record<string, number>
  latestOccurrence?: ErrorOccurrence
  stack?: string
  affectedUrls?: string[]
  recentOccurrences?: ErrorOccurrence[]
  trend?: string
  category?: string
}

interface ErrorApiResponse {
  error?: ErrorDetail
  errors?: ErrorDetail[]
}

interface StealthMap {
  [key: string]: string
}

const errorData = state<ErrorDetail | null>(null)
const loading = state<boolean>(true)
const error = state<string | null>(null)

// Get config from URL
const urlParams: URLSearchParams = new URLSearchParams(window.location.search)
const API: string = window.ANALYTICS_API || urlParams.get('api') || window.location.origin
const SITE_ID: string = urlParams.get('siteId') || window.ANALYTICS_SITE_ID || ''
const pathMatch: RegExpMatchArray | null = window.location.pathname.match(/\/errors\/(.+)/)
const ERROR_ID: string = pathMatch ? decodeURIComponent(pathMatch[1]) : ''
const USE_STEALTH: boolean = urlParams.get('stealth') !== 'false'

// Stealth API path mapper
const STEALTH_MAP: StealthMap = {
  sites: 'projects', errors: 'issues', 'errors/statuses': 'issues/states',
  'errors/status': 'issues/state'
}
function apiPath(path: string): string {
  if (!USE_STEALTH) return path
  let result: string = path.replace('/api/sites/', '/api/p/').replace('/api/sites', '/api/projects')
  Object.keys(STEALTH_MAP).sort((a: string, b: string) => b.length - a.length).forEach((k: string) => {
    result = result.replace(new RegExp(`/${k}(?=/|\\?|$)`, 'g'), `/${STEALTH_MAP[k]}`)
  })
  return result
}

// Status class mapping
function getStatusClass(status: string | undefined): string {
  if (status === 'resolved') return 'status-resolved'
  if (status === 'ignored') return 'status-ignored'
  return 'status-open'
}

function getSeverityClass(severity: string | undefined): string {
  if (severity === 'critical') return 'severity-critical'
  if (severity === 'high') return 'severity-high'
  if (severity === 'medium') return 'severity-medium'
  return 'severity-low'
}

async function loadErrorDetails(): Promise<void> {
  loading.set(true)
  try {
    // Try the new detail endpoint first
    const detailRes: Response = await fetch(apiPath(`${API}/api/sites/${SITE_ID}/errors/${encodeURIComponent(ERROR_ID)}`))
    if (detailRes.ok) {
      const data: ErrorApiResponse = await detailRes.json()
      if (data.error) {
        errorData.set(data.error)
        error.set(null)
        loading.set(false)
        return
      }
    }

    // Fallback to legacy query
    const res: Response = await fetch(apiPath(`${API}/api/sites/${SITE_ID}/errors?errorId=${encodeURIComponent(ERROR_ID)}`))
    if (!res.ok) throw new Error('Failed to load')
    const data: ErrorApiResponse = await res.json()
    const err: ErrorDetail | undefined = data.errors?.[0]
    if (!err) throw new Error('Error not found')
    errorData.set(err)
    error.set(null)
  } catch (err) {
    error.set((err as Error).message || 'Failed to load error details')
  } finally {
    loading.set(false)
  }
}

async function updateStatus(newStatus: string): Promise<void> {
  try {
    await fetch(apiPath(`${API}/api/sites/${SITE_ID}/errors/status`), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ errorId: ERROR_ID, status: newStatus })
    })
    loadErrorDetails()
  } catch (err) {
    alert('Failed to update status')
  }
}

function formatDate(timestamp: string | undefined): string {
  if (!timestamp) return 'N/A'
  return new Date(timestamp).toLocaleString()
}

function formatRelativeTime(timestamp: string | undefined): string {
  if (!timestamp) return ''
  const diff: number = Date.now() - new Date(timestamp).getTime()
  const minutes: number = Math.floor(diff / 60000)
  if (minutes < 60) return `${minutes}m ago`
  const hours: number = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}h ago`
  const days: number = Math.floor(hours / 24)
  return `${days}d ago`
}

function getBreadcrumbIcon(type: string): string {
  if (type === 'navigation') return '🔗'
  if (type === 'ui') return '👆'
  if (type === 'console') return '📋'
  if (type === 'http') return '🌐'
  if (type === 'error') return '⚠'
  return '•'
}

onMount(() => {
  loadErrorDetails()
})
</script>

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error Details - Analytics</title>
</head>
<body class="font-sans bg-bg text-text min-h-screen p-8 antialiased">
  <div class="max-w-6xl mx-auto">
    <a :href="'/dashboard/errors?siteId=' + SITE_ID" class="inline-flex items-center gap-1 text-accent no-underline mb-4 text-sm hover:underline">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Errors
    </a>

    <header class="mb-6">
      <h1 class="text-2xl font-semibold text-text">Error Details</h1>
    </header>

    <div class="bg-bg-2 rounded-lg py-3 px-4 font-mono text-sm break-all mb-6">
      Error ID: {{ ERROR_ID }}
    </div>

    <div @if="loading()" class="flex items-center justify-center gap-2 text-center p-8 text-muted">
      <div class="spinner"></div>
      <span>Loading error details...</span>
    </div>

    <div @if="error()" class="text-center p-8 text-error">
      {{ error() }}
    </div>

    <div @if="!loading() && !error() && errorData()" class="flex flex-col gap-6">
      <!-- Header Card -->
      <div class="error-card">
        <div class="flex justify-between items-start mb-4 gap-4 flex-wrap">
          <h3 class="text-lg font-medium text-error flex-1 min-w-[200px]">{{ errorData().message ? errorData().message : 'Unknown Error' }}</h3>
          <div class="flex gap-2 flex-wrap">
            <span @if="errorData().severity" @class="['severity-badge', getSeverityClass(errorData().severity)]">
              {{ errorData().severity }}
            </span>
            <span @if="errorData().trend" @class="['trend-badge', 'trend-' + errorData().trend]">
              {{ errorData().trend }}
            </span>
            <span @if="errorData().category" class="py-1 px-2 rounded text-xs bg-bg-3 text-muted">
              {{ errorData().category }}
            </span>
            <span @class="['error-status-badge', getStatusClass(errorData().status)]">
              {{ errorData().status ? errorData().status : 'open' }}
            </span>
          </div>
        </div>

        <div class="flex gap-2">
          <button
            @if="errorData().status !== 'resolved'"
            @click="updateStatus('resolved')"
            class="btn btn-resolve"
          >Mark Resolved</button>
          <button
            @if="errorData().status !== 'ignored'"
            @click="updateStatus('ignored')"
            class="btn btn-secondary"
          >Ignore</button>
          <button
            @if="errorData().status !== 'open'"
            @click="updateStatus('open')"
            class="btn btn-primary"
          >Reopen</button>
        </div>
      </div>

      <!-- Overview Grid -->
      <div class="error-meta-grid">
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">First Seen</div>
          <div class="text-sm font-medium text-text">{{ formatDate(errorData().firstSeen) }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Last Seen</div>
          <div class="text-sm font-medium text-text">{{ formatDate(errorData().lastSeen) }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Occurrences</div>
          <div class="text-sm font-medium text-text">{{ errorData().count ? errorData().count : 1 }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Affected Visitors</div>
          <div class="text-sm font-medium text-text">{{ errorData().affectedVisitors || errorData().count || 1 }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Browsers</div>
          <div class="text-sm font-medium text-text">{{ (errorData().browsers ? errorData().browsers : []).length > 0 ? (errorData().browsers ? errorData().browsers : []).join(', ') : 'Unknown' }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Operating Systems</div>
          <div class="text-sm font-medium text-text">{{ (errorData().operatingSystems || []).join(', ') || errorData().latestOccurrence?.os || 'Unknown' }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Devices</div>
          <div class="text-sm font-medium text-text">{{ (errorData().devices ? errorData().devices : []).length > 0 ? (errorData().devices ? errorData().devices : []).join(', ') : (errorData().latestOccurrence?.deviceType ? errorData().latestOccurrence.deviceType : 'Unknown') }}</div>
        </div>
        <div class="meta-card">
          <div class="text-xs text-muted mb-1">Frameworks</div>
          <div class="text-sm font-medium text-text">{{ (errorData().frameworks ? errorData().frameworks : []).length > 0 ? (errorData().frameworks ? errorData().frameworks : []).join(', ') : (errorData().latestOccurrence?.framework ? errorData().latestOccurrence.framework : 'Unknown') }}</div>
        </div>
      </div>

      <!-- Environment Breakdown -->
      <div @if="errorData().environments && Object.keys(errorData().environments).length > 0" class="bg-bg-2 rounded-lg p-6">
        <h4 class="text-base font-semibold text-text mb-4">Environment Breakdown</h4>
        <div class="flex flex-col gap-2">
          <div @for="env in Object.entries(errorData().environments)" class="flex items-center gap-3">
            <span class="text-[0.8125rem] text-text min-w-[100px] font-medium">{{ env[0] }}</span>
            <div class="flex-1 h-5 bg-bg rounded overflow-hidden">
              <div class="h-full bg-accent rounded min-w-[4px] transition-[width] duration-300" :style="`width: ${Math.min(100, Math.round((env[1] / (errorData().count || 1)) * 100))}%`"></div>
            </div>
            <span class="text-[0.8125rem] text-muted min-w-[40px] text-right">{{ env[1] }}</span>
          </div>
        </div>
      </div>

      <!-- Latest Occurrence Details -->
      <div @if="errorData().latestOccurrence" class="bg-bg-2 rounded-lg p-6">
        <h4 class="text-base font-semibold text-text mb-4">Latest Occurrence</h4>
        <div class="error-meta-grid">
          <div class="meta-card">
            <div class="text-xs text-muted mb-1">URL</div>
            <div class="text-sm font-medium text-text truncate">{{ errorData().latestOccurrence.url ? errorData().latestOccurrence.url : 'Unknown' }}</div>
          </div>
          <div class="meta-card">
            <div class="text-xs text-muted mb-1">Browser</div>
            <div class="text-sm font-medium text-text">{{ errorData().latestOccurrence.browser ? errorData().latestOccurrence.browser : '' }} {{ errorData().latestOccurrence.browserVersion ? errorData().latestOccurrence.browserVersion : '' }}</div>
          </div>
          <div class="meta-card">
            <div class="text-xs text-muted mb-1">OS</div>
            <div class="text-sm font-medium text-text">{{ errorData().latestOccurrence.os ? errorData().latestOccurrence.os : '' }} {{ errorData().latestOccurrence.osVersion ? errorData().latestOccurrence.osVersion : '' }}</div>
          </div>
          <div @if="errorData().latestOccurrence.environment" class="meta-card">
            <div class="text-xs text-muted mb-1">Environment</div>
            <div class="text-sm font-medium text-text">{{ errorData().latestOccurrence.environment }}</div>
          </div>
          <div @if="errorData().latestOccurrence.framework" class="meta-card">
            <div class="text-xs text-muted mb-1">Framework</div>
            <div class="text-sm font-medium text-text">{{ errorData().latestOccurrence.framework }}</div>
          </div>
          <div @if="errorData().latestOccurrence.componentName" class="meta-card">
            <div class="text-xs text-muted mb-1">Component</div>
            <div class="text-sm font-medium text-text">{{ errorData().latestOccurrence.componentName }}</div>
          </div>
        </div>

        <!-- Tags -->
        <div @if="errorData().latestOccurrence.tags && Object.keys(errorData().latestOccurrence.tags).length > 0" class="mt-2">
          <h5 class="text-sm font-semibold text-muted mt-4 mb-2">Tags</h5>
          <div class="flex flex-wrap gap-2">
            <span @for="key in Object.keys(errorData().latestOccurrence.tags)" class="bg-bg-3 text-muted py-1 px-2 rounded text-xs font-mono">
              {{ key }}: {{ errorData().latestOccurrence.tags[key] }}
            </span>
          </div>
        </div>
      </div>

      <!-- Stack Trace -->
      <div @if="errorData().latestOccurrence?.stack || errorData().stack" class="bg-bg-2 rounded-lg p-6">
        <h4 class="text-base font-semibold text-text mb-4">Stack Trace</h4>
        <pre class="bg-bg rounded-md p-4 text-[0.8125rem] overflow-x-auto whitespace-pre-wrap break-words font-mono leading-relaxed">{{ errorData().latestOccurrence?.stack ? errorData().latestOccurrence.stack : errorData().stack }}</pre>
      </div>

      <!-- Breadcrumbs -->
      <div @if="errorData().latestOccurrence?.breadcrumbs && errorData().latestOccurrence.breadcrumbs.length > 0" class="bg-bg-2 rounded-lg p-6">
        <h4 class="text-base font-semibold text-text mb-4">Breadcrumbs</h4>
        <div class="flex flex-col gap-2">
          <div @for="bc in errorData().latestOccurrence.breadcrumbs" class="flex items-center gap-3 py-2 px-3 bg-bg rounded-md text-[0.8125rem]">
            <span class="shrink-0 w-5 text-center">{{ getBreadcrumbIcon(bc.type) }}</span>
            <div class="flex-1 min-w-0">
              <span class="text-accent font-medium mr-2">{{ bc.category }}</span>
              <span class="text-text break-words">{{ bc.message }}</span>
            </div>
            <span class="shrink-0 text-muted text-xs">{{ formatRelativeTime(bc.timestamp) }}</span>
          </div>
        </div>
      </div>

      <!-- Affected URLs -->
      <div @if="errorData().affectedUrls && errorData().affectedUrls.length > 0" class="bg-bg-2 rounded-lg p-6">
        <h4 class="text-base font-semibold text-text mb-4">Affected URLs</h4>
        <ul class="list-none">
          <li @for="url in errorData().affectedUrls" class="py-2 px-3 bg-bg rounded-md mb-2 text-[0.8125rem] font-mono break-all">{{ url }}</li>
        </ul>
      </div>

      <!-- Recent Occurrences Timeline -->
      <div @if="errorData().recentOccurrences && errorData().recentOccurrences.length > 0" class="bg-bg-2 rounded-lg p-6">
        <h4 class="text-base font-semibold text-text mb-4">Recent Occurrences</h4>
        <div class="flex flex-col border border-border rounded-md overflow-hidden">
          <div class="occurrence-header">
            <span>Time</span>
            <span>Browser</span>
            <span>OS</span>
            <span>URL</span>
          </div>
          <div @for="occ in errorData().recentOccurrences" class="occurrence-row">
            <span>{{ formatRelativeTime(occ.timestamp) }}</span>
            <span>{{ occ.browser ? occ.browser : 'Unknown' }}</span>
            <span>{{ occ.os ? occ.os : 'Unknown' }}</span>
            <span class="truncate">{{ occ.url ? occ.url : '' }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

<style>
/* Dynamic badge colors with rgba - can't be expressed as utilities */
.severity-badge {
  @apply py-1 px-2 rounded text-xs font-semibold uppercase;
}
.severity-critical {
  background: rgba(239, 68, 68, 0.2);
  color: #fca5a5;
}
.severity-high {
  background: rgba(249, 115, 22, 0.2);
  color: #fdba74;
}
.severity-medium {
  background: rgba(245, 158, 11, 0.2);
  color: #fcd34d;
}
.severity-low {
  background: rgba(156, 163, 175, 0.2);
  color: #d1d5db;
}
.trend-badge {
  @apply py-1 px-2 rounded text-xs font-semibold capitalize;
}
.trend-new { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }
.trend-increasing { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }
.trend-decreasing { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; }
.trend-stable { background: rgba(156, 163, 175, 0.15); color: #d1d5db; }

.error-status-badge {
  @apply py-1 px-2 rounded text-xs font-medium capitalize;
}
.status-open {
  background: rgba(239, 68, 68, 0.2);
  color: #fca5a5;
}
.status-resolved {
  background: rgba(16, 185, 129, 0.2);
  color: #6ee7b7;
}
.status-ignored {
  background: rgba(107, 114, 128, 0.2);
  color: #d1d5db;
}

.meta-card {
  @apply bg-bg-2 border border-border rounded-md p-3;
}
.error-meta-grid {
  @apply grid grid-cols-2 gap-3;
}
@media (min-width: 768px) {
  .error-meta-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* Occurrence table grid - complex fixed-width columns */
.occurrence-header {
  display: grid;
  grid-template-columns: 100px 120px 100px 1fr;
  @apply gap-2 py-2.5 px-3 bg-bg-3 text-xs font-semibold text-muted uppercase;
}
.occurrence-row {
  display: grid;
  grid-template-columns: 100px 120px 100px 1fr;
  @apply gap-2 py-2 px-3 text-[0.8125rem] border-t border-border;
}

/* Resolve button */
.btn-resolve {
  @apply bg-success text-white;
}
.btn-resolve:hover {
  background: #059669;
}

/* Spinner animation */
.spinner {
  @apply w-4 h-4 rounded-full;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(-360deg); }
}
</style>
