<!-- Modal Container - STX reactive bindings for visibility, content, and submit state -->
<div id="modal-overlay" class="modal-overlay backdrop-blur-sm" @show="visible()" @click.self="close()">
  <div @if="modalOptions()" @class="['modal', modalOptions().size ? 'modal-' + modalOptions().size : '', modalOptions().className || '']">
    <div class="modal-header">
      <h3 class="modal-title">{{ modalOptions()?.title || '' }}</h3>
      <button class="modal-close" type="button" aria-label="Close" @click="close()">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div class="modal-body" @html="modalOptions()?.content || ''"></div>
    <div @if="modalOptions()?.showFooter !== false" class="modal-footer">
      <button type="button" class="btn btn-secondary modal-cancel" @click="close()">{{ modalOptions()?.cancelText || 'Cancel' }}</button>
      <button @if="modalOptions()?.onSubmit" type="button" class="btn btn-primary modal-submit"
              @click="handleSubmit()" :disabled="isSubmitting()">
        {{ isSubmitting() ? 'Saving...' : (modalOptions()?.submitText || 'Save') }}
      </button>
    </div>
  </div>
</div>

<script client lang="ts">
import type { ModalOptions } from '../types/dashboard'

const visible = state<boolean>(false)
const modalOptions = state<ModalOptions | null>(null)
const isSubmitting = state<boolean>(false)
let onSubmitCallback: (() => Promise<void>) | null = null
let onCancelCallback: (() => void) | null = null

function open(options?: ModalOptions): void {
  options = options || {}
  onSubmitCallback = options.onSubmit || null
  onCancelCallback = options.onCancel || null
  isSubmitting.set(false)
  modalOptions.set(options)
  visible.set(true)

  // Focus first input after render
  setTimeout(() => {
    const input = document.querySelector<HTMLElement>('#modal-overlay input, #modal-overlay select, #modal-overlay textarea')
    if (input) input.focus()
  }, 50)
}

function close(): void {
  visible.set(false)
  modalOptions.set(null)
  if (onCancelCallback) onCancelCallback()
  onSubmitCallback = null
  onCancelCallback = null
  isSubmitting.set(false)
}

async function handleSubmit(): Promise<void> {
  if (!onSubmitCallback || isSubmitting()) return
  isSubmitting.set(true)
  try {
    await onSubmitCallback()
  } catch (e) {
    console.error('Modal submit error:', e)
    isSubmitting.set(false)
  }
}

function getFormData(): Record<string, string | boolean> {
  const data: Record<string, string | boolean> = {}
  document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('#modal-overlay input, #modal-overlay select, #modal-overlay textarea').forEach((el) => {
    if (el.name) data[el.name] = (el as HTMLInputElement).type === 'checkbox' ? (el as HTMLInputElement).checked : el.value
  })
  return data
}

function confirm(message: string, onConfirm: () => Promise<void>): void {
  return open({
    title: 'Confirm',
    content: '<p class="confirm-message">' + message + '</p>',
    size: 'sm',
    submitText: 'Confirm',
    onSubmit: async () => { await onConfirm(); close() }
  })
}

function alertModal(alertTitle: string, message: string): void {
  return open({
    title: alertTitle,
    content: '<p class="alert-message">' + message + '</p>',
    size: 'sm',
    showFooter: true,
    onSubmit: null
  })
}

const Modal = { open, close, handleSubmit, getFormData, confirm, alert: alertModal }

provide('Modal', Modal)

// Handle ESC key with auto-cleanup via onMount
onMount(() => {
  const handleEsc = (e: KeyboardEvent): void => {
    if (e.key === 'Escape' && visible()) close()
  }
  document.addEventListener('keydown', handleEsc)
  return () => document.removeEventListener('keydown', handleEsc)
})
</script>

<style>
/* Animation - cannot be expressed as utility classes */
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95) translateY(-10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* Modal content wrapper - JS renders class="modal", no Crosswind shortcut match */
.modal {
  @apply bg-bg border border-border rounded-xl w-full max-w-[480px] max-h-[90vh] overflow-hidden flex flex-col shadow-[0_20px_40px_rgba(0,0,0,0.3)];
  animation: modalIn 0.15s ease-out;
}

/* Size variants */
.modal-sm { @apply max-w-[360px]; }
.modal-lg { @apply max-w-[640px]; }
.modal-xl { @apply max-w-[900px]; }

/* Modal header bg override (shortcut doesn't include bg) */
.modal-header { @apply bg-bg-2; }

/* Modal title */
.modal-title { @apply text-base font-semibold m-0 text-text; }

/* Close button */
.modal-close {
  @apply bg-transparent border-none text-muted cursor-pointer p-1.5 -mr-1.5 -mb-1.5 flex items-center justify-center rounded-md transition-all duration-150;
}
.modal-close:hover { @apply bg-bg-3 text-text; }

/* Modal body overflow */
.modal-body { @apply overflow-y-auto flex-1; }

/* Modal footer bg override (shortcut doesn't include bg) */
.modal-footer { @apply bg-bg-2; }

/* Form elements inside modal */
.modal .form-group { @apply mb-4 last:mb-0; }
.modal .form-label { @apply block text-[0.8125rem] font-medium text-text mb-1.5; }
.modal .form-hint { @apply text-xs text-muted mt-1; }

/* Form input focus ring - complex pseudo-selector */
.modal .form-input:focus,
.modal .form-select:focus {
  @apply outline-none border-accent;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

/* Placeholder color - pseudo-element */
.modal .form-input::placeholder { @apply text-muted; }

/* Checkbox group */
.modal .checkbox-group { @apply flex flex-wrap gap-3 mt-2; }
.modal .checkbox-label { @apply flex items-center gap-2 text-sm text-text cursor-pointer; }

/* Checkbox accent color - cannot use utility */
.modal .checkbox-label input[type="checkbox"] {
  @apply w-4 h-4;
  accent-color: var(--accent);
}

/* Button disabled state - pseudo-selector */
.modal .btn:disabled { @apply opacity-60 cursor-not-allowed; }

/* Confirm/alert messages */
.modal .confirm-message,
.modal .alert-message {
  @apply m-0 text-[0.9375rem] text-text leading-relaxed;
}
</style>
