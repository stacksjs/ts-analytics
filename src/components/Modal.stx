<!-- Modal Container - fully imperative, no STX reactive bindings needed -->
<div id="modal-overlay" class="modal-overlay backdrop-blur-sm" style="display: none"></div>

<script client>
;(function() {
  var _doc = document
  let onSubmitCallback = null
  let onCancelCallback = null
  let isSubmitting = false

  function getOverlay() {
    return _doc.getElementById('modal-overlay')
  }

  function render(options) {
    const overlay = getOverlay()
    if (!overlay) return

    const size = options.size || 'md'
    const sizeClass = size !== 'md' ? ' modal-' + size : ''
    const showFooter = options.showFooter !== false
    const showSubmit = !!options.onSubmit
    const submitText = options.submitText || 'Save'
    const cancelText = options.cancelText || 'Cancel'

    overlay.innerHTML = '<div class="modal' + sizeClass + ' ' + (options.className || '') + '">'
      + '<div class="modal-header">'
        + '<h3 class="modal-title">' + (options.title || '') + '</h3>'
        + '<button class="modal-close" type="button" aria-label="Close">'
          + '<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">'
            + '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>'
          + '</svg>'
        + '</button>'
      + '</div>'
      + '<div class="modal-body">' + (options.content || '') + '</div>'
      + (showFooter
        ? '<div class="modal-footer">'
          + '<button type="button" class="btn btn-secondary modal-cancel">' + cancelText + '</button>'
          + (showSubmit ? '<button type="button" class="btn btn-primary modal-submit">' + submitText + '</button>' : '')
        + '</div>'
        : '')
    + '</div>'

    // Bind close button
    var closeBtn = overlay.querySelector('.modal-close')
    if (closeBtn) closeBtn.addEventListener('click', function() { Modal.close() })

    // Bind cancel button
    var cancelBtn = overlay.querySelector('.modal-cancel')
    if (cancelBtn) cancelBtn.addEventListener('click', function() { Modal.close() })

    // Bind submit button
    var submitBtn = overlay.querySelector('.modal-submit')
    if (submitBtn) submitBtn.addEventListener('click', function() { Modal.handleSubmit() })
  }

  const Modal = {
    open: function(options) {
      options = options || {}
      onSubmitCallback = options.onSubmit || null
      onCancelCallback = options.onCancel || null
      isSubmitting = false

      render(options)

      var overlay = getOverlay()
      if (overlay) overlay.style.display = 'flex'

      // Focus first input after render
      setTimeout(function() {
        var input = _doc.querySelector('#modal-overlay input, #modal-overlay select, #modal-overlay textarea')
        if (input) input.focus()
      }, 50)

      return this
    },

    close: function() {
      var overlay = getOverlay()
      if (overlay) {
        overlay.style.display = 'none'
        overlay.innerHTML = ''
      }
      if (onCancelCallback) onCancelCallback()
      onSubmitCallback = null
      onCancelCallback = null
      isSubmitting = false
    },

    handleSubmit: async function() {
      if (!onSubmitCallback || isSubmitting) return

      isSubmitting = true
      var submitBtn = _doc.querySelector('#modal-overlay .modal-submit')
      if (submitBtn) {
        submitBtn.disabled = true
        submitBtn.textContent = 'Saving...'
      }

      try {
        await onSubmitCallback()
      } catch (e) {
        console.error('Modal submit error:', e)
        isSubmitting = false
        if (submitBtn) {
          submitBtn.disabled = false
          submitBtn.textContent = 'Save'
        }
      }
    },

    getFormData: function() {
      var data = {}
      _doc.querySelectorAll('#modal-overlay input, #modal-overlay select, #modal-overlay textarea').forEach(function(el) {
        if (el.name) {
          data[el.name] = el.type === 'checkbox' ? el.checked : el.value
        }
      })
      return data
    },

    confirm: function(message, onConfirm) {
      var self = this
      return this.open({
        title: 'Confirm',
        content: '<p class="confirm-message">' + message + '</p>',
        size: 'sm',
        submitText: 'Confirm',
        onSubmit: async function() {
          await onConfirm()
          self.close()
        }
      })
    },

    alert: function(alertTitle, message) {
      return this.open({
        title: alertTitle,
        content: '<p class="alert-message">' + message + '</p>',
        size: 'sm',
        showFooter: true,
        onSubmit: null
      })
    }
  }

  // Make Modal available to all components
  provide('Modal', Modal)

  // Handle overlay click to close
  var overlay = getOverlay()
  if (overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) Modal.close()
    })
  }

  // Handle ESC key
  _doc.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay && overlay.style.display !== 'none') {
      Modal.close()
    }
  })
})()
</script>

<style>
/* Animation - cannot be expressed as utility classes */
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95) translateY(-10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* Modal content wrapper - JS renders class="modal", no Crosswind shortcut match */
.modal {
  @apply bg-bg border border-border rounded-xl w-full max-w-[480px] max-h-[90vh] overflow-hidden flex flex-col shadow-[0_20px_40px_rgba(0,0,0,0.3)];
  animation: modalIn 0.15s ease-out;
}

/* Size variants */
.modal-sm { @apply max-w-[360px]; }
.modal-lg { @apply max-w-[640px]; }
.modal-xl { @apply max-w-[900px]; }

/* Modal header bg override (shortcut doesn't include bg) */
.modal-header { @apply bg-bg-2; }

/* Modal title */
.modal-title { @apply text-base font-semibold m-0 text-text; }

/* Close button */
.modal-close {
  @apply bg-transparent border-none text-muted cursor-pointer p-1.5 -mr-1.5 -mb-1.5 flex items-center justify-center rounded-md transition-all duration-150;
}
.modal-close:hover { @apply bg-bg-3 text-text; }

/* Modal body overflow */
.modal-body { @apply overflow-y-auto flex-1; }

/* Modal footer bg override (shortcut doesn't include bg) */
.modal-footer { @apply bg-bg-2; }

/* Form elements inside modal */
.modal .form-group { @apply mb-4 last:mb-0; }
.modal .form-label { @apply block text-[0.8125rem] font-medium text-text mb-1.5; }
.modal .form-hint { @apply text-xs text-muted mt-1; }

/* Form input focus ring - complex pseudo-selector */
.modal .form-input:focus,
.modal .form-select:focus {
  @apply outline-none border-accent;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

/* Placeholder color - pseudo-element */
.modal .form-input::placeholder { @apply text-muted; }

/* Checkbox group */
.modal .checkbox-group { @apply flex flex-wrap gap-3 mt-2; }
.modal .checkbox-label { @apply flex items-center gap-2 text-sm text-text cursor-pointer; }

/* Checkbox accent color - cannot use utility */
.modal .checkbox-label input[type="checkbox"] {
  @apply w-4 h-4;
  accent-color: var(--accent);
}

/* Button disabled state - pseudo-selector */
.modal .btn:disabled { @apply opacity-60 cursor-not-allowed; }

/* Confirm/alert messages */
.modal .confirm-message,
.modal .alert-message {
  @apply m-0 text-[0.9375rem] text-text leading-relaxed;
}
</style>
