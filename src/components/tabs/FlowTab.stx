<script client>
/**
 * FlowTab Component - User flow visualization
 * Uses STX signals for reactive state management
 */

import { useSiteApi } from '@composables'
const { siteId: _siteId, apiUrlWithDates } = useSiteApi()

const flowData = state(null)
const loading = state(true)
const error = state(null)

// Computed: entry pages
const entryPages = derived(() => flowData()?.entryPages || [])

// Computed: top flows/links
const topFlows = derived(() => flowData()?.flows || [])

// Computed: most visited pages
const mostVisited = derived(() => flowData()?.mostVisited || [])

// Computed: summary text
const summary = derived(() => {
  const data = flowData()
  if (!data) return ''
  return `${data.totalSessions || 0} sessions analyzed • ${data.uniquePaths || 0} unique pages visited`
})

async function fetchFlow() {
  if (!_siteId()) { loading.set(false); return }
  try {
    const res = await fetch(apiUrlWithDates('/flow'))
    const data = await res.json()
    flowData.set(data)
    error.set(null)
  } catch (e) {
    error.set(e.message)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  fetchFlow()
})
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-2">User Flow</h3>

  <div @if="loading()" class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
    <div class="spinner"></div>
    <span>Loading...</span>
  </div>

  <div @if="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">
    {{ error() }}
  </div>

  <div @if="!loading() && !error()">
    <p @if="summary()" class="text-xs text-muted mb-6">{{ summary() }}</p>

    <div @if="entryPages().length === 0 && topFlows().length === 0" class="empty-state">
      No flow data available. Users need to visit multiple pages in a session.
    </div>

    <div @if="entryPages().length > 0 || topFlows().length > 0" class="flex gap-8 overflow-x-auto pb-4">
      <!-- Entry Pages Column -->
      <div class="min-w-[200px]">
        <h4 class="text-[0.6875rem] uppercase text-muted mb-3 font-medium tracking-wider">Entry Pages</h4>
        <div class="flex flex-col gap-2">
          <div @for="page in entryPages()" class="bg-bg border border-border py-2 px-3 rounded-md">
            <div class="text-[0.8125rem] text-text truncate">{{ page.path }}</div>
            <div class="text-[0.6875rem] text-muted">{{ page.count }} session{{ page.count !== 1 ? 's' : '' }}</div>
          </div>
        </div>
      </div>

      <!-- Top Flows Column -->
      <div class="min-w-[300px] flex-1">
        <h4 class="text-[0.6875rem] uppercase text-muted mb-3 font-medium tracking-wider">Top Flows</h4>
        <div class="flex flex-col gap-2">
          <div @for="flow in topFlows()" class="flex items-center gap-2 text-xs">
            <span class="bg-bg py-1 px-2 rounded truncate max-w-[120px] text-text">{{ flow.source }}</span>
            <span class="text-accent">→</span>
            <span class="bg-bg py-1 px-2 rounded truncate max-w-[120px] text-text">{{ flow.target }}</span>
            <span class="text-muted ml-auto">{{ flow.count }}</span>
          </div>
        </div>
      </div>

      <!-- Most Visited Column -->
      <div class="min-w-[200px]">
        <h4 class="text-[0.6875rem] uppercase text-muted mb-3 font-medium tracking-wider">Most Visited</h4>
        <div class="flex flex-col gap-2">
          <div @for="(page, index) in mostVisited()" class="flex items-center gap-2">
            <span class="flow-rank-number">{{ index + 1 }}</span>
            <span class="text-xs truncate flex-1 text-text">{{ page.path }}</span>
            <span class="text-[0.6875rem] text-muted">{{ page.count }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Rank number badge - requires exact sizing + circle that can't be done with pure utilities */
.flow-rank-number {
  width: 18px;
  height: 18px;
  background: var(--accent);
  color: white;
  border-radius: 50%;
  font-size: 0.6875rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Spinner animation */
.spinner {
  width: 16px;
  height: 16px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(-360deg); }
}
</style>
