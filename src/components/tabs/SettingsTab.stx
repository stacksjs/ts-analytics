<script client>
/**
 * SettingsTab Component - Site settings management
 */

import { useSiteApi, useModal } from '@composables'
const { siteId, apiUrl } = useSiteApi()
const Modal = useModal()

// DOM helpers
const _doc = document
const _getEl = (id) => _doc.getElementById(id)
const _addListener = (el, event, fn) => el.addEventListener(event, fn)

let settingsData = {
  apiKey: null,
  alerts: [],
  emailReports: [],
  uptimeMonitors: [],
  teamMembers: [],
  webhooks: [],
  perfBudgets: [],
  retentionDays: 365
}

async function fetchSettings() {
  const container = _getEl('settings-container')
  if (!siteId() || !container) return

  container.innerHTML = '<div class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg"><div class="spinner"></div><span>Loading...</span></div>'

  try {
    const [keysRes, alertsRes, reportsRes, uptimeRes, teamRes, webhooksRes, budgetsRes, retentionRes] = await Promise.all([
      fetch(apiUrl('/api-keys')),
      fetch(apiUrl('/alerts')),
      fetch(apiUrl('/email-reports')),
      fetch(apiUrl('/uptime')),
      fetch(apiUrl('/team')),
      fetch(apiUrl('/webhooks')),
      fetch(apiUrl('/performance-budgets')),
      fetch(apiUrl('/retention'))
    ])

    const [keysData, alertsData, reportsData, uptimeData, teamData, webhooksData, budgetsData, retentionData] = await Promise.all([
      keysRes.json(), alertsRes.json(), reportsRes.json(), uptimeRes.json(),
      teamRes.json(), webhooksRes.json(), budgetsRes.json(), retentionRes.json()
    ])

    settingsData = {
      apiKey: keysData.apiKey || null,
      alerts: alertsData.alerts || [],
      emailReports: reportsData.reports || [],
      uptimeMonitors: uptimeData.monitors || [],
      teamMembers: teamData.members || [],
      webhooks: webhooksData.webhooks || [],
      perfBudgets: budgetsData.budgets || [],
      retentionDays: retentionData.days || 365
    }

    renderSettings()
  } catch (e) {
    container.innerHTML = `<div class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">${e.message}</div>`
  }
}

function renderSettings() {
  const container = _getEl('settings-container')
  if (!container) return

  container.innerHTML = `
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="flex flex-col gap-4">
        ${renderApiKeysPanel()}
        ${renderAlertsPanel()}
        ${renderEmailReportsPanel()}
        ${renderUptimePanel()}
      </div>
      <div class="flex flex-col gap-4">
        ${renderTeamPanel()}
        ${renderWebhooksPanel()}
        ${renderPerfBudgetsPanel()}
        ${renderDataPrivacyPanel()}
      </div>
    </div>
  `
}

function renderApiKeysPanel() {
  const key = settingsData.apiKey

  const keyContent = key ? `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <div class="text-[0.8125rem] font-medium text-text">${key.name}</div>
        <code class="text-[0.6875rem] text-muted break-all">${key.key}</code>
      </div>
      <div class="flex items-center gap-1">
        <button class="icon-btn" onclick="copyApiKey()" title="Copy key">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" stroke-width="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke-width="2"/></svg>
        </button>
      </div>
    </div>
  ` : '<p class="text-xs text-muted italic">No API key found.</p>'

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">API Key</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="regenerateApiKey()">Regenerate</button>
      </div>
      <p class="text-xs text-muted mb-3">Use this key for programmatic access to your analytics data.</p>
      <div class="flex flex-col gap-2">
        ${keyContent}
      </div>
    </div>
  `
}

function renderAlertsPanel() {
  const items = settingsData.alerts.map(alert => `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <div class="text-[0.8125rem] font-medium text-text">${alert.metric}</div>
        <div class="text-[0.6875rem] text-muted">Threshold: ${alert.threshold} → ${alert.email}</div>
      </div>
      <button class="icon-btn hover:bg-error/15 hover:text-error" onclick="deleteAlert('${alert.id}')" title="Delete">×</button>
    </div>
  `).join('')

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Alerts</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="showAlertModal()">+ New Alert</button>
      </div>
      <p class="text-xs text-muted mb-3">Get notified when metrics exceed thresholds.</p>
      <div class="flex flex-col gap-2">
        ${settingsData.alerts.length === 0 ? '<p class="text-xs text-muted italic">No alerts configured.</p>' : items}
      </div>
    </div>
  `
}

function renderEmailReportsPanel() {
  const items = settingsData.emailReports.map(report => `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <div class="text-[0.8125rem] font-medium text-text">${report.email}</div>
        <div class="text-[0.6875rem] text-muted">${report.frequency}</div>
      </div>
      <button class="icon-btn hover:bg-error/15 hover:text-error" onclick="deleteEmailReport('${report.id}')" title="Delete">×</button>
    </div>
  `).join('')

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Email Reports</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="showEmailReportModal()">+ Add Report</button>
      </div>
      <p class="text-xs text-muted mb-3">Schedule automated email reports.</p>
      <div class="flex flex-col gap-2">
        ${settingsData.emailReports.length === 0 ? '<p class="text-xs text-muted italic">No email reports scheduled.</p>' : items}
      </div>
    </div>
  `
}

function renderUptimePanel() {
  const items = settingsData.uptimeMonitors.map(monitor => `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <code class="text-[0.6875rem] text-muted break-all">${monitor.url}</code>
        <div class="text-[0.6875rem] text-muted">Every ${monitor.interval}min • ${monitor.status || 'Pending'}</div>
      </div>
      <button class="icon-btn hover:bg-error/15 hover:text-error" onclick="deleteUptimeMonitor('${monitor.id}')" title="Delete">×</button>
    </div>
  `).join('')

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Uptime Monitoring</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="showUptimeModal()">+ Add Monitor</button>
      </div>
      <p class="text-xs text-muted mb-3">Monitor your site availability.</p>
      <div class="flex flex-col gap-2">
        ${settingsData.uptimeMonitors.length === 0 ? '<p class="text-xs text-muted italic">No uptime monitors configured.</p>' : items}
      </div>
    </div>
  `
}

function renderTeamPanel() {
  const items = settingsData.teamMembers.map(member => `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <div class="text-[0.8125rem] font-medium text-text">${member.email}</div>
        <div class="text-[0.6875rem] text-muted">${member.role}</div>
      </div>
      <button class="icon-btn hover:bg-error/15 hover:text-error" onclick="removeTeamMember('${member.id}')" title="Remove">×</button>
    </div>
  `).join('')

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Team Members</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="showTeamModal()">+ Invite</button>
      </div>
      <p class="text-xs text-muted mb-3">Manage team access to this site.</p>
      <div class="flex flex-col gap-2">
        ${settingsData.teamMembers.length === 0 ? '<p class="text-xs text-muted italic">No team members added.</p>' : items}
      </div>
    </div>
  `
}

function renderWebhooksPanel() {
  const items = settingsData.webhooks.map(webhook => `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <code class="text-[0.6875rem] text-muted break-all">${webhook.url}</code>
        <div class="text-[0.6875rem] text-muted">${(webhook.events || []).join(', ')}</div>
      </div>
      <button class="icon-btn hover:bg-error/15 hover:text-error" onclick="deleteWebhook('${webhook.id}')" title="Delete">×</button>
    </div>
  `).join('')

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Webhooks</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="showWebhookModal()">+ Add Webhook</button>
      </div>
      <p class="text-xs text-muted mb-3">Send real-time data to external services.</p>
      <div class="flex flex-col gap-2">
        ${settingsData.webhooks.length === 0 ? '<p class="text-xs text-muted italic">No webhooks configured.</p>' : items}
      </div>
    </div>
  `
}

function renderPerfBudgetsPanel() {
  const items = settingsData.perfBudgets.map(budget => `
    <div class="flex justify-between items-center p-2 bg-bg rounded">
      <div class="flex-1 min-w-0">
        <div class="text-[0.8125rem] font-medium text-text">${budget.metric}</div>
        <div class="text-[0.6875rem] text-muted">Threshold: ${budget.threshold}${budget.metric === 'CLS' ? '' : 'ms'}</div>
      </div>
      <button class="icon-btn hover:bg-error/15 hover:text-error" onclick="deletePerfBudget('${budget.id}')" title="Delete">×</button>
    </div>
  `).join('')

  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Performance Budgets</h4>
        <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="showPerfBudgetModal()">+ Add Budget</button>
      </div>
      <p class="text-xs text-muted mb-3">Set performance thresholds for alerts.</p>
      <div class="flex flex-col gap-2">
        ${settingsData.perfBudgets.length === 0 ? '<p class="text-xs text-muted italic">No performance budgets set.</p>' : items}
      </div>
    </div>
  `
}

function renderDataPrivacyPanel() {
  return `
    <div class="panel">
      <div class="panel-header">
        <h4 class="panel-title">Data & Privacy</h4>
      </div>
      <div class="flex flex-col gap-3">
        <div class="flex gap-2 items-center">
          <div>
            <div class="text-xs text-muted">Data Retention</div>
            <div class="text-sm font-medium text-text">${settingsData.retentionDays} days</div>
          </div>
        </div>
        <div class="flex gap-2 items-center">
          <button class="btn btn-secondary" onclick="gdprExport()">Export Data (GDPR)</button>
          <button class="btn btn-danger" onclick="gdprDelete()">Delete All Data</button>
        </div>
      </div>
    </div>
  `
}

// Modal functions (access via window since script runs in strict-mode IIFE)
function regenerateApiKey() {
  Modal.confirm('Regenerate API key? The current key will stop working immediately.', async () => {
    const res = await fetch(apiUrl('/api-keys/regenerate'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    const result = await res.json()
    const fullKey = result.apiKey && result.apiKey.key

    Modal.open({
      title: 'New API Key',
      content: `
        <p class="text-xs text-muted mb-4">Your new API key is ready. Copy it now.</p>
        <div class="mb-4">
          <label class="text-xs font-medium text-muted mb-1 block">Default</label>
          <div class="flex gap-2 items-center">
            <input type="text" class="form-input font-mono text-[0.8125rem]" value="${fullKey || ''}" readonly />
            <button type="button" class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="navigator.clipboard.writeText('${fullKey || ''}'); this.textContent='Copied!'">Copy</button>
          </div>
        </div>
      `,
      submitText: 'Done',
      onSubmit: () => {
        Modal.close()
        fetchSettings()
      }
    })
  })
}

function showAlertModal() {
  Modal.open({
    title: 'Create Alert',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Metric</label>
        <select name="metric" class="form-input">
          <option value="pageviews">Page Views</option>
          <option value="visitors">Visitors</option>
          <option value="bounce_rate">Bounce Rate</option>
          <option value="error_rate">Error Rate</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Threshold</label>
        <input type="number" name="threshold" class="form-input" value="1000" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="alert@example.com" />
      </div>
    `,
    submitText: 'Create Alert',
    onSubmit: async () => {
      const data = Modal.getFormData()
      await fetch(apiUrl('/alerts'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ metric: data.metric, threshold: parseInt(data.threshold), email: data.email })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showEmailReportModal() {
  Modal.open({
    title: 'Add Email Report',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="report@example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Frequency</label>
        <select name="frequency" class="form-input">
          <option value="daily">Daily</option>
          <option value="weekly" selected>Weekly</option>
          <option value="monthly">Monthly</option>
        </select>
      </div>
    `,
    submitText: 'Add Report',
    onSubmit: async () => {
      const data = Modal.getFormData()
      await fetch(apiUrl('/email-reports'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, frequency: data.frequency })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showUptimeModal() {
  Modal.open({
    title: 'Add Uptime Monitor',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">URL</label>
        <input type="url" name="url" class="form-input" placeholder="https://example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Check Interval (minutes)</label>
        <select name="interval" class="form-input">
          <option value="1">1 minute</option>
          <option value="5" selected>5 minutes</option>
          <option value="15">15 minutes</option>
          <option value="30">30 minutes</option>
          <option value="60">60 minutes</option>
        </select>
      </div>
    `,
    submitText: 'Add Monitor',
    onSubmit: async () => {
      const data = Modal.getFormData()
      await fetch(apiUrl('/uptime'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: data.url, interval: parseInt(data.interval) })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showTeamModal() {
  Modal.open({
    title: 'Invite Team Member',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="team@example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Role</label>
        <select name="role" class="form-input">
          <option value="viewer">Viewer</option>
          <option value="editor">Editor</option>
          <option value="admin">Admin</option>
        </select>
      </div>
    `,
    submitText: 'Invite',
    onSubmit: async () => {
      const data = Modal.getFormData()
      await fetch(apiUrl('/team'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, role: data.role })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showWebhookModal() {
  Modal.open({
    title: 'Add Webhook',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Webhook URL</label>
        <input type="url" name="url" class="form-input" placeholder="https://example.com/webhook" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Events</label>
        <div class="flex flex-wrap gap-3 mt-2">
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_pageview" checked /> Page View</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_session" /> Session</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_error" /> Error</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_goal" /> Goal Conversion</label>
        </div>
      </div>
    `,
    submitText: 'Add Webhook',
    onSubmit: async () => {
      const data = Modal.getFormData()
      const events = []
      if (data.event_pageview) events.push('pageview')
      if (data.event_session) events.push('session')
      if (data.event_error) events.push('error')
      if (data.event_goal) events.push('goal')
      await fetch(apiUrl('/webhooks'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: data.url, events })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showPerfBudgetModal() {
  Modal.open({
    title: 'Add Performance Budget',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Metric</label>
        <select name="metric" class="form-input" id="perf-metric-select" onchange="updatePerfThresholdLabel()">
          <option value="LCP">LCP (Largest Contentful Paint)</option>
          <option value="FID">FID (First Input Delay)</option>
          <option value="CLS">CLS (Cumulative Layout Shift)</option>
          <option value="TTFB">TTFB (Time to First Byte)</option>
          <option value="FCP">FCP (First Contentful Paint)</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block" id="perf-threshold-label">Threshold (ms)</label>
        <input type="number" name="threshold" class="form-input" value="2500" />
      </div>
    `,
    submitText: 'Add Budget',
    onSubmit: async () => {
      const data = Modal.getFormData()
      await fetch(apiUrl('/performance-budgets'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ metric: data.metric, threshold: parseFloat(data.threshold) })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function updatePerfThresholdLabel() {
  const select = _getEl('perf-metric-select')
  const label = _getEl('perf-threshold-label')
  if (select && label) {
    label.textContent = select.value === 'CLS' ? 'Threshold (score)' : 'Threshold (ms)'
  }
}

// Copy API key to clipboard
function copyApiKey() {
  const key = settingsData.apiKey
  if (key && key.key) {
    navigator.clipboard.writeText(key.key).then(() => {
      const btn = _doc.querySelector('[onclick="copyApiKey()"]')
      if (btn) {
        btn.innerHTML = '<svg width="14" height="14" fill="none" stroke="#22c55e" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
        setTimeout(() => {
          btn.innerHTML = '<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" stroke-width="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke-width="2"/></svg>'
        }, 2000)
      }
    })
  }
}

// Delete functions
async function deleteAlert(alertId) {
  Modal.confirm('Delete this alert?', async () => {
    await fetch(apiUrl('/alerts/' + alertId), { method: 'DELETE' })
    fetchSettings()
  })
}

async function deleteEmailReport(reportId) {
  Modal.confirm('Delete this email report?', async () => {
    await fetch(apiUrl('/email-reports/' + reportId), { method: 'DELETE' })
    fetchSettings()
  })
}

async function deleteUptimeMonitor(monitorId) {
  Modal.confirm('Delete this uptime monitor?', async () => {
    await fetch(apiUrl('/uptime/' + monitorId), { method: 'DELETE' })
    fetchSettings()
  })
}

async function removeTeamMember(memberId) {
  Modal.confirm('Remove this team member?', async () => {
    await fetch(apiUrl('/team/' + memberId), { method: 'DELETE' })
    fetchSettings()
  })
}

async function deleteWebhook(webhookId) {
  Modal.confirm('Delete this webhook?', async () => {
    await fetch(apiUrl('/webhooks/' + webhookId), { method: 'DELETE' })
    fetchSettings()
  })
}

async function deletePerfBudget(budgetId) {
  Modal.confirm('Delete this performance budget?', async () => {
    await fetch(apiUrl('/performance-budgets/' + budgetId), { method: 'DELETE' })
    fetchSettings()
  })
}

// GDPR functions
function gdprExport() {
  location.href = apiUrl('/gdpr/export')
}

function gdprDelete() {
  Modal.confirm('This will permanently delete ALL analytics data for this site. This action cannot be undone. Are you sure?', async () => {
    await fetch(apiUrl('/gdpr/delete'), { method: 'DELETE' })
    Modal.alert('Success', 'All data has been deleted.')
  })
}

// Expose functions globally for onclick handlers in dynamic HTML
window.regenerateApiKey = regenerateApiKey
window.showAlertModal = showAlertModal
window.showEmailReportModal = showEmailReportModal
window.showUptimeModal = showUptimeModal
window.showTeamModal = showTeamModal
window.showWebhookModal = showWebhookModal
window.showPerfBudgetModal = showPerfBudgetModal
window.updatePerfThresholdLabel = updatePerfThresholdLabel
window.copyApiKey = copyApiKey
window.deleteAlert = deleteAlert
window.deleteEmailReport = deleteEmailReport
window.deleteUptimeMonitor = deleteUptimeMonitor
window.removeTeamMember = removeTeamMember
window.deleteWebhook = deleteWebhook
window.deletePerfBudget = deletePerfBudget
window.gdprExport = gdprExport
window.gdprDelete = gdprDelete

if (_doc.readyState === 'loading') {
  _addListener(_doc, 'DOMContentLoaded', fetchSettings)
} else {
  fetchSettings()
}
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-6">Settings</h3>
  <div id="settings-container">
    <div class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
      <div class="spinner"></div>
      <span>Loading...</span>
    </div>
  </div>
</div>

<style>
/* Spinner animation */
.spinner {
  width: 16px;
  height: 16px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
</style>
