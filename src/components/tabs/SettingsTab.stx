<script client lang="ts">
/**
 * SettingsTab Component - Site settings management
 * Uses STX reactive APIs instead of vanilla DOM manipulation
 */

import type { ApiKey, SiteSettings } from '../../types/analytics'
import { useSiteApi, useModal } from '@composables'
const { siteId, apiUrl } = useSiteApi()
const Modal = useModal()

// Reactive state
const settings = state<SiteSettings>({
  apiKey: null,
  alerts: [],
  emailReports: [],
  uptimeMonitors: [],
  teamMembers: [],
  webhooks: [],
  perfBudgets: [],
  retentionDays: 365
})
const loading = state<boolean>(true)
const error = state<string | null>(null)
const copied = state<boolean>(false)

// Fetch all settings data
async function fetchSettings(): Promise<void> {
  if (!siteId()) { loading.set(false); return }
  loading.set(true)
  error.set(null)

  try {
    const [keysRes, alertsRes, reportsRes, uptimeRes, teamRes, webhooksRes, budgetsRes, retentionRes]: Response[] = await Promise.all([
      fetch(apiUrl('/api-keys')),
      fetch(apiUrl('/alerts')),
      fetch(apiUrl('/email-reports')),
      fetch(apiUrl('/uptime')),
      fetch(apiUrl('/team')),
      fetch(apiUrl('/webhooks')),
      fetch(apiUrl('/performance-budgets')),
      fetch(apiUrl('/retention'))
    ])

    const [keysData, alertsData, reportsData, uptimeData, teamData, webhooksData, budgetsData, retentionData] = await Promise.all([
      keysRes.json(), alertsRes.json(), reportsRes.json(), uptimeRes.json(),
      teamRes.json(), webhooksRes.json(), budgetsRes.json(), retentionRes.json()
    ])

    settings.set({
      apiKey: keysData.apiKey || null,
      alerts: alertsData.alerts || [],
      emailReports: reportsData.reports || [],
      uptimeMonitors: uptimeData.monitors || [],
      teamMembers: teamData.members || [],
      webhooks: webhooksData.webhooks || [],
      perfBudgets: budgetsData.budgets || [],
      retentionDays: retentionData.days || 365
    })
  } catch (e: unknown) {
    error.set((e as Error).message)
  } finally {
    loading.set(false)
  }
}

// Copy API key to clipboard with state-based feedback
function copyApiKey(): void {
  const key = settings().apiKey
  if (key && key.key) {
    navigator.clipboard.writeText(key.key)
    copied.set(true)
    setTimeout(() => copied.set(false), 2000)
  }
}

// Modal functions
function regenerateApiKey(): void {
  Modal.confirm('Regenerate API key? The current key will stop working immediately.', async () => {
    const res: Response = await fetch(apiUrl('/api-keys/regenerate'), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    const result: { apiKey?: ApiKey } = await res.json()
    const fullKey: string | undefined = result.apiKey && result.apiKey.key

    Modal.open({
      title: 'New API Key',
      content: `
        <p class="text-xs text-muted mb-4">Your new API key is ready. Copy it now.</p>
        <div class="mb-4">
          <label class="text-xs font-medium text-muted mb-1 block">Default</label>
          <div class="flex gap-2 items-center">
            <input type="text" class="form-input font-mono text-[0.8125rem]" value="${fullKey || ''}" readonly />
            <button type="button" class="btn btn-secondary text-[0.6875rem] py-1 px-2" onclick="navigator.clipboard.writeText('${fullKey || ''}'); this.textContent='Copied!'">Copy</button>
          </div>
        </div>
      `,
      submitText: 'Done',
      onSubmit: () => {
        Modal.close()
        fetchSettings()
      }
    })
  })
}

function showAlertModal(): void {
  Modal.open({
    title: 'Create Alert',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Metric</label>
        <select name="metric" class="form-input">
          <option value="pageviews">Page Views</option>
          <option value="visitors">Visitors</option>
          <option value="bounce_rate">Bounce Rate</option>
          <option value="error_rate">Error Rate</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Threshold</label>
        <input type="number" name="threshold" class="form-input" value="1000" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="alert@example.com" />
      </div>
    `,
    submitText: 'Create Alert',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/alerts'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ metric: data.metric, threshold: parseInt(data.threshold), email: data.email })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showEmailReportModal(): void {
  Modal.open({
    title: 'Add Email Report',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="report@example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Frequency</label>
        <select name="frequency" class="form-input">
          <option value="daily">Daily</option>
          <option value="weekly" selected>Weekly</option>
          <option value="monthly">Monthly</option>
        </select>
      </div>
    `,
    submitText: 'Add Report',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/email-reports'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, frequency: data.frequency })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showUptimeModal(): void {
  Modal.open({
    title: 'Add Uptime Monitor',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">URL</label>
        <input type="url" name="url" class="form-input" placeholder="https://example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Check Interval (minutes)</label>
        <select name="interval" class="form-input">
          <option value="1">1 minute</option>
          <option value="5" selected>5 minutes</option>
          <option value="15">15 minutes</option>
          <option value="30">30 minutes</option>
          <option value="60">60 minutes</option>
        </select>
      </div>
    `,
    submitText: 'Add Monitor',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/uptime'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: data.url, interval: parseInt(data.interval) })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showTeamModal(): void {
  Modal.open({
    title: 'Invite Team Member',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Email</label>
        <input type="email" name="email" class="form-input" placeholder="team@example.com" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Role</label>
        <select name="role" class="form-input">
          <option value="viewer">Viewer</option>
          <option value="editor">Editor</option>
          <option value="admin">Admin</option>
        </select>
      </div>
    `,
    submitText: 'Invite',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/team'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, role: data.role })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showWebhookModal(): void {
  Modal.open({
    title: 'Add Webhook',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Webhook URL</label>
        <input type="url" name="url" class="form-input" placeholder="https://example.com/webhook" />
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Events</label>
        <div class="flex flex-wrap gap-3 mt-2">
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_pageview" checked /> Page View</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_session" /> Session</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_error" /> Error</label>
          <label class="flex items-center gap-1 text-[0.8125rem] text-text cursor-pointer"><input type="checkbox" name="event_goal" /> Goal Conversion</label>
        </div>
      </div>
    `,
    submitText: 'Add Webhook',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      const events: string[] = []
      if (data.event_pageview) events.push('pageview')
      if (data.event_session) events.push('session')
      if (data.event_error) events.push('error')
      if (data.event_goal) events.push('goal')
      await fetch(apiUrl('/webhooks'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: data.url, events })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

function showPerfBudgetModal(): void {
  Modal.open({
    title: 'Add Performance Budget',
    content: `
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block">Metric</label>
        <select name="metric" class="form-input" id="perf-metric-select" onchange="document.getElementById('perf-threshold-label').textContent = this.value === 'CLS' ? 'Threshold (score)' : 'Threshold (ms)'">
          <option value="LCP">LCP (Largest Contentful Paint)</option>
          <option value="FID">FID (First Input Delay)</option>
          <option value="CLS">CLS (Cumulative Layout Shift)</option>
          <option value="TTFB">TTFB (Time to First Byte)</option>
          <option value="FCP">FCP (First Contentful Paint)</option>
        </select>
      </div>
      <div class="mb-4">
        <label class="text-xs font-medium text-muted mb-1 block" id="perf-threshold-label">Threshold (ms)</label>
        <input type="number" name="threshold" class="form-input" value="2500" />
      </div>
    `,
    submitText: 'Add Budget',
    onSubmit: async () => {
      const data: Record<string, string> = Modal.getFormData()
      await fetch(apiUrl('/performance-budgets'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ metric: data.metric, threshold: parseFloat(data.threshold) })
      })
      Modal.close()
      fetchSettings()
    }
  })
}

// Delete functions
function deleteAlert(alertId: string): void {
  Modal.confirm('Delete this alert?', async () => {
    await fetch(apiUrl('/alerts/' + alertId), { method: 'DELETE' })
    fetchSettings()
  })
}

function deleteEmailReport(reportId: string): void {
  Modal.confirm('Delete this email report?', async () => {
    await fetch(apiUrl('/email-reports/' + reportId), { method: 'DELETE' })
    fetchSettings()
  })
}

function deleteUptimeMonitor(monitorId: string): void {
  Modal.confirm('Delete this uptime monitor?', async () => {
    await fetch(apiUrl('/uptime/' + monitorId), { method: 'DELETE' })
    fetchSettings()
  })
}

function removeTeamMember(memberId: string): void {
  Modal.confirm('Remove this team member?', async () => {
    await fetch(apiUrl('/team/' + memberId), { method: 'DELETE' })
    fetchSettings()
  })
}

function deleteWebhook(webhookId: string): void {
  Modal.confirm('Delete this webhook?', async () => {
    await fetch(apiUrl('/webhooks/' + webhookId), { method: 'DELETE' })
    fetchSettings()
  })
}

function deletePerfBudget(budgetId: string): void {
  Modal.confirm('Delete this performance budget?', async () => {
    await fetch(apiUrl('/performance-budgets/' + budgetId), { method: 'DELETE' })
    fetchSettings()
  })
}

// GDPR functions
function gdprExport(): void {
  location.href = apiUrl('/gdpr/export')
}

function gdprDelete(): void {
  Modal.confirm('This will permanently delete ALL analytics data for this site. This action cannot be undone. Are you sure?', async () => {
    await fetch(apiUrl('/gdpr/delete'), { method: 'DELETE' })
    Modal.alert('Success', 'All data has been deleted.')
  })
}

// Fetch on mount
onMount(() => {
  fetchSettings()
})
</script>

<div class="col-span-full">
  <h3 class="text-base font-semibold text-text mb-6">Settings</h3>

  <!-- Loading state -->
  <div @if="loading()" class="flex items-center justify-center gap-2 text-center text-muted p-8 bg-bg-2 border border-border rounded-lg">
    <div class="spinner"></div>
    <span>Loading...</span>
  </div>

  <!-- Error state -->
  <div @if="error()" class="text-center text-error p-8 bg-bg-2 border border-border rounded-lg">
    {{ error() }}
  </div>

  <!-- Settings panels -->
  <div @if="!loading() && !error()" class="grid grid-cols-1 md:grid-cols-2 gap-4">

    <!-- Left column -->
    <div class="flex flex-col gap-4">

      <!-- API Keys Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">API Key</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="regenerateApiKey()">Regenerate</button>
        </div>
        <p class="text-xs text-muted mb-3">Use this key for programmatic access to your analytics data.</p>
        <div class="flex flex-col gap-2">
          <div @if="settings().apiKey" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ settings().apiKey.name }}</div>
              <code class="text-[0.6875rem] text-muted break-all">{{ settings().apiKey.key }}</code>
            </div>
            <div class="flex items-center gap-1">
              <button class="icon-btn" @click="copyApiKey()" title="Copy key">
                <svg @if="!copied()" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" stroke-width="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke-width="2"/></svg>
                <svg @if="copied()" width="14" height="14" fill="none" stroke="#22c55e" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </button>
            </div>
          </div>
          <p @if="!settings().apiKey" class="text-xs text-muted italic">No API key found.</p>
        </div>
      </div>

      <!-- Alerts Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Alerts</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showAlertModal()">+ New Alert</button>
        </div>
        <p class="text-xs text-muted mb-3">Get notified when metrics exceed thresholds.</p>
        <div class="flex flex-col gap-2">
          <p @if="settings().alerts.length === 0" class="text-xs text-muted italic">No alerts configured.</p>
          <div @for="alert in settings().alerts" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ alert.metric }}</div>
              <div class="text-[0.6875rem] text-muted">Threshold: {{ alert.threshold }} → {{ alert.email }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteAlert(alert.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <!-- Email Reports Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Email Reports</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showEmailReportModal()">+ Add Report</button>
        </div>
        <p class="text-xs text-muted mb-3">Schedule automated email reports.</p>
        <div class="flex flex-col gap-2">
          <p @if="settings().emailReports.length === 0" class="text-xs text-muted italic">No email reports scheduled.</p>
          <div @for="report in settings().emailReports" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ report.email }}</div>
              <div class="text-[0.6875rem] text-muted">{{ report.frequency }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteEmailReport(report.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <!-- Uptime Monitoring Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Uptime Monitoring</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showUptimeModal()">+ Add Monitor</button>
        </div>
        <p class="text-xs text-muted mb-3">Monitor your site availability.</p>
        <div class="flex flex-col gap-2">
          <p @if="settings().uptimeMonitors.length === 0" class="text-xs text-muted italic">No uptime monitors configured.</p>
          <div @for="monitor in settings().uptimeMonitors" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <code class="text-[0.6875rem] text-muted break-all">{{ monitor.url }}</code>
              <div class="text-[0.6875rem] text-muted">Every {{ monitor.interval }}min &bull; {{ monitor.status || 'Pending' }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteUptimeMonitor(monitor.id)" title="Delete">×</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column -->
    <div class="flex flex-col gap-4">

      <!-- Team Members Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Team Members</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showTeamModal()">+ Invite</button>
        </div>
        <p class="text-xs text-muted mb-3">Manage team access to this site.</p>
        <div class="flex flex-col gap-2">
          <p @if="settings().teamMembers.length === 0" class="text-xs text-muted italic">No team members added.</p>
          <div @for="member in settings().teamMembers" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ member.email }}</div>
              <div class="text-[0.6875rem] text-muted">{{ member.role }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="removeTeamMember(member.id)" title="Remove">×</button>
          </div>
        </div>
      </div>

      <!-- Webhooks Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Webhooks</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showWebhookModal()">+ Add Webhook</button>
        </div>
        <p class="text-xs text-muted mb-3">Send real-time data to external services.</p>
        <div class="flex flex-col gap-2">
          <p @if="settings().webhooks.length === 0" class="text-xs text-muted italic">No webhooks configured.</p>
          <div @for="webhook in settings().webhooks" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <code class="text-[0.6875rem] text-muted break-all">{{ webhook.url }}</code>
              <div class="text-[0.6875rem] text-muted">{{ (webhook.events || []).join(', ') }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deleteWebhook(webhook.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <!-- Performance Budgets Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Performance Budgets</h4>
          <button class="btn btn-secondary text-[0.6875rem] py-1 px-2" @click="showPerfBudgetModal()">+ Add Budget</button>
        </div>
        <p class="text-xs text-muted mb-3">Set performance thresholds for alerts.</p>
        <div class="flex flex-col gap-2">
          <p @if="settings().perfBudgets.length === 0" class="text-xs text-muted italic">No performance budgets set.</p>
          <div @for="budget in settings().perfBudgets" class="flex justify-between items-center p-2 bg-bg rounded">
            <div class="flex-1 min-w-0">
              <div class="text-[0.8125rem] font-medium text-text">{{ budget.metric }}</div>
              <div class="text-[0.6875rem] text-muted">Threshold: {{ budget.threshold }}{{ budget.metric === 'CLS' ? '' : 'ms' }}</div>
            </div>
            <button class="icon-btn hover:bg-error/15 hover:text-error" @click="deletePerfBudget(budget.id)" title="Delete">×</button>
          </div>
        </div>
      </div>

      <!-- Data & Privacy Panel -->
      <div class="panel">
        <div class="panel-header">
          <h4 class="panel-title">Data & Privacy</h4>
        </div>
        <div class="flex flex-col gap-3">
          <div class="flex gap-2 items-center">
            <div>
              <div class="text-xs text-muted">Data Retention</div>
              <div class="text-sm font-medium text-text">{{ settings().retentionDays }} days</div>
            </div>
          </div>
          <div class="flex gap-2 items-center">
            <button class="btn btn-secondary" @click="gdprExport()">Export Data (GDPR)</button>
            <button class="btn btn-danger" @click="gdprDelete()">Delete All Data</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

