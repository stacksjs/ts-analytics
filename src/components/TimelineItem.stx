<script client lang="ts">
/**
 * TimelineItem Component
 * Displays a single event in a session timeline
 */
interface TimelineItemData {
  type?: string
  timestamp?: string | number
  data?: Record<string, any>
}

const item: TimelineItemData = $props.item || {}
const type = derived(() => item.type || 'event')
const data = derived(() => item.data || {})
const timestamp = derived(() => item.timestamp)
const timeStr = derived(() => timestamp() ? new Date(timestamp()).toLocaleTimeString() : '')

// Build content based on type
const content = derived((): string => {
  const t = type()
  const d = data()
  switch (t) {
    case 'pageview': return d.path || '/'
    case 'event': return d.name || 'Event'
    case 'click': return `Click at (${d.viewportX}, ${d.viewportY}) on ${d.elementTag || 'element'}`
    case 'vital': return `${d.metric}: ${d.value}ms (${d.rating})`
    case 'error': return (d.message || 'Error').slice(0, 100)
    default: return ''
  }
})
</script>

<div class="flex items-start gap-3 py-2 border-b border-border timeline-item">
  <span @class="['text-[0.6875rem] font-medium uppercase py-0.5 px-1.5 rounded-sm shrink-0 timeline-type', type()]">{{ type() }}</span>
  <div class="flex-1 text-[0.8125rem] text-text break-words">{{ content() }}</div>
  <span class="text-[0.6875rem] text-muted shrink-0">{{ timeStr() }}</span>
</div>

<style>
.timeline-item:last-child {
  border-bottom: none;
}
.timeline-type.pageview {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}
.timeline-type.event {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}
.timeline-type.click {
  background: rgba(168, 85, 247, 0.1);
  color: #a855f7;
}
.timeline-type.vital {
  background: rgba(245, 158, 11, 0.1);
  color: #f59e0b;
}
.timeline-type.error {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}
</style>
