<script client lang="ts">
/**
 * CountriesTable Component
 * Displays countries with flag and visitor count
 */

interface Country {
  name?: string
  code?: string
  visitors: number
}

interface CountriesTableProps {
  countries?: Country[]
  loading?: boolean
}

const countries = state<Country[]>($props.countries || [])
const loading = state<boolean>($props.loading || false)

effect(() => {
  if ($props.countries) countries.set($props.countries)
  if ($props.loading !== undefined) loading.set($props.loading)
})

// Simple country code to flag emoji converter
function getFlag(name: string): string {
  const countryFlags: Record<string, string> = {
    'United States': '🇺🇸', 'United Kingdom': '🇬🇧', 'Germany': '🇩🇪', 'France': '🇫🇷',
    'Canada': '🇨🇦', 'Australia': '🇦🇺', 'Japan': '🇯🇵', 'China': '🇨🇳',
    'India': '🇮🇳', 'Brazil': '🇧🇷', 'Netherlands': '🇳🇱', 'Spain': '🇪🇸',
    'Italy': '🇮🇹', 'Russia': '🇷🇺', 'South Korea': '🇰🇷', 'Mexico': '🇲🇽',
    'Indonesia': '🇮🇩', 'Poland': '🇵🇱', 'Sweden': '🇸🇪', 'Switzerland': '🇨🇭'
  }
  return countryFlags[name] || '🌍'
}
</script>

<div class="overflow-x-auto">
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="text-left py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Country</th>
        <th class="text-right py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border">Visitors</th>
      </tr>
    </thead>
    <tbody>
      <tr @if="loading()">
        <td colspan="2" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @if="!loading() && countries().length === 0">
        <td colspan="2" class="text-center text-muted py-4">No location data</td>
      </tr>
      <tr @for="country in countries()" @if="!loading()">
        <td class="cell-name flex items-center gap-1.5">
          <span class="text-base">{{ getFlag(country.name ? country.name : country.code) }}</span>
          {{ country.name ? country.name : (country.code ? country.code : 'Unknown') }}
        </td>
        <td class="cell-value">{{ (country.visitors ? country.visitors : 0) | fmt }}</td>
      </tr>
    </tbody>
  </table>
</div>
