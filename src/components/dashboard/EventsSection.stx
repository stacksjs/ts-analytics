{{-- EventsSection Component --}}
{{-- Props: events (array of {name, count}), loading (boolean) --}}

@ts
function getTotalCount(events: Array<{count?: number}>): number {
  return events.reduce((sum, e) => sum + (e.count || 0), 0)
}

function getMaxCount(events: Array<{count?: number}>): number {
  return Math.max(...events.map(e => e.count || 0), 1)
}

function getPercentage(count: number, total: number): number {
  return total > 0 ? Math.round((count / total) * 100) : 0
}

function getBarWidth(count: number, max: number): number {
  return max > 0 ? Math.round((count / max) * 100) : 0
}
@endts

<div id="events-content">
  @if(loading)
    <div class="text-center text-muted p-6 text-[0.8125rem]">Loading...</div>
  @elseif(events.length === 0)
    <div class="text-center text-muted p-6 text-[0.8125rem]">No custom events tracked</div>
  @else
    <div class="flex flex-col gap-2">
      @foreach(events as event)
        <div class="flex items-center gap-2 text-[0.8125rem]">
          <div class="flex-1 min-w-0">
            <div class="flex justify-between mb-0.5">
              <span class="font-medium overflow-hidden text-ellipsis whitespace-nowrap text-text">{{ event.name }}</span>
              <span class="text-muted ml-2 text-xs">{{ getPercentage((event.count ? event.count : 0), getTotalCount(events)) }}%</span>
            </div>
            <div class="h-1 bg-border rounded-sm overflow-hidden">
              <div class="h-full bg-accent-2 rounded-sm transition-[width] duration-300" style="width: {{ getBarWidth((event.count ? event.count : 0), getMaxCount(events)) }}%"></div>
            </div>
          </div>
          <span class="min-w-[50px] text-right font-semibold text-text">{{ (event.count ? event.count : 0) | fmt }}</span>
        </div>
      @endforeach
    </div>
  @endif
</div>
