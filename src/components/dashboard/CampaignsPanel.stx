<script client lang="ts">
/**
 * CampaignsPanel Component
 * Displays campaign breakdown with reactive data fetching
 */

interface Campaign {
  name: string
  source?: string
  medium?: string
  visitors: number
  views?: number
}

const campaigns = state<Campaign[]>([])
const loading = state<boolean>(true)

async function fetchCampaigns(): Promise<void> {
  const siteId: string | undefined = window.siteId
  if (!siteId) {
    loading.set(false)
    return
  }
  try {
    const res: Response = await fetch(window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/campaigns${window.getDateRangeParams()}`))
    const data: { campaigns?: Campaign[] } = await res.json()
    campaigns.set((data.campaigns || []).slice(0, 10))
  } catch (e: unknown) {
    console.error('Failed to fetch campaigns:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (window.siteId) fetchCampaigns()
})

window.refreshCampaignsPanel = fetchCampaigns
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/>
      </svg>
      Campaigns
    </div>
    <a href="#" @click.prevent="window.navigateTo('campaigns')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Campaign</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr @if="loading()">
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @if="!loading() && campaigns().length === 0">
        <td colspan="3" class="text-center text-muted py-4">No campaign data</td>
      </tr>
      <tr @for="campaign in campaigns()" @if="!loading()">
        <td class="cell-name">{{ campaign.name ? campaign.name : (campaign.source ? campaign.source : 'Unknown') }}</td>
        <td class="cell-value">{{ (campaign.visitors ? campaign.visitors : 0) | fmt }}</td>
        <td class="cell-value">{{ (campaign.views ? campaign.views : 0) | fmt }}</td>
      </tr>
    </tbody>
  </table>
</div>

