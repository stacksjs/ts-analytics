<script client lang="ts">
/**
 * FiltersBar Component - Data filtering controls
 * Uses STX signals for reactive filter state
 */

interface FilterOption {
  value: string
  label: string
}

// Filter state
const countryFilter = state<string>('')
const deviceFilter = state<string>('')
const browserFilter = state<string>('')

// Available options (populated dynamically)
const countries = state<FilterOption[]>([])
const devices = state<FilterOption[]>([
  { value: '', label: 'All Devices' },
  { value: 'desktop', label: 'Desktop' },
  { value: 'mobile', label: 'Mobile' },
  { value: 'tablet', label: 'Tablet' },
])
const browsers = state<FilterOption[]>([])

// Apply filter and notify dashboard
function applyFilter(filterType: string, value: string): void {
  switch (filterType) {
    case 'country':
      countryFilter.set(value)
      break
    case 'device':
      deviceFilter.set(value)
      break
    case 'browser':
      browserFilter.set(value)
      break
  }

  // Notify dashboard.ts
  if (window.applyFilter) {
    window.applyFilter(filterType, value)
  }

  // Refresh panels with filter
  if (window.refreshAllPanels) {
    window.refreshAllPanels()
  }
}

// Get current filters as query params
function getFilterParams(): string {
  const params: string[] = []
  if (countryFilter()) params.push(`country=${encodeURIComponent(countryFilter())}`)
  if (deviceFilter()) params.push(`device=${encodeURIComponent(deviceFilter())}`)
  if (browserFilter()) params.push(`browser=${encodeURIComponent(browserFilter())}`)
  return params.length > 0 ? '&' + params.join('&') : ''
}

// Populate filter options from data
function setCountries(list: string[]): void {
  countries.set([{ value: '', label: 'All Countries' }, ...list.map((c: string) => ({ value: c, label: c }))])
}

function setBrowsers(list: string[]): void {
  browsers.set([{ value: '', label: 'All Browsers' }, ...list.map((b: string) => ({ value: b, label: b }))])
}

// Reset all filters
function resetFilters(): void {
  countryFilter.set('')
  deviceFilter.set('')
  browserFilter.set('')
}

// Expose functions
onMount(() => {
  window.setFilterCountries = setCountries
  window.setFilterBrowsers = setBrowsers
  window.getFilterParams = getFilterParams
  window.resetFilters = resetFilters
})
</script>

<div id="filters-bar" class="flex gap-3 py-3 px-6 bg-bg border-b border-border flex-wrap sm:justify-start justify-center">
  <select
    id="filter-country"
    class="filter-select min-w-[140px] bg-[url('data:image/svg+xml,%3Csvg_xmlns=%27http://www.w3.org/2000/svg%27_width=%2712%27_height=%2712%27_viewBox=%270_0_24_24%27_fill=%27none%27_stroke=%2771717a%27_stroke-width=%272%27%3E%3Cpath_d=%27M6_9l6_6_6-6%27/%3E%3C/svg%3E')] bg-no-repeat bg-[right_0.5rem_center]"
    @model="countryFilter"
    @change="applyFilter('country', countryFilter())"
  >
    <option @for="country in countries()" :value="country.value">{{ country.label }}</option>
    <option @if="countries().length === 0" value="">All Countries</option>
  </select>

  <select
    id="filter-device"
    class="filter-select min-w-[140px] bg-[url('data:image/svg+xml,%3Csvg_xmlns=%27http://www.w3.org/2000/svg%27_width=%2712%27_height=%2712%27_viewBox=%270_0_24_24%27_fill=%27none%27_stroke=%2771717a%27_stroke-width=%272%27%3E%3Cpath_d=%27M6_9l6_6_6-6%27/%3E%3C/svg%3E')] bg-no-repeat bg-[right_0.5rem_center]"
    @model="deviceFilter"
    @change="applyFilter('device', deviceFilter())"
  >
    <option @for="device in devices()" :value="device.value">{{ device.label }}</option>
  </select>

  <select
    id="filter-browser"
    class="filter-select min-w-[140px] bg-[url('data:image/svg+xml,%3Csvg_xmlns=%27http://www.w3.org/2000/svg%27_width=%2712%27_height=%2712%27_viewBox=%270_0_24_24%27_fill=%27none%27_stroke=%2771717a%27_stroke-width=%272%27%3E%3Cpath_d=%27M6_9l6_6_6-6%27/%3E%3C/svg%3E')] bg-no-repeat bg-[right_0.5rem_center]"
    @model="browserFilter"
    @change="applyFilter('browser', browserFilter())"
  >
    <option @for="browser in browsers()" :value="browser.value">{{ browser.label }}</option>
    <option @if="browsers().length === 0" value="">All Browsers</option>
  </select>
</div>

<style>
/* No remaining vanilla CSS needed - all styles expressed as utility classes and Crosswind shortcuts */
</style>
