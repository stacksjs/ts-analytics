<script client lang="ts">
/**
 * ReferrersPanel Component
 * Displays top referrers with reactive data fetching
 */

interface Referrer {
  name: string
  source?: string
  visitors: number
  views?: number
  favicon?: string
}

const referrers = state<Referrer[]>([])
const loading = state<boolean>(true)

function getDomain(source: string): string {
  return source.replace(/^https?:\/\//, '').split('/')[0]
}

function isExternalLink(source: string): boolean {
  const lower: string = (source || '').toLowerCase()
  return lower !== 'direct' && !source.includes('(') && source.includes('.')
}

function getHref(source: string): string {
  return source.startsWith('http') ? source : 'https://' + source
}

function getFaviconUrl(source: string): string {
  return 'https://www.google.com/s2/favicons?domain=' + getDomain(source) + '&sz=16'
}

async function fetchReferrers(): Promise<void> {
  const siteId: string | undefined = window.siteId
  if (!siteId) {
    loading.set(false)
    return
  }
  try {
    const res: Response = await fetch(window.apiPath(`${window.API_ENDPOINT}/api/sites/${siteId}/referrers${window.getDateRangeParams()}`))
    const data: { referrers?: Referrer[] } = await res.json()
    referrers.set((data.referrers || []).slice(0, 10))
  } catch (e: unknown) {
    console.error('Failed to fetch referrers:', e)
  } finally {
    loading.set(false)
  }
}

onMount(() => {
  if (window.siteId) fetchReferrers()
})

window.refreshReferrersPanel = fetchReferrers
</script>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">
      <svg class="text-muted" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
      </svg>
      Top Referrers
    </div>
    <a href="#" @click.prevent="window.navigateTo('referrers')" class="text-xs text-accent no-underline hover:underline">View all &rarr;</a>
  </div>
  <table class="w-full text-[0.8125rem]">
    <thead>
      <tr>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-left">Source</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Visitors</th>
        <th class="py-2 text-[0.6875rem] font-medium uppercase tracking-wide text-muted border-b border-border text-right">Views</th>
      </tr>
    </thead>
    <tbody>
      <tr @for="ref in referrers()" @loading="loading()" @if="!loading()">
        <td class="cell-name">
          <a @if="isExternalLink(ref.source ? ref.source : 'Direct')"
             :href="getHref(ref.source)"
             target="_blank"
             rel="noopener"
             class="inline-flex items-center gap-1.5 hover:text-accent">
            <img
              :src="getFaviconUrl(ref.source)"
              width="14"
              height="14"
              class="align-middle rounded-sm"
              @error="e => e.target.style.display = 'none'"
            />
            {{ ref.source ? ref.source : 'Direct' }}
            <svg class="opacity-50" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
          <span @if="!isExternalLink(ref.source ? ref.source : 'Direct')">{{ ref.source ? ref.source : 'Direct' }}</span>
        </td>
        <td class="cell-value">{{ ref.visitors | fmt }}</td>
        <td class="cell-value">{{ ref.views | fmt }}</td>
      </tr>
      <tr @for-loading>
        <td colspan="3" class="text-center text-muted py-4">Loading...</td>
      </tr>
      <tr @for-empty>
        <td colspan="3" class="text-center text-muted py-4">No referrer data</td>
      </tr>
    </tbody>
  </table>
</div>

